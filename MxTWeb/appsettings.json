{
  "ConnectionStrings": {
    // 실제 값은 User Secrets(개발) 또는 환경 변수(운영)로 주입합니다.
    // 예) ConnectionStrings__LoginConnection / ConnectionStrings__WebContextConnection
    "LoginConnection": "",
    "WebContextConnection": ""
  },
  "DetailedErrors": true,
  "Logging": {
    "LogLevel": {
      "Default": "Information",
      "Microsoft.AspNetCore": "Warning"
    }
  },
  "AllowedHosts": "*",

  // ApiKey: 외부 장비 연동용. 운영 환경에서는 반드시 환경 변수(ApiKey)로 주입합니다.
  // User Secrets 또는 환경 변수에 충분히 긴(>=32자) 무작위 값을 설정하세요.
  "ApiKey": "",

  "UploadPath": "/docker/web/web-uploads",
  "UpdateUploadPath": "/docker/web/web-uploads/update",

  // AdminBootstrap: 최초 관리자 계정 시드용. 비밀번호는 코드/리포지토리에 두지 않습니다.
  // User Secrets 또는 환경 변수(AdminBootstrap__Password)로 주입하세요.
  // 비밀번호가 비어 있으면 시드를 건너뜁니다.
  "AdminBootstrap": {
    "Email": "admin@mxtbiotech.com",
    "Password": ""
  },

  "EmailSettings": {
    "SmtpServer": "smtp.gmail.com",
    "SmtpPort": "587",
    "SenderEmail": "",
    "SenderPassword": ""
  },
  "SendGrid": {
    "ApiKey": "",
    "SenderEmail": "",
    "SenderName": "MxT"
  }
}
