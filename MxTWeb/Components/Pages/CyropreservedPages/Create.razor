@page "/cyropreserveds/create"
@using Microsoft.EntityFrameworkCore
@using MxTWeb.Models
@using MxTWeb.Enums
@using Microsoft.AspNetCore.Authorization
@attribute [Authorize]
@inject IDbContextFactory<MxTWeb.Data.MxTWebContext> DbFactory
@inject NavigationManager NavigationManager
@inject ISnackbar Snackbar

<PageTitle>Create</PageTitle>

<EditForm method="post" Model="Cyropreserved" OnValidSubmit="AddCyropreserved" FormName="create" Enhance>
    <MudDialog>
        <DialogContent>
            <DataAnnotationsValidator />

            <MudTextField Class="mb-5" Variant="Variant.Outlined"
                          Label="세포"
                          @bind-Value="Cyropreserved.Name"
                          For="@(() => Cyropreserved.Name)"
                          Required="true" Immediate="true" />

            <MudGrid Class="mb-5">
                <MudItem xs="6">
                    <MudTextField Variant="Variant.Outlined"
                                  Label="반입자"
                                  @bind-Value="Cyropreserved.Recipient"
                                  For="@(() => Cyropreserved.Recipient)"
                                  Required="true" Immediate="true" />
                </MudItem>

                <MudItem xs="6">
                    <MudDatePicker Variant="Variant.Outlined"
                                   Label="반입날짜"
                                   @bind-Date="Cyropreserved.ReceiptDate"
                                   For="@(() => Cyropreserved.ReceiptDate)"
                                   Required="true" Immediate="true" 
                                   DateFormat="yyyy-MM-dd" />
                </MudItem>
            </MudGrid>

            <MudGrid Class="mb-5">
                <MudItem xs="6">
                    <MudTextField Variant="Variant.Outlined"
                                  Label="반입처"
                                  @bind-Value="Cyropreserved.Supplier"
                                  For="@(() => Cyropreserved.Supplier)"
                                  Required="true" Immediate="true" />
                </MudItem>

                <MudItem xs="6">
                    <MudDatePicker Variant="Variant.Outlined"
                                   Label="동결날짜"
                                   @bind-Date="Cyropreserved.FreezeDate"
                                   DateFormat="yyyy-MM-dd" />
                </MudItem>
            </MudGrid>

            <MudGrid Class="mb-5">
                <MudItem xs="6">
                    <MudTextField Variant="Variant.Outlined"
                                  Label="수량"
                                  @bind-Value="Cyropreserved.Quantity"/>
                </MudItem>

                <MudItem xs="6">
                    <MudTextField Variant="Variant.Outlined"
                                  Label="Lot"
                                  @bind-Value="Cyropreserved.Lot"/>
                </MudItem>
            </MudGrid>

            <MudTextField Class="mb-5"  Variant="Variant.Outlined"
                            Label="Cell density"
                            @bind-Value="Cyropreserved.Density"/>

            <MudTextField Class="mb-5" Variant="Variant.Outlined"
                            Label="보관 위치"
                            @bind-Value="Cyropreserved.Location"/>

            <MudTextField Class="mb-5" Variant="Variant.Outlined"
                            Label="비고"
                            @bind-Value="Cyropreserved.Note"/>
        </DialogContent>
        <DialogActions>
            <MudButton Class="mb-5 me-5" ButtonType="ButtonType.Submit" Variant="Variant.Filled" StartIcon="@Icons.Material.Filled.Add" Color="Color.Info">Add</MudButton>
            <MudButton Class="mb-5 me-5" Variant="Variant.Filled" Color="Color.Secondary" OnClick="() => MudDialog.Cancel()">Cancel</MudButton> 
        </DialogActions>
    </MudDialog>
</EditForm>


@code {
    [SupplyParameterFromForm]
    private Cyropreserved Cyropreserved { get; set; } = new();

    [CascadingParameter]
    private IMudDialogInstance MudDialog { get; set; }

    private async Task AddCyropreserved()
    {
        using var context = DbFactory.CreateDbContext();
        context.Cyropreserved.Add(Cyropreserved);
        await context.SaveChangesAsync();

        Snackbar.Add("성공적으로 추가되었습니다.", Severity.Success);
        MudDialog.Close();
    }

    protected override void OnInitialized()
    {
        Cyropreserved.ReceiptDate = DateTime.Today;
        Cyropreserved.FreezeDate = new DateTime(2000, 1, 1);
    }
}