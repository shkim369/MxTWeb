@page "/cyropreserveds/create"
@using Microsoft.EntityFrameworkCore
@using MxTWeb.Models
@using Microsoft.AspNetCore.Authorization
@attribute [Authorize]
@inject IDbContextFactory<MxTWeb.Data.MxTWebContext> DbFactory
@inject NavigationManager NavigationManager

<PageTitle>Create</PageTitle>

<h1>Create</h1>

<h2>Cyropreserved</h2>
<hr />
<div class="row">
    <div class="col-md-4">
        <EditForm method="post" Model="Cyropreserved" OnValidSubmit="AddCyropreserved" FormName="create" Enhance>
            <DataAnnotationsValidator />
            <ValidationSummary class="text-danger" role="alert"/>
            <div class="mb-3">
                <label for="name" class="form-label">세포:</label> 
                <InputText id="name" @bind-Value="Cyropreserved.Name" class="form-control" /> 
                <ValidationMessage For="() => Cyropreserved.Name" class="text-danger" /> 
            </div>        
            <div class="mb-3">
                <label for="receiptdate" class="form-label">반입날짜:</label> 
                <InputDate id="receiptdate" @bind-Value="Cyropreserved.ReceiptDate" class="form-control" /> 
                <ValidationMessage For="() => Cyropreserved.ReceiptDate" class="text-danger" /> 
            </div>        
            <div class="mb-3">
                <label for="recipient" class="form-label">반입자:</label> 
                <InputText id="recipient" @bind-Value="Cyropreserved.Recipient" class="form-control" /> 
                <ValidationMessage For="() => Cyropreserved.Recipient" class="text-danger" /> 
            </div>        
            <div class="mb-3">
                <label for="supplier" class="form-label">반입처:</label> 
                <InputText id="supplier" @bind-Value="Cyropreserved.Supplier" class="form-control" /> 
                <ValidationMessage For="() => Cyropreserved.Supplier" class="text-danger" /> 
            </div>        
            <div class="mb-3">
                <label for="freezedate" class="form-label">동결날짜:</label> 
                <InputDate id="freezedate" @bind-Value="Cyropreserved.FreezeDate" class="form-control" /> 
                <ValidationMessage For="() => Cyropreserved.FreezeDate" class="text-danger" /> 
            </div>        
            <div class="mb-3">
                <label for="quantity" class="form-label">수량:</label> 
                <InputText id="quantity" @bind-Value="Cyropreserved.Quantity" class="form-control" /> 
                <ValidationMessage For="() => Cyropreserved.Quantity" class="text-danger" /> 
            </div>        
            <div class="mb-3">
                <label for="lot" class="form-label">Lot:</label> 
                <InputText id="lot" @bind-Value="Cyropreserved.Lot" class="form-control" /> 
                <ValidationMessage For="() => Cyropreserved.Lot" class="text-danger" /> 
            </div>        
            <div class="mb-3">
                <label for="density" class="form-label">Cell density:</label> 
                <InputText id="density" @bind-Value="Cyropreserved.Density" class="form-control" /> 
                <ValidationMessage For="() => Cyropreserved.Density" class="text-danger" /> 
            </div>        
            <div class="mb-3">
                <label for="location" class="form-label">보관 위치:</label> 
                <InputText id="location" @bind-Value="Cyropreserved.Location" class="form-control" /> 
                <ValidationMessage For="() => Cyropreserved.Location" class="text-danger" /> 
            </div>        
            <div class="mb-3">
                <label for="note" class="form-label">비고:</label> 
                <InputText id="note" @bind-Value="Cyropreserved.Note" class="form-control" /> 
                <ValidationMessage For="() => Cyropreserved.Note" class="text-danger" /> 
            </div>        
            <button type="submit" class="btn btn-primary">Create</button>
        </EditForm>
    </div>
</div>

<div>
    <a href="/cyropreserveds">Back to List</a>
</div>

@code {
    [SupplyParameterFromForm]
    private Cyropreserved Cyropreserved { get; set; } = new();

    // To protect from overposting attacks, see https://learn.microsoft.com/aspnet/core/blazor/forms/#mitigate-overposting-attacks.
    private async Task AddCyropreserved()
    {
        using var context = DbFactory.CreateDbContext();
        context.Cyropreserved.Add(Cyropreserved);
        await context.SaveChangesAsync();
        NavigationManager.NavigateTo("/cyropreserveds");
    }

	protected override void OnInitialized()
	{
		Cyropreserved.ReceiptDate = DateOnly.FromDateTime(DateTime.Today);
		Cyropreserved.FreezeDate = DateOnly.FromDateTime(new DateTime(2000, 1, 1));		
	}
}
