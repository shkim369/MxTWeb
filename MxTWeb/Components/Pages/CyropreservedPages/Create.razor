@page "/cyropreserveds/create"
@using Microsoft.EntityFrameworkCore
@using MxTWeb.Models
@using Microsoft.AspNetCore.Authorization
@attribute [Authorize]
@inject IDbContextFactory<MxTWeb.Data.MxTWebContext> DbFactory
@inject NavigationManager NavigationManager
@inject ISnackbar Snackbar

<PageTitle>Create</PageTitle>

<EditForm method="post" Model="Cyropreserved" OnValidSubmit="AddCyropreserved" FormName="create" Enhance>
    <MudDialog>
        <DialogContent>
            <DataAnnotationsValidator />

            <MudTextField Class="mb-5" Variant="Variant.Outlined"
                          Label="세포"
                          @bind-Value="Cyropreserved.Name"
                          For="@(() => Cyropreserved.Name)"
                          Required="true" Immediate="true" />

            <MudGrid Class="mb-5">
                <MudItem xs="6">
                    <MudTextField Variant="Variant.Outlined"
                                  Label="반입자"
                                  @bind-Value="Cyropreserved.Recipient"
                                  For="@(() => Cyropreserved.Recipient)"
                                  Required="true" Immediate="true" />
                </MudItem>

                <MudItem xs="6">
                    <MudDatePicker Variant="Variant.Outlined"
                                   Label="반입날짜"
                                   @bind-Value="Cyropreserved.ReceiptDate" />
                </MudItem>
            </MudGrid>

            <MudGrid Class="mb-5">
                <MudItem xs="6">
                    <MudTextField Variant="Variant.Outlined"
                                  Label="반입처"
                                  @bind-Value="Cyropreserved.Supplier"
                                  For="@(() => Cyropreserved.Supplier)"
                                  Required="true" Immediate="true" />
                </MudItem>

                <MudItem xs="6">
                    <MudDatePicker Variant="Variant.Outlined"
                                   Label="동결날짜"
                                   @bind-Value="Cyropreserved.FreezeDate" />
                </MudItem>
            </MudGrid>
              
            <div class="mb-3">
                <label for="quantity" class="form-label">수량:</label> 
                <InputText id="quantity" @bind-Value="Cyropreserved.Quantity" class="form-control" /> 
                <ValidationMessage For="() => Cyropreserved.Quantity" class="text-danger" /> 
            </div>        
            <div class="mb-3">
                <label for="lot" class="form-label">Lot:</label> 
                <InputText id="lot" @bind-Value="Cyropreserved.Lot" class="form-control" /> 
                <ValidationMessage For="() => Cyropreserved.Lot" class="text-danger" /> 
            </div>        
            <div class="mb-3">
                <label for="density" class="form-label">Cell density:</label> 
                <InputText id="density" @bind-Value="Cyropreserved.Density" class="form-control" /> 
                <ValidationMessage For="() => Cyropreserved.Density" class="text-danger" /> 
            </div>        
            <div class="mb-3">
                <label for="location" class="form-label">보관 위치:</label> 
                <InputText id="location" @bind-Value="Cyropreserved.Location" class="form-control" /> 
                <ValidationMessage For="() => Cyropreserved.Location" class="text-danger" /> 
            </div>        
            <div class="mb-3">
                <label for="note" class="form-label">비고:</label> 
                <InputText id="note" @bind-Value="Cyropreserved.Note" class="form-control" /> 
                <ValidationMessage For="() => Cyropreserved.Note" class="text-danger" /> 
            </div>
        </DialogContent>
        <DialogActions>
            <MudButton ButtonType="ButtonType.Submit" Variant="Variant.Filled" StartIcon="@Icons.Material.Filled.Save" Color="Color.Info">Add</MudButton>
            <MudButton Variant="Variant.Filled" Color="Color.Secondary" OnClick="() => MudDialog.Cancel()">Cancel</MudButton> 
        </DialogActions>
    </MudDialog>
</EditForm>


@code {
    [SupplyParameterFromForm]
    private Cyropreserved Cyropreserved { get; set; } = new();

    [CascadingParameter]
    private IMudDialogInstance MudDialog { get; set; }

    // To protect from overposting attacks, see https://learn.microsoft.com/aspnet/core/blazor/forms/#mitigate-overposting-attacks.
    private async Task AddCyropreserved()
    {
        using var context = DbFactory.CreateDbContext();
        context.Cyropreserved.Add(Cyropreserved);
        await context.SaveChangesAsync();

        Snackbar.Add("성공적으로 추가되었습니다.", Severity.Success);
        MudDialog.Close();
    }

	protected override void OnInitialized()
	{
		Cyropreserved.ReceiptDate = DateOnly.FromDateTime(DateTime.Today);
		Cyropreserved.FreezeDate = DateOnly.FromDateTime(new DateTime(2000, 1, 1));		
	}
}