@page "/cyropreserveds/delete"
@using Microsoft.EntityFrameworkCore
@using MxTWeb.Models
@inject IDbContextFactory<MxTWeb.Data.MxTWebContext> DbFactory
@inject NavigationManager NavigationManager

<PageTitle>Delete</PageTitle>

<h1>Delete</h1>

<p>Are you sure you want to delete this?</p>
<div>
    <h2>Cyropreserved</h2>
    <hr />
    @if (cyropreserved is null)
    {
        <p><em>Loading...</em></p>
    }
    else {
        <dl class="row">
            <dt class="col-sm-2">Name</dt>
            <dd class="col-sm-10">@cyropreserved.Name</dd>
        </dl>
        <dl class="row">
            <dt class="col-sm-2">ReceiptDate</dt>
            <dd class="col-sm-10">@cyropreserved.ReceiptDate</dd>
        </dl>
        <dl class="row">
            <dt class="col-sm-2">Recipient</dt>
            <dd class="col-sm-10">@cyropreserved.Recipient</dd>
        </dl>
        <dl class="row">
            <dt class="col-sm-2">Supplier</dt>
            <dd class="col-sm-10">@cyropreserved.Supplier</dd>
        </dl>
        <dl class="row">
            <dt class="col-sm-2">FreezeDate</dt>
            <dd class="col-sm-10">@cyropreserved.FreezeDate</dd>
        </dl>
        <dl class="row">
            <dt class="col-sm-2">Quantity</dt>
            <dd class="col-sm-10">@cyropreserved.Quantity</dd>
        </dl>
        <dl class="row">
            <dt class="col-sm-2">Lot</dt>
            <dd class="col-sm-10">@cyropreserved.Lot</dd>
        </dl>
        <dl class="row">
            <dt class="col-sm-2">Density</dt>
            <dd class="col-sm-10">@cyropreserved.Density</dd>
        </dl>
        <dl class="row">
            <dt class="col-sm-2">Location</dt>
            <dd class="col-sm-10">@cyropreserved.Location</dd>
        </dl>
        <dl class="row">
            <dt class="col-sm-2">Note</dt>
            <dd class="col-sm-10">@cyropreserved.Note</dd>
        </dl>
        <EditForm method="post" Model="cyropreserved" OnValidSubmit="DeleteCyropreserved" FormName="delete" Enhance>
            <button type="submit" class="btn btn-danger" disabled="@(cyropreserved is null)">Delete</button> |
            <a href="/cyropreserveds">Back to List</a>
        </EditForm>
    }
</div>

@code {
    private Cyropreserved? cyropreserved;

    [SupplyParameterFromQuery]
    private int Id { get; set; }

    protected override async Task OnInitializedAsync()
    {
        using var context = DbFactory.CreateDbContext();
        cyropreserved = await context.Cyropreserved.FirstOrDefaultAsync(m => m.Id == Id);

        if (cyropreserved is null)
        {
            NavigationManager.NavigateTo("notfound");
        }
    }

    private async Task DeleteCyropreserved()
    {
        using var context = DbFactory.CreateDbContext();
        context.Cyropreserved.Remove(cyropreserved!);
        await context.SaveChangesAsync();
        NavigationManager.NavigateTo("/cyropreserveds");
    }
}
