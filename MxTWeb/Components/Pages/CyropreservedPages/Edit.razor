@page "/cyropreserveds/edit"
@using Microsoft.EntityFrameworkCore
@using MxTWeb.Models
@using Microsoft.AspNetCore.Authorization
@attribute [Authorize]
@inject IDbContextFactory<MxTWeb.Data.MxTWebContext> DbFactory
@inject NavigationManager NavigationManager
@inject ISnackbar Snackbar

<PageTitle>Edit</PageTitle>

<EditForm method="post" Model="Cyropreserved" OnValidSubmit="OnValidSubmit" FormName="edit" Enhance>
    <MudDialog>
        <DialogContent>
            <DataAnnotationsValidator />

            <MudGrid Class="mb-5">
                <MudItem xs="6">
                    <MudSelect @bind-Value="Cyropreserved.Division" Label="구분" 
                               Variant="Variant.Outlined" Required="true" >
                        <MudSelectItem Value="@("Primary cell")">Primary Cell</MudSelectItem>
                        <MudSelectItem Value="@("Cell line")">Cell Line</MudSelectItem>                
                    </MudSelect>
                </MudItem>

                <MudItem xs="6">
                    <MudTextField Variant="Variant.Outlined"
                                  Label="번호"
                                  @bind-Value="Cyropreserved.Code" />
                </MudItem>
            </MudGrid>

            <MudTextField Class="mb-5" Variant="Variant.Outlined"
                          Label="세포"
                          @bind-Value="Cyropreserved.Name"
                          For="@(() => Cyropreserved.Name)"
                          Required="true" Immediate="true" />

            <MudGrid Class="mb-5">
                <MudItem xs="4">
                    <MudDatePicker Variant="Variant.Outlined"
                                   Label="반입날짜"
                                   @bind-Date="Cyropreserved.ReceiptDate"
                                   For="@(() => Cyropreserved.ReceiptDate)"
                                   Required="true" Immediate="true" 
                                   DateFormat="yyyy-MM-dd" />
                </MudItem>
                <MudItem xs="4">
                    <MudTextField Variant="Variant.Outlined"
                                  Label="반입자"
                                  @bind-Value="Cyropreserved.Recipient" />
                </MudItem>
                <MudItem xs="4">
                    <MudTextField Variant="Variant.Outlined"
                                  Label="반입처"
                                  @bind-Value="Cyropreserved.Supplier" />
                </MudItem>
            </MudGrid>

            <MudGrid Class="mb-5">
                <MudItem xs="4">
                    <MudDatePicker Variant="Variant.Outlined"
                                   Label="동결날짜"
                                   @bind-Date="Cyropreserved.FreezeDate"
                                   DateFormat="yyyy-MM-dd" />
                </MudItem>
                <MudItem xs="4">
                    <MudTextField Variant="Variant.Outlined"
                                  Label="수량"
                                  @bind-Value="Cyropreserved.Quantity" />
                </MudItem>
                <MudItem xs="4">
                    <MudText Typo="Typo.caption" Class="ms-1 mb-1" Style="color: var(--mud-palette-text-secondary)">Cell density</MudText>
                    <div style="display: flex; align-items: center; gap: 4px;">
                        <MudNumericField T="int?" Variant="Variant.Outlined" Style="width: 70px"
                                         @bind-Value="_densityCoefficient" Min="1" Max="9" />
                        <MudText Typo="Typo.body1">×10</MudText>
                        <MudNumericField T="int?" Variant="Variant.Outlined" Style="width: 70px"
                                         @bind-Value="_densityExponent" Min="0" Max="15" />
                        <MudText Typo="Typo.body1" Style="white-space: nowrap">cells/mL</MudText>
                    </div>
                </MudItem>
            </MudGrid>

            <MudGrid Class="mb-5">
                <MudItem xs="6">
                    <MudTextField Variant="Variant.Outlined"
                                  Label="Tank"
                                  @bind-Value="Cyropreserved.Location1" />
                </MudItem>

                <MudItem xs="6">
                    <MudTextField Variant="Variant.Outlined"
                                  Label="Canister"
                                  @bind-Value="Cyropreserved.Location2" />
                </MudItem>
            </MudGrid>

            <MudTextField Class="mb-5" Variant="Variant.Outlined"
                          Label="Passage / Donor / Lot"
                          @bind-Value="Cyropreserved.Lot" />

            <MudGrid Class="mb-5">
                @if (Cyropreserved.Division == "Cell line")
                {
                    <MudItem xs="6">
                        <MudTextField Variant="Variant.Outlined"
                                      Label="Mycoplasma Test"
                                      @bind-Value="Cyropreserved.Test" />
                    </MudItem>

                    <MudItem xs="6">
                        <MudTextField Variant="Variant.Outlined"
                                      Label="비고"
                                      @bind-Value="Cyropreserved.Note" />
                    </MudItem>
                }
                else
                {
                    <MudItem xs="12">
                        <MudTextField Variant="Variant.Outlined"
                                      Label="비고"
                                      @bind-Value="Cyropreserved.Note" />
                    </MudItem>
                }
            </MudGrid>

            <MudGrid Class="mb-5">
                <MudItem xs="4">
                    <MudTextField Variant="Variant.Outlined"
                                  Label="Parent"
                                  @bind-Value="Cyropreserved.Parent" />
                </MudItem>
                <MudItem xs="4">
                    <MudTextField Variant="Variant.Outlined"
                                  Label="Generations"
                                  @bind-Value="Cyropreserved.Generation" />
                </MudItem>
                <MudItem xs="4">
                    <MudTextField Variant="Variant.Outlined"
                                  Label="Origin"
                                  @bind-Value="Cyropreserved.Origin" />
                </MudItem>
            </MudGrid>

        </DialogContent>
        <DialogActions>
            <MudButton Class="mb-5 me-5" ButtonType="ButtonType.Submit" Variant="Variant.Filled"
                       Disabled="@_isProcessing"
                       StartIcon="@(_isProcessing ? Icons.Material.Filled.HourglassEmpty : Icons.Material.Filled.Save)" Color="Color.Info">SAVE</MudButton>
            <MudButton Class="mb-5 me-5" Variant="Variant.Filled" Color="Color.Secondary" OnClick="() => MudDialog.Cancel()">Cancel</MudButton>
        </DialogActions>
    </MudDialog>
</EditForm>


@code {
    [Parameter]
    public UIActionEnum action { get; set; } = UIActionEnum.Insert;

    [SupplyParameterFromQuery]
    private int Id { get; set; }

    [Parameter]
    public Cyropreserved? Cyropreserved { get; set; } = new();

    [CascadingParameter]
    private IMudDialogInstance MudDialog { get; set; }

    private bool _isProcessing = false;
    private int? _densityCoefficient;
    private int? _densityExponent;

    private void ParseDensity()
    {
        if (string.IsNullOrWhiteSpace(Cyropreserved?.Density))
        {
            _densityCoefficient = null;
            _densityExponent = null;
            return;
        }

        var superscriptMap = new Dictionary<char, char>
        {
            {'⁰','0'},{'¹','1'},{'²','2'},{'³','3'},{'⁴','4'},
            {'⁵','5'},{'⁶','6'},{'⁷','7'},{'⁸','8'},{'⁹','9'}
        };

        var text = Cyropreserved.Density.Trim();

        // "3 × 10⁷ cells/mL" 형식 파싱
        var match = System.Text.RegularExpressions.Regex.Match(text, @"^(\d+)\s*[×xX]\s*10(.+?)\s*cells/mL$");
        if (match.Success)
        {
            if (int.TryParse(match.Groups[1].Value, out var coeff))
                _densityCoefficient = coeff;

            var expStr = new string(match.Groups[2].Value.Select(c => superscriptMap.ContainsKey(c) ? superscriptMap[c] : c).ToArray());
            if (int.TryParse(expStr, out var exp))
                _densityExponent = exp;
        }
    }

    private void BuildDensity()
    {
        if (_densityCoefficient.HasValue && _densityExponent.HasValue)
        {
            var superscripts = "⁰¹²³⁴⁵⁶⁷⁸⁹";
            var expStr = string.Concat(_densityExponent.Value.ToString().Select(c => superscripts[c - '0']));
            Cyropreserved!.Density = $"{_densityCoefficient} × 10{expStr} cells/mL";
        }
        else
        {
            Cyropreserved!.Density = null;
        }
    }

    private async Task OnValidSubmit()
    {
        if (_isProcessing) return;
        _isProcessing = true;

        try
        {
            BuildDensity();

            if (action == UIActionEnum.Insert)
            {
                await AddComponent();
            }
            else if (action == UIActionEnum.Update)
            {
                await UpdateCyropreserved();
            }
        }
        finally
        {
            _isProcessing = false;
        }
    }

    protected override async Task OnInitializedAsync()
    {
        if (action == UIActionEnum.Insert)
        {

        }
        else if (action == UIActionEnum.Update)
        {
            using var context = DbFactory.CreateDbContext();
            Cyropreserved ??= await context.Cyropreserved.FirstOrDefaultAsync(m => m.Id == Id);

            if (Cyropreserved is null)
            {
                NavigationManager.NavigateTo("notfound");
            }
        }

        ParseDensity();
    }

    private async Task AddComponent()
    {
        using var context = DbFactory.CreateDbContext();
        context.Cyropreserved.Add(Cyropreserved);
        await context.SaveChangesAsync();

        Snackbar.Add("성공적으로 추가되었습니다.", Severity.Success);
        MudDialog.Close();
    }

    private async Task UpdateCyropreserved()
    {
        using var context = DbFactory.CreateDbContext();
        context.Attach(Cyropreserved!).State = EntityState.Modified;

        try
        {
            await context.SaveChangesAsync();
        }
        catch (DbUpdateConcurrencyException)
        {
            if (!CyropreservedExists(Cyropreserved!.Id))
            {
                NavigationManager.NavigateTo("notfound");
            }
            else
            {
                throw;
            }
        }

        Snackbar.Add("성공적으로 수정되었습니다.", Severity.Success);
        MudDialog.Close();
    }

    private bool CyropreservedExists(int id)
    {
        using var context = DbFactory.CreateDbContext();
        return context.Cyropreserved.Any(e => e.Id == id);
    }
}
