@page "/cyropreserveds/edit"
@using Microsoft.EntityFrameworkCore
@using MxTWeb.Models
@using Microsoft.AspNetCore.Authorization
@attribute [Authorize]
@inject IDbContextFactory<MxTWeb.Data.MxTWebContext> DbFactory
@inject NavigationManager NavigationManager
@inject ISnackbar Snackbar

<PageTitle>Edit</PageTitle>

<EditForm method="post" Model="Cyropreserved" OnValidSubmit="OnValidSubmit" FormName="edit" Enhance>
    <MudDialog>
        <DialogContent>
            <DataAnnotationsValidator />

            <MudGrid Class="mb-5">
                <MudItem xs="6">
                    <MudSelect @bind-Value="Cyropreserved.Division" Label="구분" 
                               Variant="Variant.Outlined" Required="true" >
                        <MudSelectItem Value="@("Primary cell")">Primary Cell</MudSelectItem>
                        <MudSelectItem Value="@("Cell line")">Cell Line</MudSelectItem>                
                    </MudSelect>
                </MudItem>

                <MudItem xs="6">
                    <MudTextField Variant="Variant.Outlined"
                                  Label="번호"
                                  @bind-Value="Cyropreserved.Code" />
                </MudItem>
            </MudGrid>

            <MudTextField Class="mb-5" Variant="Variant.Outlined"
                          Label="세포"
                          @bind-Value="Cyropreserved.Name"
                          For="@(() => Cyropreserved.Name)"
                          Required="true" Immediate="true" />

            <MudGrid Class="mb-5">
                <MudItem xs="6">
                    <MudTextField Variant="Variant.Outlined"
                                    Label="반입자"
                                    @bind-Value="Cyropreserved.Recipient"/>
                </MudItem>

                <MudItem xs="6">
                    <MudDatePicker Variant="Variant.Outlined"
                                   Label="반입날짜"
                                   @bind-Date="Cyropreserved.ReceiptDate"
                                   For="@(() => Cyropreserved.ReceiptDate)"
                                   Required="true" Immediate="true" 
                                   DateFormat="yyyy-MM-dd" />
                </MudItem>
            </MudGrid>

            <MudGrid Class="mb-5">
                <MudItem xs="6">
                    <MudTextField Variant="Variant.Outlined"
                                  Label="반입처"
                                  @bind-Value="Cyropreserved.Supplier"/>
                </MudItem>

                <MudItem xs="6">
                    <MudDatePicker Variant="Variant.Outlined"
                                   Label="동결날짜"
                                   @bind-Date="Cyropreserved.FreezeDate"
                                   DateFormat="yyyy-MM-dd" />
                </MudItem>
            </MudGrid>

            <MudGrid Class="mb-5">
                <MudItem xs="6">
                    <MudTextField Variant="Variant.Outlined"
                                  Label="수량"
                                  @bind-Value="Cyropreserved.Quantity"/>
                </MudItem>

                <MudItem xs="6">
                    <MudTextField Variant="Variant.Outlined"
                                  Label="Cell density"
                                  @bind-Value="Cyropreserved.Density" />
                </MudItem>
            </MudGrid>

            <MudTextField Class="mb-5" Variant="Variant.Outlined"
                          Label="Passage / Donor / Lot"
                          @bind-Value="Cyropreserved.Lot" />

            <MudGrid Class="mb-5">
                <MudItem xs="6">
                    <MudTextField Variant="Variant.Outlined"
                                  Label="Tank"
                                  @bind-Value="Cyropreserved.Location1" />
                </MudItem>

                <MudItem xs="6">
                    <MudTextField Variant="Variant.Outlined"
                                  Label="Canister"
                                  @bind-Value="Cyropreserved.Location2" />
                </MudItem>
            </MudGrid>

            <MudGrid Class="mb-5">
                @if (Cyropreserved.Division == "Cell line")
                {
                    <MudItem xs="6">
                        <MudTextField Variant="Variant.Outlined"
                                      Label="Mycoplasma Test"
                                      @bind-Value="Cyropreserved.Test" />
                    </MudItem>

                    <MudItem xs="6">
                        <MudTextField Variant="Variant.Outlined"
                                      Label="비고"
                                      @bind-Value="Cyropreserved.Note" />
                    </MudItem>
                }
                else
                {
                    <MudItem xs="12">
                        <MudTextField Variant="Variant.Outlined"
                                      Label="비고"
                                      @bind-Value="Cyropreserved.Note" />
                    </MudItem>
                }
            </MudGrid>

            <MudGrid Class="mb-5">
                <MudItem xs="4">
                    <MudTextField Variant="Variant.Outlined"
                                  Label="Parent"
                                  @bind-Value="Cyropreserved.Parent" />
                </MudItem>
                <MudItem xs="4">
                    <MudTextField Variant="Variant.Outlined"
                                  Label="Generations"
                                  @bind-Value="Cyropreserved.level" />
                </MudItem>
                <MudItem xs="4">
                    <MudTextField Variant="Variant.Outlined"
                                  Label="Origin"
                                  @bind-Value="Cyropreserved.Origin" />
                </MudItem>
            </MudGrid>

        </DialogContent>
        <DialogActions>
            <MudButton Class="mb-5 me-5" ButtonType="ButtonType.Submit" Variant="Variant.Filled" StartIcon="@Icons.Material.Filled.Save" Color="Color.Info">SAVE</MudButton>
            <MudButton Class="mb-5 me-5" Variant="Variant.Filled" Color="Color.Secondary" OnClick="() => MudDialog.Cancel()">Cancel</MudButton>
        </DialogActions>
    </MudDialog>
</EditForm>


@code {
    [Parameter]
    public UIActionEnum action { get; set; } = UIActionEnum.Insert;

    [SupplyParameterFromQuery]
    private int Id { get; set; }

    [Parameter]
    public Cyropreserved? Cyropreserved { get; set; } = new();

    [CascadingParameter]
    private IMudDialogInstance MudDialog { get; set; }

    private async Task OnValidSubmit()
    {
        if (action == UIActionEnum.Insert)
        {
            await AddComponent();
        }
        else if (action == UIActionEnum.Update)
        {
            await UpdateCyropreserved();
        }
    }

    protected override async Task OnInitializedAsync()
    {
        if (action == UIActionEnum.Insert)
        {

        }
        else if (action == UIActionEnum.Update)
        {
            using var context = DbFactory.CreateDbContext();
            Cyropreserved ??= await context.Cyropreserved.FirstOrDefaultAsync(m => m.Id == Id);

            if (Cyropreserved is null)
            {
                NavigationManager.NavigateTo("notfound");
            }
        }
    }

    private async Task AddComponent()
    {
        using var context = DbFactory.CreateDbContext();
        context.Cyropreserved.Add(Cyropreserved);
        await context.SaveChangesAsync();

        Snackbar.Add("성공적으로 추가되었습니다.", Severity.Success);
        MudDialog.Close();
    }

    private async Task UpdateCyropreserved()
    {
        using var context = DbFactory.CreateDbContext();
        context.Attach(Cyropreserved!).State = EntityState.Modified;

        try
        {
            await context.SaveChangesAsync();
        }
        catch (DbUpdateConcurrencyException)
        {
            if (!CyropreservedExists(Cyropreserved!.Id))
            {
                NavigationManager.NavigateTo("notfound");
            }
            else
            {
                throw;
            }
        }

        Snackbar.Add("성공적으로 수정되었습니다.", Severity.Success);
        MudDialog.Close();
    }

    private bool CyropreservedExists(int id)
    {
        using var context = DbFactory.CreateDbContext();
        return context.Cyropreserved.Any(e => e.Id == id);
    }
}
