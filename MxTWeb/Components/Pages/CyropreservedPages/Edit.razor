@page "/cyropreserveds/edit"
@using Microsoft.EntityFrameworkCore
@using MxTWeb.Models
@using Microsoft.AspNetCore.Authorization
@attribute [Authorize]
@inject IDbContextFactory<MxTWeb.Data.MxTWebContext> DbFactory
@inject NavigationManager NavigationManager
@inject ISnackbar Snackbar

<PageTitle>Edit</PageTitle>

<EditForm method="post" Model="Cyropreserved" OnValidSubmit="UpdateCyropreserved" FormName="edit" Enhance>
    <MudDialog>
        <DialogContent>
            <DataAnnotationsValidator />

            <MudTextField Class="mb-5" Variant="Variant.Outlined"
                            Label="세포"
                            id="cell" @bind-Value="Cyropreserved.Name"
                            For="@(() => Cyropreserved.Name)"
                            Required="true" Immediate="true" />

            <MudGrid Class="mb-5">
                <MudItem xs="6">
                    <MudTextField Variant="Variant.Outlined"
                                    Label="반입자"
                                    @bind-Value="Cyropreserved.Recipient"
                                    For="@(() => Cyropreserved.Recipient)"
                                    Required="true" Immediate="true" />
                </MudItem>

                <MudItem xs="6">
                    <MudDatePicker Variant="Variant.Outlined"
                                   Label="반입날짜"
                                   @bind-Date="Cyropreserved.ReceiptDate"
                                   For="@(() => Cyropreserved.ReceiptDate)"
                                   Required="true" Immediate="true" 
                                   DateFormat="yyyy-MM-dd" />
                </MudItem>
            </MudGrid>

            <MudGrid Class="mb-5">
                <MudItem xs="6">
                    <MudTextField Variant="Variant.Outlined"
                                  Label="반입처"
                                  @bind-Value="Cyropreserved.Supplier"
                                  For="@(() => Cyropreserved.Supplier)"
                                  Required="true" Immediate="true" />
                </MudItem>

                <MudItem xs="6">
                    <MudDatePicker Variant="Variant.Outlined"
                                   Label="동결날짜"
                                   @bind-Date="Cyropreserved.FreezeDate"
                                   DateFormat="yyyy-MM-dd" />
                </MudItem>
            </MudGrid>

            <MudGrid Class="mb-5">
                <MudItem xs="6">
                    <MudTextField Variant="Variant.Outlined"
                                  Label="수량"
                                  @bind-Value="Cyropreserved.Quantity"/>
                </MudItem>

                <MudItem xs="6">
                    <MudTextField Variant="Variant.Outlined"
                                  Label="Lot"
                                  @bind-Value="Cyropreserved.Lot"/>
                </MudItem>
            </MudGrid>

            <MudTextField Class="mb-5" Variant="Variant.Outlined"
                            Label="Cell density"
                            @bind-Value="Cyropreserved.Density"/>

            <MudTextField Class="mb-5"Variant="Variant.Outlined"
                            Label="보관 위치"
                            @bind-Value="Cyropreserved.Location"/>


            <MudTextField Class="mb-5" Variant="Variant.Outlined"
                            Label="비고"
                            @bind-Value="Cyropreserved.Note"/>
        </DialogContent>
        <DialogActions>
            <MudButton Class="mb-5 me-5" ButtonType="ButtonType.Submit" Variant="Variant.Filled" StartIcon="@Icons.Material.Filled.Save" Color="Color.Info">SAVE</MudButton>
            <MudButton Class="mb-5 me-5" Variant="Variant.Filled" Color="Color.Secondary" OnClick="() => MudDialog.Cancel()">Cancel</MudButton>
        </DialogActions>
    </MudDialog>
</EditForm>


@code {
    [SupplyParameterFromQuery]
    private int Id { get; set; }

    [Parameter]
	public Cyropreserved? Cyropreserved { get; set; } = new();

    [CascadingParameter]
    private IMudDialogInstance MudDialog { get; set; }

    protected override async Task OnInitializedAsync()
    {
        // using var context = DbFactory.CreateDbContext();
        // Cyropreserved ??= await context.Cyropreserved.FirstOrDefaultAsync(m => m.Id == Id);

        // if (Cyropreserved is null)
        // {
        //     NavigationManager.NavigateTo("notfound");
        // }

        Cyropreserved = new Cyropreserved
        {
            Id = Cyropreserved.Id,
            Name = Cyropreserved.Name,
			Recipient = Cyropreserved.Recipient,
			ReceiptDate = Cyropreserved.ReceiptDate,
			Supplier = Cyropreserved.Supplier,
			FreezeDate = Cyropreserved.FreezeDate,
			Quantity = Cyropreserved.Quantity,
			Lot = Cyropreserved.Lot,
			Density = Cyropreserved.Density,
			Location = Cyropreserved.Location,
			Note = Cyropreserved.Note
        };
    }

    private async Task UpdateCyropreserved()
    {
        using var context = DbFactory.CreateDbContext();
        context.Attach(Cyropreserved!).State = EntityState.Modified;

        try
        {
            await context.SaveChangesAsync();
        }
        catch (DbUpdateConcurrencyException)
        {
            if (!CyropreservedExists(Cyropreserved!.Id))
            {
                NavigationManager.NavigateTo("notfound");
            }
            else
            {
                throw;
            }
        }

        Snackbar.Add("성공적으로 수정되었습니다.", Severity.Success);
        MudDialog.Close();
    }

    private bool CyropreservedExists(int id)
    {
        using var context = DbFactory.CreateDbContext();
        return context.Cyropreserved.Any(e => e.Id == id);
    }
}
