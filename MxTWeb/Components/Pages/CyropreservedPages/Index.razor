@page "/cyropreserveds"
@rendermode InteractiveServer
@using Microsoft.EntityFrameworkCore
@using Microsoft.AspNetCore.Components.QuickGrid
@using Microsoft.AspNetCore.Authorization;
@using MxTWeb.Models
@using MxTWeb.Data
@implements IAsyncDisposable
@inject IDbContextFactory<MxTWeb.Data.MxTWebContext> DbFactory

<PageTitle>동결세포 목록</PageTitle>

<h1>동결세포 목록</h1>

@* <div>
    <form action="/movies" data-enhance data-permanent>
        <input type="search" name="NameFilter" />
        <input type="submit" value="Search" />
    </form>
</div> *@
<br />
<div class="dropdown">
    <button class="btn btn dropdown-toggle" @onclick="ToggleDropdown">
        @selectedLabel
    </button>
    
    @if (isOpen)
    {
        <ul class="dropdown-menu show">
            <li><a class="dropdown-item" @onclick="@(() => SelectItem("Apple"))">Apple</a></li>
            <li><a class="dropdown-item" @onclick="@(() => SelectItem("banana"))">banana</a></li>
        </ul>
    }

    <input type="search" @bind="NameFilter" @bind:event="oninput" pattern="[A-Za-z0-9\s]*" />

    <i class="bi bi-search"></i> Search
</div>
<br /><br />
<p>
    <a href="cyropreserveds/create" class="btn btn-outline-secondary">Create New</a>
</p>

<div>
    <QuickGrid Class="table" Items="FilteredCyropreserveds" Pagination="pagination">
        <PropertyColumn Property="cyropreserved => cyropreserved.Id" Title="#" Align="Align.Center"/>
        <PropertyColumn Property="cyropreserved => cyropreserved.Name" Title="🧫세포" Align="Align.Center"
                        sortable="true"/>
        <PropertyColumn Property="cyropreserved => cyropreserved.ReceiptDate" Title="반입 날짜" Align="Align.Center" 
                        Sortable="true"/>
        <PropertyColumn Property="cyropreserved => cyropreserved.Recipient" Title="반입자" Align="Align.Center" />
        <PropertyColumn Property="cyropreserved => cyropreserved.Supplier" Title="반입처" Align="Align.Center" />
        <PropertyColumn Property="cyropreserved => cyropreserved.FreezeDate" Title="동결 날짜" Align="Align.Center" />
        <PropertyColumn Property="cyropreserved => cyropreserved.Quantity" Title="수량" Align="Align.Center" />
        <PropertyColumn Property="cyropreserved => cyropreserved.Lot" Title="Lot" Align="Align.Center" />
        <PropertyColumn Property="cyropreserved => cyropreserved.Density" Title="Cell density" Align="Align.Center" />
        <PropertyColumn Property="cyropreserved => cyropreserved.Location" Title="보관 위치" Align="Align.Center" />
        <PropertyColumn Property="cyropreserved => cyropreserved.Note" Title="비고" Align="Align.Center" />

        <TemplateColumn Context="cyropreserved">
            <a href="@($"cyropreserveds/edit?id={cyropreserved.Id}")" class="btn btn-primary px-4">Edit</a>
            @* <a href="@($"cyropreserveds/details?id={cyropreserved.Id}")" class="btn btn-info">Details</a> *@
            <a href="@($"cyropreserveds/delete?id={cyropreserved.Id}")" class="btn btn-danger">Delete</a>
        </TemplateColumn>
    </QuickGrid>
</div>

<Paginator State="pagination" />

@code {
    private MxTWebContext context = default!;

    // [SupplyParameterFromQuery]
    // private string? NameFilter { get; set; }

    // private IQueryable<Cyropreserved> FilteredCyropreserveds =>
    //     context.Cyropreserved.Where(m => m.Name!.Contains(NameFilter ?? string.Empty));

    private string NameFilter = string.Empty;
    private bool isOpen = false;

    private IQueryable<Cyropreserved> FilteredCyropreserveds =>
        context.Cyropreserved.Where(m => m.Name!.Contains(NameFilter));

    private string selectedItem = "";
    private string selectedLabel => string.IsNullOrEmpty(selectedItem) ? "항목 선택" : selectedItem;

    private PaginationState pagination = new PaginationState { ItemsPerPage = 15 };

    private void ToggleDropdown()
    {
        isOpen = !isOpen;
    }
    private void SelectItem(string item)
    {
        selectedItem = item;
        isOpen = false;
    }

    protected override void OnInitialized()
    {
        context = DbFactory.CreateDbContext();
    }

    public async ValueTask DisposeAsync() => await context.DisposeAsync();
}
