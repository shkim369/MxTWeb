@page "/cyropreserveds"
@rendermode InteractiveServer
@using Microsoft.EntityFrameworkCore
@using Microsoft.AspNetCore.Components.QuickGrid
@using Microsoft.AspNetCore.Authorization;
@using MxTWeb.Models
@using MxTWeb.Data
@implements IAsyncDisposable
@inject IDbContextFactory<MxTWeb.Data.MxTWebContext> DbFactory

<PageTitle>동결세포 목록</PageTitle>

<h1>동결세포 목록</h1>

<br />
<div class="dropdown">
	<button class="btn btn-outline-secondary dropdown-toggle" type="button" data-bs-toggle="dropdown" aria-expanded="false">
		@SearchField
	</button>
	<ul class="dropdown-menu">
		<li><a class="dropdown-item" @onclick="@(() => SelectItem("세포"))">세포</a></li>
        <li><a class="dropdown-item" @onclick="@(() => SelectItem("반입 날짜"))">반입 날짜</a></li>
        <li><a class="dropdown-item" @onclick="@(() => SelectItem("반입자"))">반입자</a></li>
        <li><a class="dropdown-item" @onclick="@(() => SelectItem("반입처"))">반입처</a></li>
        <li><a class="dropdown-item" @onclick="@(() => SelectItem("보관 위치"))">보관 위치</a></li>
	</ul>

    <input type="search" @bind="SearchFilter" @bind:event="onchange" placeholder="검색어 입력" pattern="[A-Za-z0-9\s]*"
           style="width:300px; margin-top:20px;"/>

    <i class="bi bi-search"></i> Search
</div>
<br />
<p>
	<a href="cyropreserveds/create" class="btn btn-outline-secondary">Create New</a>
</p>

<div>
    <QuickGrid Class="table table-bordered table-sm" Items="FilteredCyropreserveds" Pagination="pagination">
        <PropertyColumn Property="cyropreserved => cyropreserved.Name" Title="🧫세포" Align="Align.Center"
                        sortable="true"/>
        <PropertyColumn Property="cyropreserved => cyropreserved.ReceiptDate" Title="반입 날짜" Align="Align.Center" 
                        Sortable="true"/>
        <PropertyColumn Property="cyropreserved => cyropreserved.Recipient" Title="반입자" Align="Align.Center" />
        <PropertyColumn Property="cyropreserved => cyropreserved.Supplier" Title="반입처" Align="Align.Center" />
        <PropertyColumn Property="cyropreserved => cyropreserved.FreezeDate" Title="동결 날짜" Align="Align.Center" />
        <PropertyColumn Property="cyropreserved => cyropreserved.Quantity" Title="수량" Align="Align.Center" />
        <PropertyColumn Property="cyropreserved => cyropreserved.Lot" Title="Lot" Align="Align.Center" />
        <PropertyColumn Property="cyropreserved => cyropreserved.Density" Title="Cell density" Align="Align.Center" />
        <PropertyColumn Property="cyropreserved => cyropreserved.Location" Title="보관 위치" Align="Align.Center" />
        <PropertyColumn Property="cyropreserved => cyropreserved.Note" Title="비고" Align="Align.Center" />

        <TemplateColumn Context="cyropreserved">
            <div class="d-flex">
                <a href="@($"cyropreserveds/edit?id={cyropreserved.Id}")" class="btn btn-primary px-4">Edit</a>
                <a href="@($"cyropreserveds/delete?id={cyropreserved.Id}")" class="btn btn-danger">Delete</a>
            </div>
        </TemplateColumn>
    </QuickGrid>
</div>

<Paginator State="pagination" />

@code {
    private MxTWebContext context = default!;

    private PaginationState pagination = new PaginationState { ItemsPerPage = 15 };

    private string SearchFilter = string.Empty;
    private string SearchField = "세포"; // Default search field

    private void SelectItem(string item)
    {
        SearchField = item;
    }

    private IQueryable<Cyropreserved> FilteredCyropreserveds => GetFilteredData();

    private IQueryable<Cyropreserved> GetFilteredData()
    {
        return SearchField switch
        {
            "세포" => context.Cyropreserved.Where(m => m.Name!.Contains(SearchFilter)),
            "반입 날짜" => context.Cyropreserved.Where(m => m.ReceiptDate.ToString().Contains(SearchFilter)),
            "반입자" => context.Cyropreserved.Where(m => m.Recipient!.Contains(SearchFilter)),
            "반입처" => context.Cyropreserved.Where(m => m.Supplier!.Contains(SearchFilter)),
            "보관 위치" => context.Cyropreserved.Where(m => m.Location!.Contains(SearchFilter)),
            _ => context.Cyropreserved.Where(m => m.Name!.Contains(SearchFilter))
        };     
    }

    protected override void OnInitialized()
    {
        context = DbFactory.CreateDbContext();
    }

    public async ValueTask DisposeAsync() => await context.DisposeAsync();
}
