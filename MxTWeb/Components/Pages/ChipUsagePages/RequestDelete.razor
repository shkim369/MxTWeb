@page "/chipusagerequests/delete"
@using Microsoft.EntityFrameworkCore
@using MxTWeb.Models
@using MxTWeb.Enums
@using Microsoft.AspNetCore.Authorization
@attribute [Authorize]
@inject IDbContextFactory<MxTWeb.Data.MxTWebContext> DbFactory
@inject ISnackbar Snackbar

<PageTitle>칩 사용 신청서 삭제</PageTitle>

<MudDialog>
    <DialogContent>
        <MudText Typo="Typo.h6" Class="mb-4">정말 이 신청서를 삭제하시겠습니까?</MudText>

        @if (Request != null)
        {
            <MudPaper Class="pa-3" Elevation="1" Style="background-color: #fff3e0;">
                <MudGrid>
                    <MudItem xs="6"><MudText Typo="Typo.body2"><strong>칩 타입:</strong> @GetChipTypeName(Request.ChipType)</MudText></MudItem>
                    <MudItem xs="6"><MudText Typo="Typo.body2"><strong>신청자:</strong> @Request.Applicant</MudText></MudItem>
                    <MudItem xs="6"><MudText Typo="Typo.body2"><strong>신청일:</strong> @Request.ApplicationDate?.ToString("yyyy-MM-dd")</MudText></MudItem>
                    <MudItem xs="6"><MudText Typo="Typo.body2"><strong>신청 수량:</strong> @Request.RequestedQuantity</MudText></MudItem>
                    <MudItem xs="6"><MudText Typo="Typo.body2"><strong>상태:</strong> @GetStatusText(Request.Status)</MudText></MudItem>
                </MudGrid>
            </MudPaper>

            @if (Request.Status == RequestStatusEnum.Approved)
            {
                <MudAlert Severity="Severity.Warning" Class="mt-4">
                    이미 승인된 신청서입니다.
                </MudAlert>
            }
        }
    </DialogContent>

    <DialogActions>
        <MudButton Class="mb-3 me-5" Variant="Variant.Filled" Color="Color.Error"
                   StartIcon="@Icons.Material.Filled.Delete" OnClick="DeleteRequest">삭제</MudButton>
        <MudButton Class="mb-3 me-5" Variant="Variant.Filled" Color="Color.Secondary"
                   OnClick="() => MudDialog.Cancel()">취소</MudButton>
    </DialogActions>
</MudDialog>

@code {
    [Parameter]
    public ChipusageRequest? Request { get; set; }

    [CascadingParameter]
    private IMudDialogInstance MudDialog { get; set; } = null!;

    private string GetChipTypeName(int chipType) => chipType switch
    {
        0 => "B01_Small",
        1 => "B01_Large",
        2 => "A01_Small",
        3 => "A01_Large",
        _ => "알 수 없음"
    };

    private string GetStatusText(RequestStatusEnum status)
    {
        return status switch
        {
            RequestStatusEnum.Pending => "대기",
            RequestStatusEnum.Approved => "승인",
            RequestStatusEnum.Rejected => "반려",
            _ => "알 수 없음"
        };
    }

    private async Task DeleteRequest()
    {
        if (Request == null) return;

        using var context = DbFactory.CreateDbContext();

        var req = await context.ChipUsageRequest.FindAsync(Request.Id);
        if (req != null)
        {
            context.ChipUsageRequest.Remove(req);
            await context.SaveChangesAsync();
        }

        Snackbar.Add("신청서가 삭제되었습니다.", Severity.Success);
        MudDialog.Close(DialogResult.Ok(true));
    }
}
