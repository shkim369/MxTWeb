@page "/chipusages/create"
@rendermode InteractiveServer
@using Microsoft.EntityFrameworkCore
@using MxTWeb.Models
@using Microsoft.AspNetCore.Authorization
@attribute [Authorize]
@inject IDbContextFactory<MxTWeb.Data.MxTWebContext> DbFactory
@inject NavigationManager NavigationManager
@inject ISnackbar Snackbar

<PageTitle>Create</PageTitle>


<EditForm method="post" Model="ChipUsage" OnValidSubmit="AddChipUsage" FormName="create" Enhance>
    <MudDialog>
        <DialogContent>
            <DataAnnotationsValidator />

            <MudGrid Class="mb-5">
                <MudItem xs="2">
                    <MudText Typo="Typo.h6">Chip 종류</MudText>
                </MudItem>
                <MudItem xs="6">
                    <MudMenu Label="@ChipUsage.Chip" Variant="Variant.Outlined" EndIcon="@Icons.Material.Filled.KeyboardArrowDown" IconColor="Color.Default">
                        <MudMenuItem Label="A01_Small" @onclick="@(() => SelectChip("A01_Small"))" />
                        <MudMenuItem Label="A01_Large" @onclick="@(() => SelectChip("A01_Large"))" />
                        <MudMenuItem Label="B01_Small" @onclick="@(() => SelectChip("B01_Small"))" />
                        <MudMenuItem Label="B01_Large" @onclick="@(() => SelectChip("B01_Large"))" />
                    </MudMenu>
                </MudItem>
            </MudGrid>

            <MudTextField Class="mb-5" Variant="Variant.Outlined"
                          Label="구분"
                          @bind-Value="ChipUsage.Division" 
                          For="@(() => ChipUsage.Division)"
                          Required="true" Immediate="true" />
            <MudDatePicker Class="mb-5" Variant="Variant.Outlined"
                          Label="사용 일자"
                          @bind-Date="ChipUsage.UseDate"
                          DateFormat="yyyy-MM-dd" />
            <MudTextField Class="mb-5" Variant="Variant.Outlined"
                          Label="작업자"
                          @bind-Value="ChipUsage.Producer" />
            <MudTextField Class="mb-5" Variant="Variant.Outlined"
                          Label="웨이퍼"
                          @bind-Value="ChipUsage.Wafer" />
            <MudTextField Class="mb-5" Variant="Variant.Outlined"
                          Label="웨이퍼 정보"
                          @bind-Value="ChipUsage.WaferInfo" />
            <MudDatePicker Class="mb-5" Variant="Variant.Outlined"
                          Label="납품일시"
                          @bind-Date="ChipUsage.ReceiptDate" 
                          DateFormat="yyyy-MM-dd" />
            <MudTextField Class="mb-5" Variant="Variant.Outlined"
                          Label="사용자"
                          @bind-Value="ChipUsage.Operator" />

            <MudGrid Class="mb-5">
                <MudItem xs="4">
                    <MudTextField Variant="Variant.Outlined"
                                  Label="사용 가능 칩"
                                  @bind-Value="ChipUsage.Available"/>
                </MudItem>

                <MudItem xs="4">
                    <MudTextField Variant="Variant.Outlined"
                                  Label="생산한 칩"
                                  @bind-Value="ChipUsage.Production" />
                </MudItem>

                <MudItem xs="4">
                    <MudTextField Variant="Variant.Outlined"
                                  Label="재고"
                                  @bind-Value="ChipUsage.Left" />
                </MudItem>
            </MudGrid>

            <MudTextField Class="mb-5" Variant="Variant.Outlined"
                          Label="Lot."
                          @bind-Value="ChipUsage.Lot" />

            <MudTextField Class="mb-5" Variant="Variant.Outlined"
                          Label="비고"
                          @bind-Value="ChipUsage.Note" />
        </DialogContent>
        <DialogActions>
            <MudButton Class="mb-5 me-5" ButtonType="ButtonType.Submit" Variant="Variant.Filled" StartIcon="@Icons.Material.Filled.Add" Color="Color.Info">Add</MudButton>
            <MudButton Class="mb-5 me-5" Variant="Variant.Filled" Color="Color.Secondary" OnClick="() => MudDialog.Cancel()">Cancel</MudButton>
        </DialogActions>
    </MudDialog>
</EditForm>

@code {
    [SupplyParameterFromForm]
    private ChipUsage ChipUsage { get; set; } = new();

    [CascadingParameter]
    private IMudDialogInstance MudDialog { get; set; }

    protected override void OnInitialized()
    {
		ChipUsage.Chip = "Large"; // Default value

        ChipUsage.UseDate = DateTime.Today;
        ChipUsage.ReceiptDate = new DateTime(2000, 1, 1);
    }

    private void SelectChip(string Type)
    {
		ChipUsage.Chip = Type;
    }

    // To protect from overposting attacks, see https://learn.microsoft.com/aspnet/core/blazor/forms/#mitigate-overposting-attacks.
    private async Task AddChipUsage()
    {
        using var context = DbFactory.CreateDbContext();
        context.ChipUsage.Add(ChipUsage);
        await context.SaveChangesAsync();
        NavigationManager.NavigateTo("/chipusages");

        Snackbar.Add("성공적으로 추가되었습니다.", Severity.Success);
        MudDialog.Close();
    }
}
