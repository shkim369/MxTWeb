        </MudDataGrid>
    </MudTabPanel>

    <MudTabPanel Text="RUO Chip Pressure" >
        <MudGrid Spacing="5" Style="margin-top: 0px; margin-bottom: 10px">
            <MudSpacer />
            <MudSpacer />
            <MudMenu Label="@PresSearchField" Variant="Variant.Filled" EndIcon="@Icons.Material.Filled.KeyboardArrowDown" IconColor="Color.Secondary">
                <MudMenuItem Label="웨이퍼 정보" @onclick="@(() => SelectPresSearchField("웨이퍼 정보"))" />
                <MudMenuItem Label="웨이퍼 Lot" @onclick="@(() => SelectPresSearchField("웨이퍼 Lot"))" />
                <MudMenuItem Label="테스트 날짜" @onclick="@(() => SelectPresSearchField("테스트 날짜"))" />
            </MudMenu>
            &nbsp&nbsp&nbsp&nbsp
            <MudTextField T="string" Value="_presSearchFilter" ValueChanged="OnPresSearchChanged" DebounceInterval="300"
                          Placeholder="Search" Adornment="Adornment.Start" Immediate="true"
                          AdornmentIcon="@Icons.Material.Filled.Search" IconSize="Size.Medium" Class="mt-1"></MudTextField>
        </MudGrid>

        @* 예전: 압력 데이터 전체(Items)를 페이저 없이 한 번에 렌더링 → 데이터가 많으면 탭이 열리지 않음.
           지금: 서버 페이징 + 페이저.
           셀 편집 모드라 모든 셀이 입력 컴포넌트(DatePicker/NumericField/Select)로 렌더링되고, 회로 메모리가
           '표시 행 수 × 편집 컬럼 수'에 비례한다(100행 ≈ 컴포넌트 8,600개). 그래서 기본 25행, 필요 시 50/100 선택. *@
        <MudDataGrid T="ChipPressure" Class="custom-grid" @ref="pressureGrid" ServerData="LoadPressuresAsync" SortMode="SortMode.Single"
                     Dense="true" Style="white-space: nowrap" Hover="true" Bordered="true" Striped="true" RowsPerPage="25"
                     EditMode="DataGridEditMode.Cell" ReadOnly="false"
                     CommittedItemChanges="@CommittedItemChanges">
            <Columns>
                <TemplateColumn Title="제조 날짜" Context="x" Sortable="false">
                    <EditTemplate>
                        <MudDatePicker @bind-Date="x.Item.ProduceDate" DateFormat="yyyy-MM-dd" PickerClosed="@(() => CommittedItemChanges(x.Item))" />
                    </EditTemplate>
                </TemplateColumn>
                <TemplateColumn Title="테스트 날짜" Context="x" Sortable="false">
                    <EditTemplate>
                        <MudDatePicker @bind-Date="x.Item.TestDate" DateFormat="yyyy-MM-dd" PickerClosed="@(() => CommittedItemChanges(x.Item))"/>
                    </EditTemplate>
                </TemplateColumn>
                <PropertyColumn Property="x => x.WaferInfo" Title="웨이퍼 정보" />
                <PropertyColumn Property="x => x.Lot" Title="웨이퍼 Lot" />
                <PropertyColumn Property="x => x.Number" Title="Chip No." />
                <PropertyColumn Property="x => x.Pressure" Title="Pressure (mbar)" />
                <PropertyColumn Property="x => x.passFail" Context="x" Title="합/불" CellStyleFunc="@_cellStyleFunc2"
                                HeaderStyle="width: 120px; min-width: 120px; max-width: 120px;"
                                CellStyle="width: 120px; min-width: 120px; max-width: 120px;">
                    <EditTemplate>
                        <MudSelect T="string" Value="x.Item.passFail" Margin="@Margin.Dense"
                                   ValueChanged="@(async val => { x.Item.passFail = val; await CommittedItemChanges(x.Item); })">
                            <MudSelectItem Value=@("PASS")>PASS</MudSelectItem>
                            <MudSelectItem Value=@("FAIL")>FAIL</MudSelectItem>
                        </MudSelect>
                    </EditTemplate>
                </PropertyColumn>
                <PropertyColumn Property="x => x.Note" Title="Note" Required="false"/>
                <TemplateColumn Context="x" Editable="false">
                    <CellTemplate>
                        <MudIconButton Size="@Size.Small" Variant="Variant.Filled" Icon="@Icons.Material.Filled.Delete"
                                       Color="@Color.Error" OnClick="@(() => DeletePressureData(x.Item))" />
                    </CellTemplate>
                </TemplateColumn>
            </Columns>
            <PagerContent>
                <MudDataGridPager PageSizeOptions="@(new[] { 25, 50, 100 })" />
            </PagerContent>
        </MudDataGrid>
    </MudTabPanel>
</MudTabs>

<MudScrollToTop>
    <MudFab Color="Color.Info" StartIcon="@Icons.Material.Filled.ArrowCircleUp" />
</MudScrollToTop>
