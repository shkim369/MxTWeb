@page "/chipusages"
@rendermode InteractiveServer
@using Microsoft.EntityFrameworkCore
@using MxTWeb.Models
@using MxTWeb.Data
@using MxTWeb.Enums
@using Microsoft.AspNetCore.Authorization
@using ClosedXML.Excel;
@using System.Globalization;
@attribute [Authorize]
@implements IAsyncDisposable
@inject IDbContextFactory<MxTWeb.Data.MxTWebContext> DbFactory
@inject IDialogService DialogService
@inject ISnackbar Snackbar
@inject IJSRuntime JS

<PageTitle>칩 사용 관리대장</PageTitle>

<style>
    .custom-grid .mud-table-cell .column-header .column-options .mud-menu .mud-icon-button-label {
        display: none !important;
		visibility: hidden !important;
    }
    .custom-grid .mud-table-cell .column-header .column-options .mud-menu {
        display: none !important;
        visibility: hidden !important;
        width: 0px !important;
    }
    .custom-grid .mud-table-cell
    {
        padding-right: 15px !important;
    }
</style>

<h2>RUO 칩 사용 관리대장</h2>
<br />

<MudTabs Elevation="2" Rounded="true" ApplyEffectsToContainer="true" ActivePanelIndexChanged="OnTabChanged">
    <MudTabPanel Text="RUO 칩 사용 관리대장" OnClick="@(StateHasChanged)">
        <MudGrid Spacing="5" Style="margin-top: 0px; margin-bottom: 10px">
            <MudSpacer />
            <MudSpacer />
            <MudMenu Label="@SearchField" Variant="Variant.Filled" EndIcon="@Icons.Material.Filled.KeyboardArrowDown" IconColor="Color.Secondary">
                <MudMenuItem Label="날짜" @onclick="@(() => SelectSearchField("날짜"))" />
                <MudMenuItem Label="웨이퍼 정보" @onclick="@(() => SelectSearchField("웨이퍼 정보"))" />
                <MudMenuItem Label="납품일시" @onclick="@(() => SelectSearchField("납품일시"))" />
                <MudMenuItem Label="사용부서" @onclick="@(() => SelectSearchField("사용부서"))" />
            </MudMenu>
            &nbsp&nbsp&nbsp&nbsp
            <MudTextField @bind-Value="SearchFilter" Placeholder="Search" Adornment="Adornment.Start" Immediate="true"
                          AdornmentIcon="@Icons.Material.Filled.Search" IconSize="Size.Medium" Class="mt-0"></MudTextField>
        </MudGrid>
        <MudDataGrid T="ChipUsage" Class="custom-grid" @ref="dataGrid" Items="FilteredData.AsQueryable()" SortMode="SortMode.Single"
                     Dense="true" Style="white-space: nowrap" Hover="true" Bordered="true" Striped="true" SelectOnRowClick="false"
                     MultiSelection="true" SelectedItems="@selectedItems" SelectedItemsChanged="@(_ => StateHasChanged())">
            <ToolBarContent>
                <MudText Typo="Typo.h6">Chip 종류</MudText>
                &nbsp&nbsp&nbsp&nbsp&nbsp&nbsp
                <MudMenu Label="@SelectedChip" Variant="Variant.Outlined" EndIcon="@Icons.Material.Filled.KeyboardArrowDown" IconColor="Color.Default">
                    <MudMenuItem Label="A01_Small chip" @onclick="@(() => SelectChip("A01_Small"))" />
                    <MudMenuItem Label="A01_Large chip" @onclick="@(() => SelectChip("A01_Large"))" />
                    <MudMenuItem Label="B01_Small chip" @onclick="@(() => SelectChip("B01_Small"))" />
                    <MudMenuItem Label="B01_Large chip" @onclick="@(() => SelectChip("B01_Large"))" />
                </MudMenu>

                <MudSpacer />

                <MudGrid Spacing="5">
                    <MudSpacer />

                    <MudItem>
                        <MudButton Class="me-2" @onclick="CreateNew" Variant="Variant.Filled" Color="Color.Primary" StartIcon="@Icons.Material.Filled.Add">
                            Add New
                        </MudButton>
                    </MudItem>

                    <MudItem>
                        <MudButton Class="me-2" Variant="Variant.Filled" StartIcon="@Icons.Material.Filled.Delete"
                                   Color="@Color.Error" Disabled="@IsDeleteDisabled" OnClick="@DeleteData"> Delete </MudButton>
                    </MudItem>

                    <MudItem>
                        <MudFileUpload Class="me-2" T="IBrowserFile" Accept=".xlsx, .csv" @ref="excelUpload" FilesChanged="UploadFile">
                            <ActivatorContent>
                                <MudButton Disabled="@importing" Variant="Variant.Filled" Color="Color.Success" StartIcon="@Icons.Custom.FileFormats.FileExcel">
                                    @if (importing)
                                    {
                                        <MudProgressCircular Indeterminate="true" Color="Color.Info" Size="Size.Small" Class="me-2" />
                                        <MudText Class="ms-2">Processing...</MudText>
                                    }
                                    else
                                    {
                                        <MudText>Import</MudText>
                                    }
                                </MudButton>
                            </ActivatorContent>
                        </MudFileUpload>
                    </MudItem>

                    <MudItem>
                        <MudButton Disabled="@exporting" @onclick="ExportToExcel" Variant="Variant.Filled" Color="Color.Info" StartIcon="@Icons.Custom.FileFormats.FileExcel">
                            @if (exporting)
                            {
                                <MudProgressCircular Indeterminate="true" Color="Color.Info" Size="Size.Small" Class="me-2" />
                                <MudText Class="ms-2">Processing...</MudText>
                            }
                            else
                            {
                                <MudText>Export</MudText>
                            }
                        </MudButton>
                    </MudItem>
                </MudGrid>
            </ToolBarContent>

            <Columns>
                <HierarchyColumn T="ChipUsage" ButtonDisabledFunc="@(x => x.Division != "제작")" />
                <SelectColumn T="ChipUsage" />
                <PropertyColumn Property="x => x.Division" Title="구분" sortable="true"
                                CellStyleFunc="@_cellStyleFunc" Editable="true">
                </PropertyColumn>
                <PropertyColumn Property="x => x.UseDate" Title="날짜" sortable="true" Format="yyyy-MM-dd"
                                SortBy="x => x.UseDate" InitialDirection="SortDirection.Descending" />
                <PropertyColumn Property="x => x.Producer" Title="작업자" Sortable="true" />
                <PropertyColumn Property="x => x.Wafer" Title="웨이퍼" sortable="true" />
                <PropertyColumn Property="x => x.WaferInfo" Title="웨이퍼 정보" />
                <PropertyColumn Property="x => x.ReceiptDate" Title="납품일시" sortable="true" Format="yyyy-MM-dd" />
                <PropertyColumn Property="x => x.Operator" Title="사용부서" sortable="true" />
                <PropertyColumn Property="x => x.Available" Title="수량" sortable="false" />
                <PropertyColumn Property="x => x.Production" Title="생산" sortable="false" />
                <PropertyColumn Property="x => x.Left" Title="잔여" sortable="false" />
                <PropertyColumn Property="x => x.Lot" Title="Lot" sortable="false" />
                <PropertyColumn Property="x => x.Note" Title="비고" sortable="false" />

                <TemplateColumn Context="x" StickyRight="true">
                    <CellTemplate>
                        <MudIconButton Size="@Size.Small" Variant="Variant.Filled" Icon="@Icons.Material.Filled.Edit"
                                       Color="@Color.Info" OnClick="@(() => this.UpdateData(x))" />
                    </CellTemplate>
                </TemplateColumn>
            </Columns>
            <ChildRowContent>
                @if (pressureLoading)
                {
                    <MudProgressCircular Indeterminate="true" Color="Color.Info" Size="Size.Large"/>
                }
                else
                {   
                    <MudDataGrid T="ChipPressure" Class="custom-grid" SortMode="SortMode.Single"
                                 Dense="true" Style="white-space: nowrap" Hover="true" Bordered="true" Striped="true" RowsPerPage="100"
                                 EditMode="DataGridEditMode.Cell" ReadOnly="false"
                                 CommittedItemChanges="@CommittedItemChanges" Items="@GetCachedChipPressureData($"{context.Item.Id}", context.Item)">
                        <Columns>
                            <PropertyColumn Property="x => x.ProduceDate" Title="제작 날짜" Editable="false" Format="yyyy-MM-dd" />
                            <TemplateColumn Title="테스트 날짜" Context="x" SortBy="@(x => x.TestDate)">
                                <EditTemplate>
                                    <MudDatePicker @bind-Date="x.Item.TestDate" DateFormat="yyyy-MM-dd" PickerClosed="@(() => CommittedItemChanges(x.Item))" />
                                </EditTemplate>
                            </TemplateColumn>
                            <PropertyColumn Property="x => x.WaferInfo" Title="웨이퍼 패턴" Editable="false"/>
                            <PropertyColumn Property="x => x.Number" Title="Origin No." />
                            <PropertyColumn Property="x => x.TestNum" Title="Test No." />
                            <PropertyColumn Property="x => x.Pressure" Title="Pressure (mbar)"/>
                            <PropertyColumn Property="x => x.passFail" Context="x" Title="합/불" CellStyleFunc="@_cellStyleFunc2"
                                            HeaderStyle="width: 120px; min-width: 120px; max-width: 120px;"
                                            CellStyle="width: 120px; min-width: 120px; max-width: 120px;">
                                <EditTemplate>
                                    <MudSelect T="string" Value="x.Item.passFail" Margin="@Margin.Dense"
                                               ValueChanged="@(val => { x.Item.passFail = val; CommittedItemChanges(x.Item); })" >
                                        <MudSelectItem Value=@("PASS")>PASS</MudSelectItem>
                                        <MudSelectItem Value=@("FAIL")>FAIL</MudSelectItem>
                                    </MudSelect>
                                </EditTemplate>
                            </PropertyColumn>
                            <PropertyColumn Property="x => x.Note" Title="Note" Required="false"/>
                            <TemplateColumn Context="x" Editable="false">
                                <CellTemplate>
                                    <MudIconButton Size="@Size.Small" Variant="Variant.Filled" Icon="@Icons.Material.Filled.Delete"
                                                   Color="@Color.Error" OnClick="@(async () => { await DeletePressureData(x.Item); UpdateChipPressureData($"{context.Item.Id}", context.Item); })" />
                                </CellTemplate>
                            </TemplateColumn>
                        </Columns>
                    </MudDataGrid>
                    <div class="d-flex justify-end pa-2 me-2">
                        <MudButton OnClick="@(() => AddPressureData(context.Item))" Variant="Variant.Filled" Color="@Color.Success" StartIcon="@Icons.Material.Filled.Add"
                                   Class="add-item-btn">Add Item</MudButton>
                    </div>
                }
            </ChildRowContent>

            <PagerContent>
                <MudDataGridPager />
            </PagerContent>
        </MudDataGrid>
    </MudTabPanel>

    <MudTabPanel Text="RUO Chip Pressure">
        <MudGrid Spacing="5" Style="margin-top: 0px; margin-bottom: 10px">
            <MudSpacer />
            <MudSpacer />
            <MudMenu Label="@PresSearchField" Variant="Variant.Filled" EndIcon="@Icons.Material.Filled.KeyboardArrowDown" IconColor="Color.Secondary">
                <MudMenuItem Label="제작 날짜" @onclick="@(() => SelectPresSearchField("제작 날짜"))" />
                <MudMenuItem Label="테스트 날짜" @onclick="@(() => SelectPresSearchField("테스트 날짜"))" />
                <MudMenuItem Label="웨이퍼 패턴" @onclick="@(() => SelectPresSearchField("웨이퍼 패턴"))" />
            </MudMenu>
            &nbsp&nbsp&nbsp&nbsp
            <MudTextField @bind-Value="_presSearchFilter" Placeholder="Search" Adornment="Adornment.Start" Immediate="true"
                          AdornmentIcon="@Icons.Material.Filled.Search" IconSize="Size.Medium" Class="mt-0"></MudTextField>
        </MudGrid>

        @if (pressureLoading)
        {
            <MudProgressCircular Indeterminate="true" Color="Color.Info" Size="Size.Large"/>
        }
        else
        {           
            <MudDataGrid T="ChipPressure" Class="custom-grid" Items="@FilteredPresData" SortMode="SortMode.Single"
                         Dense="true" Style="white-space: nowrap" Hover="true" Bordered="true" Striped="true" RowsPerPage="100"
					     EditMode="DataGridEditMode.Cell" ReadOnly="false"                   
                         CommittedItemChanges="@CommittedItemChanges"
                         QuickFilter="@_quickFilter">
                <Columns>
                    <PropertyColumn Property="x => x.ProduceDate" Title="제작 날짜" Editable="false" Format="yyyy-MM-dd" />
                    <TemplateColumn Title="테스트 날짜" Context="x" Sortable="true" InitialDirection="SortDirection.Descending" SortBy="@(x => x.TestDate)">
                        <EditTemplate>
                            <MudDatePicker @bind-Date="x.Item.TestDate" DateFormat="yyyy-MM-dd" PickerClosed="@(() => CommittedItemChanges(x.Item))"/>
                        </EditTemplate>
                    </TemplateColumn>
                    <PropertyColumn Property="x => x.WaferInfo" Title="웨이퍼 패턴" Editable="false"/>
                    <PropertyColumn Property="x => x.Number" Title="Origin No." />
                    <PropertyColumn Property="x => x.TestNum" Title="Test No." />
                    <PropertyColumn Property="x => x.Pressure" Title="Pressure (mbar)" />
                    <PropertyColumn Property="x => x.passFail" Context="x" Title="합/불" CellStyleFunc="@_cellStyleFunc2"
                                    HeaderStyle="width: 120px; min-width: 120px; max-width: 120px;"
                                    CellStyle="width: 120px; min-width: 120px; max-width: 120px;">
                        <EditTemplate>
                            <MudSelect T="string" Value="x.Item.passFail" Margin="@Margin.Dense"
                                       ValueChanged="@(val => { x.Item.passFail = val; CommittedItemChanges(x.Item); })">
                                <MudSelectItem Value=@("PASS")>PASS</MudSelectItem>
                                <MudSelectItem Value=@("FAIL")>FAIL</MudSelectItem>
                            </MudSelect>
                        </EditTemplate>
                    </PropertyColumn>
                    <PropertyColumn Property="x => x.Note" Title="Note" Required="false"/>
                    <TemplateColumn Context="x" Editable="false">
                        <CellTemplate>
                            <MudIconButton Size="@Size.Small" Variant="Variant.Filled" Icon="@Icons.Material.Filled.Delete"
                                           Color="@Color.Error" OnClick="@(() => this.DeletePressureData(x.Item))" />
                        </CellTemplate>
                    </TemplateColumn>
                </Columns>
            </MudDataGrid>
            <div class="d-flex justify-end pa-2 me-2">
                <MudButton OnClick="@(() => AddPressureData())" Variant="Variant.Filled" Color="@Color.Success" StartIcon="@Icons.Material.Filled.Add"
                           Class="add-item-btn">Add Item</MudButton>
            </div>
        }
    </MudTabPanel>
</MudTabs>

@code {
    private MxTWebContext context = default!;
    private MudDataGrid<ChipUsage> dataGrid;
    private MudFileUpload<IBrowserFile> excelUpload;

    private readonly SemaphoreSlim _searchSemaphore = new(1, 1);
    private readonly SemaphoreSlim _deleteSemaphore = new(1, 1);
    private CancellationTokenSource? _searchCts;
    private List<ChipUsage> _filteredResults = new();
    private HashSet<ChipUsage> selectedItems = new();
    private bool IsDeleteDisabled => selectedItems.Count == 0;

    private IEnumerable<ChipUsage> FilteredData => _filteredResults;
    private IEnumerable<ChipPressure> FilteredPresData = new List<ChipPressure>();
    private Dictionary<string, IEnumerable<ChipPressure>> chipPressureCache = new();

    private string _selectedChip = "";
    public string SelectedChip
    {
        get => _selectedChip;
        set
        {
            _selectedChip = value;
            _ = PerformSelectChipAsync();
        }
    }

    private string SearchField = "";
    private string PresSearchField = "";

    private string _searchFilter = "";
    public string SearchFilter
    {
        get => _searchFilter;
        set
        {
            _searchFilter = value;
            _ = PerformSearchAsync();
        }
    }
    private string _presSearchFilter;

    bool importing = false;
    bool exporting = false;
    bool pressureLoading = false;

    private async Task SelectChip(string Type)
    {
        SelectedChip = Type;
    }

    private async Task PerformSelectChipAsync()
    {
        try
        {
            using var context = DbFactory.CreateDbContext();

            var query = SelectedChip switch
            {
                "A01_Small" => context.ChipUsage.Where(m => m.Chip!.Equals("A01_Small")),
                "A01_Large" => context.ChipUsage.Where(m => m.Chip!.Equals("A01_Large")),
                "B01_Small" => context.ChipUsage.Where(m => m.Chip!.Equals("B01_Small")),
                "B01_Large" => context.ChipUsage.Where(m => m.Chip!.Equals("B01_Large")),
                _ => context.ChipUsage.Where(m => m.Chip!.Equals("A01_Small")),
            };

            _filteredResults = await query.ToListAsync();
            await InvokeAsync(StateHasChanged);
        }
        catch (OperationCanceledException) { }
    }

    private async Task PerformSearchAsync()
    {
        // 동시 실행 방지 // available semaphore가 없으면 바로 return
        if (!await _searchSemaphore.WaitAsync(0)) return;

        try
        {
            _searchCts?.Cancel();
            _searchCts = new CancellationTokenSource();

            using var context = DbFactory.CreateDbContext();

            var query = SearchField switch
            {
                "날짜" => context.ChipUsage.Where(m => m.UseDate.ToString()!.Contains(SearchFilter) && m.Chip!.Equals(SelectedChip)),
                "웨이퍼 정보" => context.ChipUsage.Where(m => m.WaferInfo!.Contains(SearchFilter) && m.Chip!.Equals(SelectedChip)),
                "납품일시" => context.ChipUsage.Where(m => m.ReceiptDate.ToString()!.Contains(SearchFilter) && m.Chip!.Equals(SelectedChip)),
                "사용부서" => context.ChipUsage.Where(m => m.Operator!.Contains(SearchFilter) && m.Chip!.Equals(SelectedChip)),
                _ => context.ChipUsage.Where(m => m.Chip!.Equals(SelectedChip))
            };

            _filteredResults = await query.ToListAsync(_searchCts.Token);
            await InvokeAsync(StateHasChanged);
        }
        catch (OperationCanceledException) { }
        finally
        {
            _searchSemaphore.Release();
        }
    }

    private Func<ChipPressure, bool> _quickFilter => x =>
    {
        if (string.IsNullOrWhiteSpace(_presSearchFilter))
            return true;

        else {
            switch (PresSearchField)
            {
                case "테스트 날짜":
                    if (x.TestDate.GetValueOrDefault().ToString("yyyy-MM-dd").Contains(_presSearchFilter, StringComparison.OrdinalIgnoreCase))
                        return true;
                    break;

                case "제작 날짜":
                    if (x.ProduceDate.GetValueOrDefault().ToString("yyyy-MM-dd").Contains(_presSearchFilter, StringComparison.OrdinalIgnoreCase))
                        return true;
                    break;

				case "웨이퍼 패턴":
                    if (x.WaferInfo.Contains(_presSearchFilter, StringComparison.OrdinalIgnoreCase))
                        return true;
                    break;

                default:
					break;
            }

        }

        return false;
    };

    private async Task CreateNew()
    {
        var parameters = new DialogParameters<Edit>
        {
            { x => x.action, UIActionEnum.Insert }
        };

        var options = new DialogOptions { MaxWidth = MaxWidth.Large };
        var dialog = await DialogService.ShowAsync<Edit>("Add New Chip", parameters, options);
        var result = await dialog.Result;

        if (result is not null && !result.Canceled)
        {
            await PerformSearchAsync();
        }
    }

    private async Task UpdateData(CellContext<ChipUsage> data)
    {
        var parameters = new DialogParameters<Edit>
        {
            { x => x.action, UIActionEnum.Update },
            { x => x.ChipUsage, data.Item } // 선택된 row의 데이터를 직접 전달
        };

        var options = new DialogOptions { MaxWidth = MaxWidth.Large };
        var dialog = await DialogService.ShowAsync<Edit>("Edit Chip", parameters, options);
        var result = await dialog.Result;

        if (result is not null && !result.Canceled)
        {
            await PerformSearchAsync();
        }
    }

    private async Task DeleteData()
    {
        var parameters = new DialogParameters<Delete>
        {
            { x => x.chipUsage, selectedItems.ToList() } // 선택된 row의 데이터를 직접 전달
        };

        var options = new DialogOptions { MaxWidth = MaxWidth.Large };
        var dialog = await DialogService.ShowAsync<Delete>("Delete Data", parameters, options);
        var result = await dialog.Result;

        if (result is not null && !result.Canceled)
        {
            await PerformSearchAsync();
            selectedItems.Clear();
        }
    }

    private IEnumerable<ChipPressure> GetCachedChipPressureData(string cacheKey, ChipUsage chipUsage)
    {
        pressureLoading = true;
        if (!chipPressureCache.ContainsKey(cacheKey))
        {
            chipPressureCache[cacheKey] = GetChipPressureData(chipUsage);
        }
        pressureLoading = false;
        return chipPressureCache[cacheKey];
    }

    private void UpdateChipPressureData(string cacheKey, ChipUsage chipUsage)
    {
        chipPressureCache[cacheKey] = GetChipPressureData(chipUsage);
    }

    private IEnumerable<ChipPressure> GetChipPressureData(ChipUsage chipUsage)
    {
        if (string.IsNullOrEmpty(chipUsage.WaferInfo))
        {
            Snackbar.Add("WaferInfo 값이 비어 있습니다. 데이터를 확인하세요.", Severity.Warning);
            return Enumerable.Empty<ChipPressure>();
        }

        string[] waferPattern = chipUsage.WaferInfo.Split("_");

        using var context = DbFactory.CreateDbContext();
        return context.ChipPressure
            .Where(cp => cp.ProduceDate == chipUsage.UseDate && cp.WaferInfo == waferPattern[0])
            .ToList();
    }

    private async Task AddPressureData(ChipUsage chipUsage)
    {
        if (string.IsNullOrEmpty(chipUsage.WaferInfo))
        {
            Snackbar.Add("WaferInfo 값이 비어 있습니다. 데이터를 확인하세요.", Severity.Warning);
            return;
        }

        string[] waferPattern = chipUsage.WaferInfo.Split("_");

        using var context = DbFactory.CreateDbContext();

        ChipPressure temp = context.ChipPressure
            .Where(cp => cp.ProduceDate == chipUsage.UseDate && cp.WaferInfo == waferPattern[0])
            .OrderByDescending(cp => cp.Id)
            .FirstOrDefault()!;

        var newPressure = new ChipPressure();
        if (temp == null)
        {
            newPressure = new ChipPressure
            {
                ProduceDate = chipUsage.UseDate,
                TestDate = chipUsage.UseDate,
                WaferInfo = waferPattern[0],
                Number = 1,
				TestNum = 100,
				passFail = "PASS"
            };
        }
        else
        {
            newPressure = new ChipPressure
            {
                ProduceDate = chipUsage.UseDate,
                TestDate = temp.TestDate,
                WaferInfo = temp.WaferInfo,
                Number = 1,
                TestNum = temp.TestNum + 1,
				passFail = "PASS"
            };
        }

        context.ChipPressure.Add(newPressure);
        await context.SaveChangesAsync();

        chipPressureCache[chipUsage.Id.ToString()] = GetChipPressureData(chipUsage);
    }

    private async Task AddPressureData()
    {
        using var context = DbFactory.CreateDbContext();
        var newPressure = new ChipPressure
        {
			ProduceDate = DateTime.Today,
            TestDate = DateTime.Today,
            WaferInfo = "-",
            Number = 1,
            TestNum = 100,
            passFail = "PASS"
        };
        context.ChipPressure.Add(newPressure);
        await context.SaveChangesAsync();

        FilteredPresData = context.ChipPressure.ToList();
    }

    private async Task DeletePressureData(ChipPressure data)
    {
        using var context = DbFactory.CreateDbContext();
        using var transaction = await context.Database.BeginTransactionAsync();
        try
        {
            context.ChipPressure.Remove(data!);
            await context.SaveChangesAsync();
            await transaction.CommitAsync();

            FilteredPresData = context.ChipPressure.ToList();
        }
        catch
        {
            await transaction.RollbackAsync();
            throw;
        }
    }

    private async Task UploadFile(IBrowserFile file)
    {
        if (file is null) return;
        importing = true;

        try
        {
            using var stream = new MemoryStream();
            await file.OpenReadStream().CopyToAsync(stream);

            stream.Position = 0;

            using var workbook = new XLWorkbook(stream);
            var worksheet = workbook.Worksheets.First();

            var rows = worksheet.RowsUsed().Skip(1);

            List<ChipUsage> chipUsages = new();
            foreach (var row in rows)
            {
                try 
                {
                    ChipUsage chip = new ChipUsage
                    {
                        Chip = worksheet.Name,
                        Division = row.Cell(2).Value.ToString(),
                        UseDate = ParseDateTime(row.Cell(3)),
                        Producer = row.Cell(4).Value.ToString(),
                        Wafer = row.Cell(5).Value.ToString(),
                        WaferInfo = row.Cell(6).Value.ToString(),
                        ReceiptDate = ParseDateTime(row.Cell(7)),
                        Operator = row.Cell(8).Value.ToString(),
                        Available = int.Parse(row.Cell(9).Value.ToString()),
                        Production = int.Parse(row.Cell(10).Value.ToString()),
                        Left = int.Parse(row.Cell(11).Value.ToString()),
                        Lot = row.Cell(12).Value.ToString(),
                        Note = row.Cell(13).Value.ToString()
                    };
                    chipUsages.Add(chip);
                }
                catch (Exception ex)
                {
                    continue;
                }
            }

            var parameters = new DialogParameters<Import>
            {
                { x => x.chipUsages, chipUsages}
            };

            var options = new DialogOptions { MaxWidth = MaxWidth.ExtraLarge };

            var dialog = await DialogService.ShowAsync<Import>($"Ready to Import {chipUsages.Count()} Items", parameters, options);
            var result = await dialog.Result;

            if (result != null && !result.Canceled)
            {
                await PerformSearchAsync();
            }

        }
        catch (Exception ex)
        {
            Snackbar.Add($"파일 업로드 중 오류가 발생했습니다: {ex.Message}", Severity.Error);
        }
        finally
        {
            await excelUpload.ClearAsync();
            importing = false;
        }
    }

    static DateTime ParseDateTime(IXLCell cell)
    {
        try
        {
            if (cell.DataType == XLDataType.DateTime)
            {
                return cell.GetDateTime();
            }

            string dateString = cell.GetString();

            if (dateString.Contains('.'))
            {
                dateString = dateString.Replace('.', '-');
            }

            if (DateTime.TryParse(dateString, out DateTime result))
            {
                return result;
            }

            string originalString = cell.GetString();         
            throw new FormatException($"Cannot parse date: {originalString}");
        }
        catch (Exception ex)
        {
            throw new FormatException($"Error parsing date from cell: {ex.Message}");
        }
    }

    private async Task ExportToExcel()
    {
        var excelBytes = await ExportData();

        await JS.InvokeVoidAsync("downloadFileFromBytes", "ChipUsages.xlsx", excelBytes);
    }

    private async Task<Byte[]> ExportData()
    {
        exporting = true; // Set exporting to true at the beginning of the method
        try
        {
            var datas = _filteredResults;

            using (var workbook = new XLWorkbook())
            {
                var worksheet = workbook.Worksheets.Add("ChipUsage");

                worksheet.Cell(1, 1).Value = "ID";
                worksheet.Cell(1, 2).Value = "Chip";
                worksheet.Cell(1, 3).Value = "구분";
                worksheet.Cell(1, 4).Value = "날짜";
                worksheet.Cell(1, 5).Value = "작업자";
                worksheet.Cell(1, 6).Value = "Wafer";
                worksheet.Cell(1, 7).Value = "Wager 구분";
                worksheet.Cell(1, 8).Value = "납품일시";
                worksheet.Cell(1, 9).Value = "사용부서";
                worksheet.Cell(1, 10).Value = "사용가능 칩";
                worksheet.Cell(1, 11).Value = "생산한 칩";
                worksheet.Cell(1, 12).Value = "잔여 칩";
                worksheet.Cell(1, 13).Value = "Lot";
                worksheet.Cell(1, 14).Value = "비고";

                for (int i = 0; i < datas.Count; i++)
                {
                    var data = datas[i];
                    worksheet.Cell(i + 2, 1).Value = i + 1;
                    worksheet.Cell(i + 2, 2).Value = data.Chip;
                    worksheet.Cell(i + 2, 3).Value = data.Division;
                    worksheet.Cell(i + 2, 4).Value = data.UseDate?.ToString("yyyy-MM-dd");
                    worksheet.Cell(i + 2, 5).Value = data.Producer;
                    worksheet.Cell(i + 2, 6).Value = data.Wafer;
                    worksheet.Cell(i + 2, 7).Value = data.WaferInfo;
                    worksheet.Cell(i + 2, 8).Value = data.ReceiptDate?.ToString("yyyy-MM-dd");
                    worksheet.Cell(i + 2, 9).Value = data.Operator;
                    worksheet.Cell(i + 2, 10).Value = data.Available;
                    worksheet.Cell(i + 2, 11).Value = data.Production;
                    worksheet.Cell(i + 2, 12).Value = data.Left;
                    worksheet.Cell(i + 2, 13).Value = data.Lot;
                    worksheet.Cell(i + 2, 14).Value = data.Note;
                }

                using (var stream = new MemoryStream())
                {
                    workbook.SaveAs(stream);
                    return stream.ToArray();
                }
            }
        }
        catch (Exception ex)
        {
            Snackbar.Add($"데이터 내보내기 중 오류가 발생했습니다: {ex.Message}", Severity.Error);
            return Array.Empty<byte>();
        }
        finally
        {
            exporting = false;
        }
    }

    private void SelectSearchField(string item)
    {
        SearchField = item;
    }
    private void SelectPresSearchField(string item)
    {
        PresSearchField = item;
    }

    protected override void OnInitialized()
    {
        context = DbFactory.CreateDbContext();
        _filteredResults = context.ChipUsage.ToList();
        FilteredPresData = context.ChipPressure.ToList();

        SearchField = "날짜";
        PresSearchField = "테스트 날짜";
        SelectedChip = "A01_Small";
    }

    private void OnTabChanged(int index)
    {
        if (index == 0) // 첫 번째 탭이 선택된 경우
        {
            _filteredResults = _filteredResults.OrderByDescending(chip => chip.UseDate).ToList();
            StateHasChanged(); // UI 업데이트
        }
        if (index == 1) // 첫 번째 탭이 선택된 경우
        {
            context = DbFactory.CreateDbContext();
            FilteredPresData = context.ChipPressure.OrderByDescending(chip => chip.TestDate).ToList();
        }
    }

    private async Task CommittedItemChanges(ChipPressure item)
    {
        using var context = DbFactory.CreateDbContext();
        context.Attach(item!).State = EntityState.Modified;
        await context.SaveChangesAsync();
    }

    private Func<ChipUsage, string> _cellStyleFunc => x =>
    {
        string style = "";

        if (x.Division == "납품")
            style += "background-color:#F9CB9C";
        else if (x.Division == "제작")
            style += "background-color:#D9EAD3";
        else if (x.Division == "소진")
            style += "background-color:#f8766b";

        return style;
    };
    private Func<ChipPressure, string> _cellStyleFunc2 => x =>
    {
        string style = "";
        if (x.passFail == "FAIL")
            style += "background-color:#f8766b";
        return style;
    };

