                    <MudMenuItem Label="B01_Small chip" @onclick="@(() => SelectChip("B01_Small"))" />
                    <MudMenuItem Label="B01_Large chip" @onclick="@(() => SelectChip("B01_Large"))" />
                    <MudMenuItem Label="A01_Small chip" @onclick="@(() => SelectChip("A01_Small"))" />
                    <MudMenuItem Label="A01_Large chip" @onclick="@(() => SelectChip("A01_Large"))" />
                </MudMenu>
                &nbsp&nbsp&nbsp&nbsp&nbsp&nbsp&nbsp&nbsp&nbsp&nbsp&nbsp
                <MudGrid Spacing="3">
                    <MudItem>
