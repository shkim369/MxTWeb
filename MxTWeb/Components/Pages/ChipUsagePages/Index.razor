@code {
    private MudDataGrid<ChipUsage> dataGrid = null!;
    private MudDataGrid<ChipPressure> pressureGrid = null!;
    private MudFileUpload<IBrowserFile> excelUpload = null!;

    private ChipUsage selectedItem = new();
    private bool IsEditDisabled => selectedItem == null || selectedItem.Id == 0;

    private int _totalCount;
    // 현재 페이지에 보이는 웨이퍼별 '가장 최근 사용일' (잔여 칸 강조용). 페이지 로드 시 한 번의 집계 쿼리로 계산.
    private Dictionary<string, DateTime> _latestUseDateByWafer = new(StringComparer.OrdinalIgnoreCase);

    private string SelectedChip = "B01_Small";
    private string SearchField = "웨이퍼 정보";
    private string PresSearchField = "웨이퍼 정보";
    private string SearchFilter = "";
    private string _presSearchFilter = "";

    bool importing = false;
    bool exporting = false;

    // ───────────────────────── 칩 사용 대장 (서버 페이징) ─────────────────────────

    /// <summary>선택된 칩 + 검색 조건을 SQL WHERE 로 적용한 쿼리</summary>
    private IQueryable<ChipUsage> BuildChipUsageQuery(MxTWebContext db)
    {
        var q = db.ChipUsage.AsNoTracking().Where(x => x.Chip == SelectedChip);
        var term = SearchFilter?.Trim();
        if (string.IsNullOrEmpty(term)) return q;

        switch (SearchField)
        {
            case "웨이퍼 정보": return q.Where(x => x.WaferInfo!.Contains(term));
            case "사용부서": return q.Where(x => x.Operator!.Contains(term));
            case "날짜":
            case "납품일시":
                // 예전: UseDate.ToString().Contains(...) → 컬럼에 함수가 씌워져 인덱스를 못 탐(Non-SARGable)
                // 지금: 입력값을 기간으로 해석해 범위 조건으로 검색
                if (!TryParseDateRange(term, out var from, out var to)) return q.Where(x => false);
                return SearchField == "날짜"
                    ? q.Where(x => x.UseDate >= from && x.UseDate < to)
                    : q.Where(x => x.ReceiptDate >= from && x.ReceiptDate < to);
            default: return q;
        }
    }

    private async Task<GridData<ChipUsage>> LoadChipUsagesAsync(GridState<ChipUsage> state, CancellationToken ct)
    {
        await using var db = await DbFactory.CreateDbContextAsync(ct);
        var query = BuildChipUsageQuery(db);

        var total = await query.CountAsync(ct);
        var items = await ApplyChipSort(query, state)
            .Skip(state.Page * state.PageSize)
            .Take(state.PageSize)
            .ToListAsync(ct);

        // 잔여 칸 강조: 이 페이지에 나온 웨이퍼들의 최근 사용일만 집계 (예전엔 셀마다 전체 목록을 순회 → O(N²))
        var wafers = items.Select(x => x.WaferInfo).Where(w => !string.IsNullOrWhiteSpace(w)).Distinct().ToList();
        var latest = wafers.Count == 0
            ? new()
            : await query.Where(x => wafers.Contains(x.WaferInfo) && x.UseDate != null)
                         .GroupBy(x => x.WaferInfo!)
                         .Select(g => new { Wafer = g.Key, Max = g.Max(x => x.UseDate)!.Value })
                         .ToListAsync(ct);
        _latestUseDateByWafer = latest.ToDictionary(x => x.Wafer, x => x.Max, StringComparer.OrdinalIgnoreCase);

        _totalCount = total;
        return new GridData<ChipUsage> { Items = items, TotalItems = total };
    }

    private static IQueryable<ChipUsage> ApplyChipSort(IQueryable<ChipUsage> q, GridState<ChipUsage> state)
    {
        var sort = state.SortDefinitions.FirstOrDefault();
        if (sort is null) return q.OrderByDescending(x => x.UseDate).ThenByDescending(x => x.Id);

        IOrderedQueryable<ChipUsage> ordered = sort.SortBy switch
        {
            nameof(ChipUsage.Division) => sort.Descending ? q.OrderByDescending(x => x.Division) : q.OrderBy(x => x.Division),
            nameof(ChipUsage.Producer) => sort.Descending ? q.OrderByDescending(x => x.Producer) : q.OrderBy(x => x.Producer),
            nameof(ChipUsage.Wafer) => sort.Descending ? q.OrderByDescending(x => x.Wafer) : q.OrderBy(x => x.Wafer),
            nameof(ChipUsage.ReceiptDate) => sort.Descending ? q.OrderByDescending(x => x.ReceiptDate) : q.OrderBy(x => x.ReceiptDate),
            nameof(ChipUsage.Operator) => sort.Descending ? q.OrderByDescending(x => x.Operator) : q.OrderBy(x => x.Operator),
            _ => sort.Descending ? q.OrderByDescending(x => x.UseDate) : q.OrderBy(x => x.UseDate),
        };
        return ordered.ThenByDescending(x => x.Id);   // 페이지 경계가 흔들리지 않도록 고유 키로 2차 정렬
    }

    /// <summary>"2026", "2026-11", "2026-11-05" (또는 '.' 구분) → [from, to)</summary>
    private static bool TryParseDateRange(string input, out DateTime from, out DateTime to)
    {
        var s = input.Replace('.', '-').Replace('/', '-');
        var c = CultureInfo.InvariantCulture;
        if (DateTime.TryParseExact(s, new[] { "yyyy-MM-dd", "yyyy-M-d" }, c, DateTimeStyles.None, out from)) { to = from.AddDays(1); return true; }
        if (DateTime.TryParseExact(s, new[] { "yyyy-MM", "yyyy-M" }, c, DateTimeStyles.None, out from)) { to = from.AddMonths(1); return true; }
        if (DateTime.TryParseExact(s, "yyyy", c, DateTimeStyles.None, out from)) { to = from.AddYears(1); return true; }
        to = default;
        return false;
    }

    private async Task SelectChip(string type)
    {
        SelectedChip = type;
        await dataGrid.ReloadServerData();
    }

    private void SelectSearchField(string item) => SearchField = item;

    private async Task OnSearchChanged(string value)
    {
        SearchFilter = value;
        await dataGrid.ReloadServerData();
    }

    private async Task ReloadAfterChangeAsync()
    {
        Dashboard.Invalidate();   // 대시보드 캐시도 즉시 갱신
        await dataGrid.ReloadServerData();
    }

    private async Task CreateNew()
    {
        var parameters = new DialogParameters<Edit>
        {
            { x => x.action, UIActionEnum.Insert },
            { x => x.chipType, SelectedChip }
        };

        var options = new DialogOptions { MaxWidth = MaxWidth.Large, BackdropClick = false, CloseOnEscapeKey = true };
        var dialog = await DialogService.ShowAsync<Edit>("Add New Chip", parameters, options);
        var result = await dialog.Result;

        if (result is not null && !result.Canceled)
            await ReloadAfterChangeAsync();
    }

    private async Task UpdateData()
    {
        var parameters = new DialogParameters<Edit>
        {
            { x => x.action, UIActionEnum.Update },
            { x => x.ChipUsage, selectedItem } // 선택된 row의 데이터를 직접 전달
        };

        var options = new DialogOptions { MaxWidth = MaxWidth.Large, BackdropClick = false, CloseOnEscapeKey = true };
        var dialog = await DialogService.ShowAsync<Edit>("Edit Chip", parameters, options);
        var result = await dialog.Result;

        if (result is not null && !result.Canceled)
            await ReloadAfterChangeAsync();
    }

    private async Task DeleteData()
    {
        var parameters = new DialogParameters<Delete>
        {
            { x => x.chipUsage, selectedItem } // 선택된 row의 데이터를 직접 전달
        };

        var options = new DialogOptions { MaxWidth = MaxWidth.Large, BackdropClick = false, CloseOnEscapeKey = true };
        var dialog = await DialogService.ShowAsync<Delete>("Delete Data", parameters, options);
        var result = await dialog.Result;

        if (result is not null && !result.Canceled)
        {
            selectedItem = new();
            await ReloadAfterChangeAsync();
        }
    }

    // ───────────────────────── 압력 탭 (서버 페이징) ─────────────────────────

    private async Task<GridData<ChipPressure>> LoadPressuresAsync(GridState<ChipPressure> state, CancellationToken ct)
    {
        await using var db = await DbFactory.CreateDbContextAsync(ct);
        IQueryable<ChipPressure> q = db.ChipPressure.AsNoTracking();

        var term = _presSearchFilter?.Trim();
        if (!string.IsNullOrEmpty(term))
        {
            q = PresSearchField switch
            {
                "웨이퍼 Lot" => q.Where(x => x.Lot!.Contains(term)),
                "테스트 날짜" => TryParseDateRange(term, out var from, out var to)
                                    ? q.Where(x => x.TestDate >= from && x.TestDate < to)
                                    : q.Where(x => false),
                _ => q.Where(x => x.WaferInfo!.Contains(term)),
            };
        }

        var total = await q.CountAsync(ct);

        var sort = state.SortDefinitions.FirstOrDefault();
        IOrderedQueryable<ChipPressure> ordered = sort?.SortBy switch
        {
            nameof(ChipPressure.WaferInfo) => sort.Descending ? q.OrderByDescending(x => x.WaferInfo) : q.OrderBy(x => x.WaferInfo),
            nameof(ChipPressure.Lot) => sort.Descending ? q.OrderByDescending(x => x.Lot) : q.OrderBy(x => x.Lot),
            nameof(ChipPressure.Number) => sort.Descending ? q.OrderByDescending(x => x.Number) : q.OrderBy(x => x.Number),
            nameof(ChipPressure.Pressure) => sort.Descending ? q.OrderByDescending(x => x.Pressure) : q.OrderBy(x => x.Pressure),
            nameof(ChipPressure.passFail) => sort.Descending ? q.OrderByDescending(x => x.passFail) : q.OrderBy(x => x.passFail),
            _ => q.OrderByDescending(x => x.TestDate),   // 기본: 테스트 날짜 최신순 (IX_ChipPressure_TestDate)
        };

        var items = await ordered.ThenByDescending(x => x.Id)
            .Skip(state.Page * state.PageSize)
            .Take(state.PageSize)
            .ToListAsync(ct);

        return new GridData<ChipPressure> { Items = items, TotalItems = total };
    }

    private void SelectPresSearchField(string item) => PresSearchField = item;

    private async Task OnPresSearchChanged(string value)
    {
        _presSearchFilter = value;
        await pressureGrid.ReloadServerData();
    }

    private async Task<DataGridEditFormAction> CommittedItemChanges(ChipPressure item)
    {
        await using var context = await DbFactory.CreateDbContextAsync();
        context.Attach(item!).State = EntityState.Modified;
        await context.SaveChangesAsync();   // 예전: await 없이 using 이 끝나 저장 전에 context 가 해제될 수 있었음
        return DataGridEditFormAction.Close;
    }

    private async Task DeletePressureData(ChipPressure data)
    {
        await using var context = await DbFactory.CreateDbContextAsync();
        context.ChipPressure.Remove(data!);
        await context.SaveChangesAsync();
        await pressureGrid.ReloadServerData();
    }

    // ───────────────────────── 엑셀 Import / Export (현재 UI 는 주석 처리됨) ─────────────────────────

    private async Task UploadFile(IBrowserFile file)
    {
        if (file is null) return;
        importing = true;

        try
        {
            using var stream = new MemoryStream();
            await file.OpenReadStream().CopyToAsync(stream);

            stream.Position = 0;

            using var workbook = new XLWorkbook(stream);
            var worksheet = workbook.Worksheets.First();

            var rows = worksheet.RowsUsed().Skip(1);

            List<ChipUsage> chipUsages = new();
            foreach (var row in rows)
            {
                try
                {
                    ChipUsage chip = new ChipUsage
                    {
                        Chip = worksheet.Name,
                        Division = row.Cell(2).Value.ToString(),
                        UseDate = ParseDateTime(row.Cell(3)),
                        Producer = row.Cell(4).Value.ToString(),
                        Wafer = row.Cell(5).Value.ToString(),
                        WaferInfo = row.Cell(6).Value.ToString(),
                        ReceiptDate = ParseDateTime(row.Cell(7)),
                        Operator = row.Cell(8).Value.ToString(),
                        Available = int.Parse(row.Cell(9).Value.ToString()),
                        Production = int.Parse(row.Cell(10).Value.ToString()),
                        Left = int.Parse(row.Cell(11).Value.ToString()),
                        Lot = row.Cell(12).Value.ToString(),
                        Note = row.Cell(13).Value.ToString()
                    };
                    chipUsages.Add(chip);
                }
                catch (Exception)
                {
                    continue;
                }
            }

            var parameters = new DialogParameters<Import>
            {
                { x => x.chipUsages, chipUsages}
            };

            var options = new DialogOptions { MaxWidth = MaxWidth.ExtraLarge, BackdropClick = false, CloseOnEscapeKey = true };

            var dialog = await DialogService.ShowAsync<Import>($"Ready to Import {chipUsages.Count()} Items", parameters, options);
            var result = await dialog.Result;

            if (result != null && !result.Canceled)
                await ReloadAfterChangeAsync();
        }
        catch (Exception ex)
        {
            Snackbar.Add($"파일 업로드 중 오류가 발생했습니다: {ex.Message}", Severity.Error);
        }
        finally
        {
            await excelUpload.ClearAsync();
            importing = false;
        }
    }

    static DateTime ParseDateTime(IXLCell cell)
    {
        try
        {
            if (cell.DataType == XLDataType.DateTime)
            {
                return cell.GetDateTime();
            }

            string dateString = cell.GetString();

            if (dateString.Contains('.'))
            {
                dateString = dateString.Replace('.', '-');
            }

            if (DateTime.TryParse(dateString, out DateTime result))
            {
                return result;
            }

            string originalString = cell.GetString();
            throw new FormatException($"Cannot parse date: {originalString}");
        }
        catch (Exception ex)
        {
            throw new FormatException($"Error parsing date from cell: {ex.Message}");
        }
    }

    private async Task ExportToExcel()
    {
        var excelBytes = await ExportData();

        await JS.InvokeVoidAsync("downloadFileFromBytes", "ChipUsages.xlsx", excelBytes);
    }

    private async Task<Byte[]> ExportData()
    {
        exporting = true; // Set exporting to true at the beginning of the method
        try
        {
            // 화면에 보이는 한 페이지가 아니라, 현재 칩/검색 조건에 맞는 전체 행을 내보낸다
            await using var db = await DbFactory.CreateDbContextAsync();
            var datas = await BuildChipUsageQuery(db).OrderByDescending(x => x.UseDate).ToListAsync();

            using (var workbook = new XLWorkbook())
            {
                var worksheet = workbook.Worksheets.Add("ChipUsage");

                worksheet.Cell(1, 1).Value = "ID";
                worksheet.Cell(1, 2).Value = "Chip";
                worksheet.Cell(1, 3).Value = "구분";
                worksheet.Cell(1, 4).Value = "날짜";
                worksheet.Cell(1, 5).Value = "작업자";
                worksheet.Cell(1, 6).Value = "Wafer";
                worksheet.Cell(1, 7).Value = "Wager 구분";
                worksheet.Cell(1, 8).Value = "납품일시";
                worksheet.Cell(1, 9).Value = "사용부서";
                worksheet.Cell(1, 10).Value = "사용가능 칩";
                worksheet.Cell(1, 11).Value = "생산한 칩";
                worksheet.Cell(1, 12).Value = "잔여 칩";
                worksheet.Cell(1, 13).Value = "Lot";
                worksheet.Cell(1, 14).Value = "비고";

                for (int i = 0; i < datas.Count; i++)
                {
                    var data = datas[i];
                    worksheet.Cell(i + 2, 1).Value = i + 1;
                    worksheet.Cell(i + 2, 2).Value = data.Chip;
                    worksheet.Cell(i + 2, 3).Value = data.Division;
                    worksheet.Cell(i + 2, 4).Value = data.UseDate?.ToString("yyyy-MM-dd");
                    worksheet.Cell(i + 2, 5).Value = data.Producer;
                    worksheet.Cell(i + 2, 6).Value = data.Wafer;
                    worksheet.Cell(i + 2, 7).Value = data.WaferInfo;
                    worksheet.Cell(i + 2, 8).Value = data.ReceiptDate?.ToString("yyyy-MM-dd");
                    worksheet.Cell(i + 2, 9).Value = data.Operator;
                    worksheet.Cell(i + 2, 10).Value = data.Available;
                    worksheet.Cell(i + 2, 11).Value = data.Production;
                    worksheet.Cell(i + 2, 12).Value = data.Left;
                    worksheet.Cell(i + 2, 13).Value = data.Lot;
                    worksheet.Cell(i + 2, 14).Value = data.Note;
                }

                using (var stream = new MemoryStream())
                {
                    workbook.SaveAs(stream);
                    return stream.ToArray();
                }
            }
        }
        catch (Exception ex)
        {
            Snackbar.Add($"데이터 내보내기 중 오류가 발생했습니다: {ex.Message}", Severity.Error);
            return Array.Empty<byte>();
        }
        finally
        {
            exporting = false;
        }
    }

    // ───────────────────────── 셀 스타일 ─────────────────────────

    private Func<ChipUsage, string> _cellStyleFunc => x =>
    {
        string style = "height:45px; ";

        if (x.Division == "납품")
            style += "background-color:#F9CB9C";
        else if (x.Division == "제작")
            style += "background-color:#D9EAD3";
        else if (x.Division == "소진")
            style += "background-color:#f8766b";

        return style;
    };

    private Func<ChipPressure, string> _cellStyleFunc2 => x =>
    {
        string style = "";
        if (x.passFail == "FAIL")
            style += "background-color:#f8766b";
        return style;
    };

    // 같은 웨이퍼 중 가장 최근에 사용된 행의 '잔여' 칸을 강조.
    // 예전: 셀을 그릴 때마다 전체 목록을 순회(O(N²)). 지금: 페이지 로드 시 계산해 둔 사전을 조회(O(1)).
    private Func<ChipUsage, string> _cellStyleFunc3 => x =>
    {
        if (x is null || string.IsNullOrWhiteSpace(x.WaferInfo) || x.Division == "소진" || x.UseDate is null)
            return "";

        return _latestUseDateByWafer.TryGetValue(x.WaferInfo, out var latest) && x.UseDate == latest
            ? "background-color:#D9EAD3"
            : "";
    };
}
