@page "/chipusages"
@rendermode InteractiveServer
@using Microsoft.EntityFrameworkCore
@using MxTWeb.Models
@using MxTWeb.Data
@using Microsoft.AspNetCore.Authorization
@attribute [Authorize]
@implements IAsyncDisposable
@inject IDbContextFactory<MxTWeb.Data.MxTWebContext> DbFactory
@inject IDialogService DialogService

<PageTitle>칩 사용 대장</PageTitle>

<h2 style="margin-left: 10px">칩 사용 대장</h2>
<br />

<MudDataGrid @ref="dataGrid" Items="FilteredData.AsQueryable()" SortMode="SortMode.None">
    <ToolBarContent>
        <MudButton Class="me-2" @onclick="CreateNew" Variant="Variant.Filled" Color="Color.Primary" StartIcon="@Icons.Material.Filled.Add">
            Add New
        </MudButton>
        <MudSpacer />

        <MudMenu Label="@SearchField" Variant="Variant.Filled" EndIcon="@Icons.Material.Filled.KeyboardArrowDown" IconColor="Color.Secondary">
            <MudMenuItem Label="구분" @onclick="@(() => SelectItem("1"))" />
            <MudMenuItem Label="사용 일자" @onclick="@(() => SelectItem("2"))" />
            <MudMenuItem Label="작업자" @onclick="@(() => SelectItem("3"))" />
            <MudMenuItem Label="웨이퍼" @onclick="@(() => SelectItem("4"))" />
            <MudMenuItem Label="수령일" @onclick="@(() => SelectItem("5"))" />
            <MudMenuItem Label="사용자" @onclick="@(() => SelectItem("6"))" />
        </MudMenu>
        &nbsp&nbsp&nbsp
        <MudTextField @bind-Value="SearchFilter" Placeholder="Search" Adornment="Adornment.Start" Immediate="true"
                      AdornmentIcon="@Icons.Material.Filled.Search" IconSize="Size.Medium" Class="mt-0"></MudTextField>

    </ToolBarContent>

    <Columns>
        <PropertyColumn Property="x => x.Chip" Title="Chip 종류" Align="Align.Center"
                        sortable="true" />
        <PropertyColumn Property="chipusage => chipusage.Division" Title="구분" Align="Align.Center"
                        sortable="true" />
        <PropertyColumn Property="chipusage => chipusage.UseDate" Title="사용 일자" Align="Align.Center"
                        sortable="true" />
        <PropertyColumn Property="chipusage => chipusage.Producer" Title="작업자" Align="Align.Center"
                        sortable="true" />
        <PropertyColumn Property="chipusage => chipusage.Wafer" Title="웨이퍼" Align="Align.Center"
                        sortable="true" />
        <PropertyColumn Property="chipusage => chipusage.WaferInfo" Title="웨이퍼 정보" />
        <PropertyColumn Property="chipusage => chipusage.ReceiptDate" Title="수령일" Align="Align.Center"
                        sortable="true" />
        <PropertyColumn Property="chipusage => chipusage.Operator" Title="사용자" Align="Align.Center"
                        sortable="true" />
        <PropertyColumn Property="chipusage => chipusage.Available" Title="사용 가능 칩" />
        <PropertyColumn Property="chipusage => chipusage.Production" Title="생산한 칩" />
        <PropertyColumn Property="chipusage => chipusage.Left" Title="재고" />
        <PropertyColumn Property="chipusage => chipusage.Lot" Title="Lot" />
        <PropertyColumn Property="chipusage => chipusage.Note" Title="비고" />

        <TemplateColumn CellClass="d-flex justify-end" Context="x">
            <CellTemplate>
                <MudButton Class="me-2" Size="@Size.Small" Variant="Variant.Filled" StartIcon="@Icons.Material.Filled.Edit"
                            Color="@Color.Warning" @onclick="EditData">
                    Update
                </MudButton>
            </CellTemplate>
        </TemplateColumn>
    </Columns>

    <PagerContent>
        <MudDataGridPager/>
    </PagerContent>
</MudDataGrid>

@code {
    private MxTWebContext context = default!;
    private MudDataGrid<ChipUsage> dataGrid;

    private readonly SemaphoreSlim _searchSemaphore = new(1, 1);
    private CancellationTokenSource? _searchCts;
    private List<ChipUsage> _filteredResults = new();

    private string SearchField = "구분"; // 기본 검색 항목
    private string _searchFilter = "";
    private string SearchFilter
    {
        get => _searchFilter;
        set
        {
            _searchFilter = value;
            _ = PerformSearchAsync();
        }
    }
    private IEnumerable<ChipUsage> FilteredData => _filteredResults;

    private async Task PerformSearchAsync()
    {
        // 동시 실행 방지 // available semaphore가 없으면 바로 return
        if (!await _searchSemaphore.WaitAsync(0)) return;

        try
        {
            _searchCts?.Cancel();
            _searchCts = new CancellationTokenSource();

            using var context = DbFactory.CreateDbContext();

            var query = SearchField switch
            {
                "1" => context.ChipUsage.Where(m => m.Division!.Contains(SearchFilter)),
                "2" => context.ChipUsage.Where(m => m.UseDate.ToString().Contains(SearchFilter)),
                "3" => context.ChipUsage.Where(m => m.Producer!.Contains(SearchFilter)),
                "4" => context.ChipUsage.Where(m => m.Wafer!.Contains(SearchFilter)),
                "5" => context.ChipUsage.Where(m => m.ReceiptDate.ToString()!.Contains(SearchFilter)),
                "6" => context.ChipUsage.Where(m => m.Operator!.Contains(SearchFilter)),
                _ => context.ChipUsage.Where(m => m.Division!.Contains(SearchFilter))
            };

            _filteredResults = await query.ToListAsync(_searchCts.Token);
            await InvokeAsync(StateHasChanged);
        }
        catch (OperationCanceledException) { }
        finally
        {
            _searchSemaphore.Release();
        }
    }

    private async Task CreateNew()
    {
        var options = new DialogOptions { MaxWidth = MaxWidth.Large };

        var dialog = await DialogService.ShowAsync<Create>("Add New Chip", options);
        var result = await dialog.Result;

        if (result is not null && !result.Canceled)
        {
            await PerformSearchAsync();
        }
    }

    private async Task EditData()
    {
        var options = new DialogOptions { MaxWidth = MaxWidth.Large };

        var dialog = await DialogService.ShowAsync<Edit>("Edit Chip", options);
        var result = await dialog.Result;

        if (result is not null && !result.Canceled)
        {
            await PerformSearchAsync();
        }
    }

    private void SelectItem(string item)
    {
        SearchField = item;
    }

    protected override void OnInitialized()
    {
        context = DbFactory.CreateDbContext();
		_filteredResults = context.ChipUsage.ToList();
    }

    public async ValueTask DisposeAsync() => await context.DisposeAsync();
}
