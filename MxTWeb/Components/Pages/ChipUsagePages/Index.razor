                <PropertyColumn Property="x => x.Producer" Title="작업자" Sortable="true" />
                <PropertyColumn Property="x => x.Wafer" Title="웨이퍼" sortable="true" />
                <PropertyColumn Property="x => x.WaferInfo" Title="웨이퍼 정보" />
                <PropertyColumn Property="x => x.ReceiptDate" Title="납품일시" sortable="true" Format="yyyy-MM-dd" />
                <PropertyColumn Property="x => x.Lot" Title="Lot" sortable="false" />
                <PropertyColumn Property="x => x.Operator" Title="사용부서" sortable="true" />
                <PropertyColumn Property="x => x.Available" Title="수량" sortable="false" />
                <PropertyColumn Property="x => x.Production" Title="생산" sortable="false" />
                <PropertyColumn Property="x => x.Left" Title="잔여" sortable="false"
                                CellStyleFunc="@_cellStyleFunc3"/>
                <PropertyColumn Property="x => x.Note" Title="비고" sortable="false" />
            </Columns>
            <ChildRowContent>
                <ChipPressureRows ChipUsage="context.Item" />
            </ChildRowContent>

            <PagerContent>
