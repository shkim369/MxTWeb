@page "/chipusages"
@rendermode InteractiveServer
@using Microsoft.EntityFrameworkCore
@using Microsoft.AspNetCore.Components.QuickGrid
@using MxTWeb.Models
@using MxTWeb.Data
@implements IAsyncDisposable
@inject IDbContextFactory<MxTWeb.Data.MxTWebContext> DbFactory

<PageTitle>칩 사용 대장</PageTitle>

<h1>칩 사용 대장</h1>

<br />
<div class="dropdown">
    <button class="btn btn-outline-secondary dropdown-toggle" type="button" data-bs-toggle="dropdown" aria-expanded="false">
        @SearchField
    </button>
    <ul class="dropdown-menu">
        <li><a class="dropdown-item" @onclick="@(() => SelectItem("구분"))">구분</a></li>
        <li><a class="dropdown-item" @onclick="@(() => SelectItem("사용 일자"))">사용 일자</a></li>
        <li><a class="dropdown-item" @onclick="@(() => SelectItem("작업자"))">작업자</a></li>
        <li><a class="dropdown-item" @onclick="@(() => SelectItem("웨이퍼"))">웨이퍼</a></li>
        <li><a class="dropdown-item" @onclick="@(() => SelectItem("수령일"))">수령일</a></li>
        <li><a class="dropdown-item" @onclick="@(() => SelectItem("사용자"))">사용자</a></li>
    </ul>

    <input type="search" @bind="SearchFilter" @bind:event="onchange" placeholder="검색어 입력"
           style="width:300px; margin-top:20px;" />

    <i class="bi bi-search"></i> Search
</div>
<br />
<p>
    <a href="chipusages/create" class="btn btn-outline-secondary">Create New</a>
</p>

<div>
    <QuickGrid Class="table table-bordered table-sm" Items="FilteredChipUsages" Pagination="pagination">
        <PropertyColumn Property="chipusage => chipusage.Chip" Title="Chip 종류" Align="Align.Center"
                        sortable="true" />
        <PropertyColumn Property="chipusage => chipusage.Division" Title="구분" Align="Align.Center"
                        sortable="true" />
        <PropertyColumn Property="chipusage => chipusage.UseDate" Title="사용 일자" Align="Align.Center"
                        sortable="true" />
        <PropertyColumn Property="chipusage => chipusage.Producer" Title="작업자" Align="Align.Center"
                        sortable="true" />
        <PropertyColumn Property="chipusage => chipusage.Wafer" Title="웨이퍼" Align="Align.Center"
                        sortable="true" />
        <PropertyColumn Property="chipusage => chipusage.WaferInfo" Title="웨이퍼 정보" Align="Align.Center"/>
        <PropertyColumn Property="chipusage => chipusage.ReceiptDate" Title="수령일" Align="Align.Center"
                        sortable="true" />
        <PropertyColumn Property="chipusage => chipusage.Operator" Title="사용자" Align="Align.Center"
                        sortable="true" />
        <PropertyColumn Property="chipusage => chipusage.Available" Title="사용 가능 칩" Align="Align.Center"/>
        <PropertyColumn Property="chipusage => chipusage.Production" Title="생산한 칩" Align="Align.Center"/>
        <PropertyColumn Property="chipusage => chipusage.Left" Title="재고" Align="Align.Center" />
        <PropertyColumn Property="chipusage => chipusage.Lot" Title="Lot" Align="Align.Center" />
        <PropertyColumn Property="chipusage => chipusage.Note" Title="비고" Align="Align.Center" />

        <TemplateColumn Context="chipusage">
            <div class="d-flex">
                <a href="@($"chipusages/edit?id={chipusage.Id}")" class="btn btn-primary px-4">Edit</a>
                <a href="@($"chipusages/delete?id={chipusage.Id}")" class="btn btn-danger">Delete</a>
            </div>
        </TemplateColumn>
    </QuickGrid>
</div>

<Paginator State="pagination" />

@code {
    private MxTWebContext context = default!;

    private PaginationState pagination = new PaginationState { ItemsPerPage = 15 };

    private string SearchFilter = string.Empty;
    private string SearchField = "구분"; // Default search field

    private void SelectItem(string item)
    {
        SearchField = item;
    }

    private IQueryable<ChipUsage> FilteredChipUsages => GetFilteredData();

    private IQueryable<ChipUsage> GetFilteredData()
    {
        return SearchField switch
        {
            "구분" => context.ChipUsage.Where(m => m.Division!.Contains(SearchFilter)),
            "사용 일자" => context.ChipUsage.Where(m => m.UseDate.ToString().Contains(SearchFilter)),
            "작업자" => context.ChipUsage.Where(m => m.Producer!.Contains(SearchFilter)),
            "웨이퍼" => context.ChipUsage.Where(m => m.Wafer!.Contains(SearchFilter)),
            "수령일" => context.ChipUsage.Where(m => m.ReceiptDate.ToString()!.Contains(SearchFilter)),
            "사용자" => context.ChipUsage.Where(m => m.Operator!.Contains(SearchFilter)),
            _ => context.ChipUsage.Where(m => m.Division!.Contains(SearchFilter))
        };
    }

    protected override void OnInitialized()
    {
        context = DbFactory.CreateDbContext();
    }

    public async ValueTask DisposeAsync() => await context.DisposeAsync();
}
