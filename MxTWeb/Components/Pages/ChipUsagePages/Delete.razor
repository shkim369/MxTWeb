@page "/chipusages/delete"
@using Microsoft.EntityFrameworkCore
@using MxTWeb.Models
@using Microsoft.AspNetCore.Authorization
@attribute [Authorize]
@inject IDbContextFactory<MxTWeb.Data.MxTWebContext> DbFactory
@inject NavigationManager NavigationManager
@inject ISnackbar Snackbar

<PageTitle>Delete</PageTitle>

<EditForm method="post" Model="chipUsage" OnValidSubmit="DeleteChipUsage" FormName="delete" Enhance>
    <MudDialog>
        <DialogContent>
            <MudText>Are you sure you want to delete this?</MudText>
        </DialogContent>

        <DialogActions>
            <MudButton Class="mb-3 me-5" ButtonType="ButtonType.Submit" Variant="Variant.Filled" Color="Color.Error"
                       StartIcon="@Icons.Material.Filled.Delete">Delete</MudButton>
            <MudButton Class="mb-3 me-5" Variant="Variant.Filled" Color="Color.Secondary" OnClick="() => MudDialog.Cancel()">Cancel</MudButton>
        </DialogActions>
    </MudDialog>
</EditForm>

@code {
    [Parameter]
    public ChipUsage? chipUsage { get; set; } = new();

    [SupplyParameterFromQuery]
    private int Id { get; set; }

    [CascadingParameter]
    private IMudDialogInstance MudDialog { get; set; }

    protected override async Task OnInitializedAsync()
    {
        chipUsage = new ChipUsage
        {
            Id = chipUsage.Id,
        };
    }

    private async Task DeleteChipUsage()
    {
        using var context = DbFactory.CreateDbContext();
        context.ChipUsage.Remove(chipUsage!);
        await context.SaveChangesAsync();
        NavigationManager.NavigateTo("/chipusages");

        Snackbar.Add("삭제가 완료되었습니다.", Severity.Success);
        MudDialog.Close();
    }
}
