@page "/updates/edit/{Id:int}"
@rendermode InteractiveServer
@using Microsoft.EntityFrameworkCore
@using MxTWeb.Data
@using System.Net.Http.Headers
@using Microsoft.AspNetCore.Authorization
@inject IDbContextFactory<ApplicationDbContext> DbFactory
@inject NavigationManager NavigationManager
@inject ISnackbar Snackbar
@inject HttpClient Http
@inject IConfiguration Configuration
@attribute [Authorize]

<PageTitle>업데이트 수정</PageTitle>

<MudContainer MaxWidth="MaxWidth.Medium" Class="mt-4">
    @if (_loading)
    {
        <MudProgressCircular Color="Color.Primary" Indeterminate="true" />
    }
    else if (_post == null)
    {
        <MudAlert Severity="Severity.Error">게시글을 찾을 수 없습니다.</MudAlert>
    }
    else
    {
        <MudText Typo="Typo.h4" Class="mb-4">업데이트 수정</MudText>

        <MudPaper Class="pa-4">
            <MudForm @ref="_form" @bind-IsValid="@_formValid">
                <MudGrid>
                    <MudItem xs="12" md="8">
                        <MudTextField @bind-Value="_post.Title"
                                      Label="제목"
                                      Required="true"
                                      RequiredError="제목을 입력해주세요."
                                      MaxLength="200"
                                      Counter="200"
                                      Immediate="true" />
                    </MudItem>
                    <MudItem xs="12" md="4">
                        <MudTextField @bind-Value="_post.Version"
                                      Label="버전"
                                      Placeholder="예: v1.0.0"
                                      MaxLength="50" />
                    </MudItem>
                    <MudItem xs="12">
                        <MudTextField @bind-Value="_post.Content"
                                      Label="내용"
                                      Required="true"
                                      RequiredError="내용을 입력해주세요."
                                      Lines="10"
                                      Variant="Variant.Outlined" />
                    </MudItem>
                    <MudItem xs="12">
                        <MudText Typo="Typo.subtitle1" Class="mb-2">첨부파일</MudText>

                        @if (!string.IsNullOrEmpty(_post.StoredFileName) && !_replaceFile)
                        {
                            <MudPaper Outlined="true" Class="pa-3 d-flex align-center justify-space-between mb-2">
                                <div class="d-flex align-center">
                                    <MudIcon Icon="@Icons.Material.Filled.InsertDriveFile" Color="Color.Primary" Class="mr-2" />
                                    <div>
                                        <MudText Typo="Typo.body2">@_post.AttachedFileName</MudText>
                                        <MudText Typo="Typo.caption" Color="Color.Info">@FormatFileSize(_post.FileSize ?? 0)</MudText>
                                    </div>
                                </div>
                                <div>
                                    <MudButton Variant="Variant.Filled"
                                               Color="Color.Info"
                                               Size="Size.Small"
                                               OnClick="@(() => _replaceFile = true)">
                                        파일 교체
                                    </MudButton>
                                    <MudButton Variant="Variant.Filled"
                                               Color="Color.Error"
                                               Size="Size.Small"
                                               OnClick="RemoveFile">
                                        파일 삭제
                                    </MudButton>
                                </div>
                            </MudPaper>
                        }
                        else
                        {
                            <MudFileUpload T="IBrowserFile"
                                           FilesChanged="OnFileSelected"
                                           Accept="*" DragAndDrop="true"
                                           MaxFileSize="52428800">

                                <SelectedTemplate>
                                    @if (_selectedFile != null)
                                    {
                                        <MudChip T="string" Color="Color.Info" Class="mt-2" OnClose="ClearFile">
                                            <MudIcon Icon="@Icons.Material.Filled.InsertDriveFile" Class="mr-1" />
                                            @_selectedFile.Name (@FormatFileSize(_selectedFile.Size))
                                        </MudChip>
                                    }
                                </SelectedTemplate>
                                   
                            </MudFileUpload>

                            @if (_replaceFile && !string.IsNullOrEmpty(_originalStoredFileName))
                            {
                                <MudButton Variant="Variant.Filled"
                                           Color="Color.Secondary"
                                           Size="Size.Small"
                                           Class="mt-2"
                                           OnClick="CancelReplace">
                                    취소
                                </MudButton>
                            }
                        }
                    </MudItem>
                </MudGrid>

                <MudDivider Class="my-4" />

                <MudGrid>
                    <MudItem xs="12" Class="d-flex justify-end gap-2">
                        <MudButton Variant="Variant.Filled"
                                   Color="Color.Secondary"
                                   Href="/updates">
                            취소
                        </MudButton>
                        <MudButton Variant="Variant.Filled"
                                   Color="Color.Primary"
                                   Disabled="@(!_formValid || _saving)"
                                   OnClick="SavePost">
                            @if (_saving)
                            {
                                <MudProgressCircular Size="Size.Small" Indeterminate="true" Class="mr-2" />
                                <span>저장 중...</span>
                            }
                            else
                            {
                                <span>저장</span>
                            }
                        </MudButton>
                    </MudItem>
                </MudGrid>
            </MudForm>
        </MudPaper>
    }
</MudContainer>

@code {
    [Parameter]
    public int Id { get; set; }

    private MudForm _form = null!;
    private bool _formValid;
    private bool _saving;
    private bool _loading = true;
    private bool _replaceFile;
    private bool _removeFile;
    private UpdatePost? _post;
    private IBrowserFile? _selectedFile;
    private string? _originalStoredFileName;
    private long _maxFileSize = 50 * 1024 * 1024; // 50MB

    protected override async Task OnInitializedAsync()
    {
        await LoadPost();
    }

    private async Task LoadPost()
    {
        _loading = true;
        try
        {
            using var context = await DbFactory.CreateDbContextAsync();
            _post = await context.UpdatePosts.FindAsync(Id);
            _originalStoredFileName = _post?.StoredFileName;
        }
        catch (Exception ex)
        {
            Snackbar.Add($"데이터 로드 실패: {ex.Message}", Severity.Error);
        }
        finally
        {
            _loading = false;
        }
    }

    private void OnFileSelected(IBrowserFile file)
    {
        if (file.Size > _maxFileSize)
        {
            Snackbar.Add("파일 크기는 50MB를 초과할 수 없습니다.", Severity.Warning);
            return;
        }
        _selectedFile = file;
    }

    private void ClearFile()
    {
        _selectedFile = null;
    }

    private void RemoveFile()
    {
        _removeFile = true;
        _replaceFile = true;
        _post!.AttachedFileName = null;
        _post.StoredFileName = null;
        _post.FileSize = null;
    }

    private void CancelReplace()
    {
        _replaceFile = false;
        _removeFile = false;
        _selectedFile = null;
        // 원래 파일 정보 복원
        if (_post != null)
        {
            _post.StoredFileName = _originalStoredFileName;
        }
    }

    private async Task SavePost()
    {
        await _form.Validate();
        if (!_formValid || _post == null) return;

        _saving = true;

        try
        {
            var apiKey = Configuration["ApiKey"] ?? "MxT0304";

            // 기존 파일 삭제 (교체하거나 삭제하는 경우)
            if ((_replaceFile || _removeFile) && !string.IsNullOrEmpty(_originalStoredFileName))
            {
                using var deleteRequest = new HttpRequestMessage(HttpMethod.Delete, $"api/fileupload/update/delete/{_originalStoredFileName}");
                deleteRequest.Headers.Add("X-Api-Key", apiKey);
                await Http.SendAsync(deleteRequest);
            }

            // 새 파일 업로드
            if (_selectedFile != null)
            {
                using var content = new MultipartFormDataContent();
                var fileContent = new StreamContent(_selectedFile.OpenReadStream(_maxFileSize));
                fileContent.Headers.ContentType = new MediaTypeHeaderValue(
                    string.IsNullOrEmpty(_selectedFile.ContentType) ? "application/octet-stream" : _selectedFile.ContentType);
                content.Add(fileContent, "file", _selectedFile.Name);

                using var uploadRequest = new HttpRequestMessage(HttpMethod.Post, "api/fileupload/update/upload");
                uploadRequest.Headers.Add("X-Api-Key", apiKey);
                uploadRequest.Content = content;

                var response = await Http.SendAsync(uploadRequest);

                if (response.IsSuccessStatusCode)
                {
                    var result = await response.Content.ReadFromJsonAsync<FileUploadResult>();
                    if (result != null)
                    {
                        _post.AttachedFileName = result.FileName;
                        _post.StoredFileName = result.StoredFileName;
                        _post.FileSize = result.Size;
                    }
                }
                else
                {
                    var error = await response.Content.ReadAsStringAsync();
                    Snackbar.Add($"파일 업로드 실패: {error}", Severity.Error);
                    _saving = false;
                    return;
                }
            }

            // 게시글 업데이트
            _post.UpdatedAt = DateTime.Now;

            using var context = await DbFactory.CreateDbContextAsync();
            context.UpdatePosts.Update(_post);
            await context.SaveChangesAsync();

            Snackbar.Add("수정되었습니다.", Severity.Success);
            NavigationManager.NavigateTo("/updates");
        }
        catch (Exception ex)
        {
            Snackbar.Add($"저장 실패: {ex.Message}", Severity.Error);
        }
        finally
        {
            _saving = false;
        }
    }

    private string FormatFileSize(long bytes)
    {
        string[] sizes = { "B", "KB", "MB", "GB" };
        double len = bytes;
        int order = 0;
        while (len >= 1024 && order < sizes.Length - 1)
        {
            order++;
            len = len / 1024;
        }
        return $"{len:0.##} {sizes[order]}";
    }

    private class FileUploadResult
    {
        public string Id { get; set; } = "";
        public string FileName { get; set; } = "";
        public string StoredFileName { get; set; } = "";
        public long Size { get; set; }
        public string ContentType { get; set; } = "";
        public DateTime UploadDate { get; set; }
    }
}
