@page "/shipment/edit"
@using Microsoft.EntityFrameworkCore
@using MxTWeb.Models
@using Microsoft.AspNetCore.Authorization
@attribute [Authorize]
@inject IDbContextFactory<MxTWeb.Data.MxTWebContext> DbFactory
@inject NavigationManager NavigationManager
@inject ISnackbar Snackbar

<PageTitle>Edit</PageTitle>

<EditForm method="post" Model="Shipment" OnValidSubmit="OnValidSubmit" FormName="edit" Enhance>
    <MudDialog>
        <DialogContent>
            <DataAnnotationsValidator />

            <MudSelect Class="mb-5" @bind-Value="Shipment.Division" Variant="Variant.Outlined"
                       Required="true" Label="구분">
                <MudSelectItem Value="@("Chip")">Chip</MudSelectItem>
                <MudSelectItem Value="@("RUO")">RUO</MudSelectItem>
            </MudSelect>

            <MudTextField Class="mb-5" Variant="Variant.Outlined" Label="품명"
                          @bind-Value="Shipment.Name"
                          For="@(() => Shipment.Name)"
                          Required="true" Immediate="true" />

            <MudGrid Class="mb-5">
                <MudItem xs="6">
                    <MudTextField Variant="Variant.Outlined"
                                  Label="납품처"
                                  @bind-Value="Shipment.Destination"
                                  For="@(() => Shipment.Destination)"
                                  Required="true" Immediate="true" />
                </MudItem>

                <MudItem xs="6">
                    <MudDatePicker Variant="Variant.Outlined"
                                   Label="납품일"
                                   @bind-Date="Shipment.Date"
                                   For="@(() => Shipment.Date)"
                                   Required="true" Immediate="true" 
                                   DateFormat="yyyy-MM-dd" />
                </MudItem>
            </MudGrid>

            @if (Shipment.Division == "Chip")
            {
                <MudTextField Class="mb-5" Variant="Variant.Outlined"
                              Label="Lot"
                              @bind-Value="Shipment.LotNumber" />

                <MudGrid Class="mb-5">
                    <MudItem xs="6">
                        <MudTextField Variant="Variant.Outlined"
                                      Label="칩 종류"
                                      @bind-Value="Shipment.Chip" />
                    </MudItem>
                    <MudItem xs="6">
                        <MudTextField Variant="Variant.Outlined"
                                      Label="수량"
                                      @bind-Value="Shipment.Quantity" />
                    </MudItem>
                </MudGrid>
            }
            else
            {
                <MudTextField Class="mb-5" Variant="Variant.Outlined"
                              Label="Serial Number"
                              @bind-Value="Shipment.SerialNumber" />

                <MudGrid Class="mb-5">
                    <MudItem xs="6">
                        <MudTextField Variant="Variant.Outlined"
                                      Label="S/W Version"
                                      @bind-Value="Shipment.SWVersion" />
                    </MudItem>
                    <MudItem xs="6">
                        <MudTextField Variant="Variant.Outlined"
                                      Label="H/W Version"
                                      @bind-Value="Shipment.HWVersion" />
                    </MudItem>
                </MudGrid>
            }

            <MudTextField Class="mb-5" Variant="Variant.Outlined"
                          Label="비고"
                          @bind-Value="Shipment.Comments" />

        </DialogContent>
        <DialogActions>
            <MudButton Class="mb-5 me-5" ButtonType="ButtonType.Submit" Variant="Variant.Filled"
                       Disabled="@_isProcessing"
                       StartIcon="@(_isProcessing ? Icons.Material.Filled.HourglassEmpty : Icons.Material.Filled.Save)" Color="Color.Info">SAVE</MudButton>
            <MudButton Class="mb-5 me-5" Variant="Variant.Filled" Color="Color.Secondary" OnClick="() => MudDialog.Cancel()">Cancel</MudButton>
        </DialogActions>
    </MudDialog>
</EditForm>


@code {
    [Parameter]
    public UIActionEnum action { get; set; } = UIActionEnum.Insert;

    [SupplyParameterFromQuery]
    private int Id { get; set; }

    [Parameter]
    public Shipment? Shipment { get; set; } = new();

    [CascadingParameter]
    private IMudDialogInstance MudDialog { get; set; }

    private bool _isProcessing = false;

    private async Task OnValidSubmit()
    {
        if (_isProcessing) return;
        _isProcessing = true;

        try
        {
            if (action == UIActionEnum.Insert)
            {
                await AddComponent();
            }
            else if (action == UIActionEnum.Update)
            {
                await UpdateData();
            }
        }
        finally
        {
            _isProcessing = false;
        }
    }

    protected override async Task OnInitializedAsync()
    {
        if (action == UIActionEnum.Insert)
        {
            Shipment.Division = "Chip";
        }
        else if (action == UIActionEnum.Update)
        {
            using var context = DbFactory.CreateDbContext();
            Shipment ??= await context.Shipment.FirstOrDefaultAsync(m => m.ShipmentId == Id);

            if (Shipment is null)
            {
                NavigationManager.NavigateTo("notfound");
            }
        }
    }

    private async Task AddComponent()
    {
        using var context = DbFactory.CreateDbContext();
        context.Shipment.Add(Shipment);
        await context.SaveChangesAsync();

        Snackbar.Add("성공적으로 추가되었습니다.", Severity.Success);
        MudDialog.Close();
    }

    private async Task UpdateData()
    {
        using var context = DbFactory.CreateDbContext();
        context.Attach(Shipment!).State = EntityState.Modified;

        try
        {
            await context.SaveChangesAsync();
        }
        catch (DbUpdateConcurrencyException)
        {
            if (!DataExists(Shipment!.ShipmentId))
            {
                NavigationManager.NavigateTo("notfound");
            }
            else
            {
                throw;
            }
        }

        Snackbar.Add("성공적으로 수정되었습니다.", Severity.Success);
        MudDialog.Close();
    }

    private bool DataExists(int id)
    {
        using var context = DbFactory.CreateDbContext();
        return context.Shipment.Any(e => e.ShipmentId == id);
    }
}
