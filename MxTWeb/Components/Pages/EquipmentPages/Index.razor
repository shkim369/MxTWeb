@page "/equipments"
@rendermode InteractiveServer
@using Microsoft.EntityFrameworkCore
@using Microsoft.AspNetCore.Components.QuickGrid
@using MxTWeb.Models
@using MxTWeb.Data
@using Microsoft.AspNetCore.Authorization
@attribute [Authorize]
@implements IAsyncDisposable
@inject IDbContextFactory<MxTWeb.Data.MxTWebContext> DbFactory

<PageTitle>연구용 장비·기기 관리대장</PageTitle>

<h1>연구용 장비·기기 관리대장</h1>

<br />
<div class="dropdown">
    <button class="btn btn-outline-secondary dropdown-toggle" type="button" data-bs-toggle="dropdown" aria-expanded="false">
        @SearchField
    </button>
    <ul class="dropdown-menu">
        <li><a class="dropdown-item" @onclick="@(() => SelectItem("관리번호"))">관리번호</a></li>
        <li><a class="dropdown-item" @onclick="@(() => SelectItem("품명"))">품명</a></li>
        <li><a class="dropdown-item" @onclick="@(() => SelectItem("모델명"))">모델명</a></li>
        <li><a class="dropdown-item" @onclick="@(() => SelectItem("제조사"))">제조사</a></li>
        <li><a class="dropdown-item" @onclick="@(() => SelectItem("구입일"))">구입일</a></li>  
        <li><a class="dropdown-item" @onclick="@(() => SelectItem("구입처"))">구입처</a></li>
        <li><a class="dropdown-item" @onclick="@(() => SelectItem("설치장소"))">설치장소</a></li>
        <li><a class="dropdown-item" @onclick="@(() => SelectItem("관리자"))">관리자</a></li>
    </ul>

    <input type="search" @bind="SearchFilter" @bind:event="oninput" placeholder="검색어 입력" 
           style="width:300px; margin-top:20px;" />

    <i class="bi bi-search"></i> Search
</div>
<br />
<p>
    <a href="equipments/create" class="btn btn-outline-secondary">Create New</a>
</p>

<div>
	<QuickGrid Class="table table-bordered table-sm" Items="FilteredData.AsQueryable()" Pagination="pagination">
        <PropertyColumn Property="equipment => equipment.ManageCode" Title="관리번호" Sortable="true"
                        Class="text pe-0" />
		<PropertyColumn Property="equipment => equipment.Name" Title="품명" Sortable="true" 
                        Class="text pe-0" />
        <PropertyColumn Property="equipment => equipment.Model" Title="모델명" Sortable="true"
                        Class="text pe-0"/>
		<PropertyColumn Property="equipment => equipment.Manufacturer" Title="제조사" Sortable="true"
                        Class="text pe-0" />
		<PropertyColumn Property="equipment => equipment.PurchaseDate" Title="구입일" Sortable="true"
                        Class="text pe-0" />
		<PropertyColumn Property="equipment => equipment.Seller" Title="구입처" Sortable="true"
                        Class="text pe-0" />
		<PropertyColumn Property="equipment => equipment.Location" Title="설치장소" Sortable="true"
                        Class="text pe-0" />
        <PropertyColumn Property="equipment => equipment.Management" Title="유지보수 활동" 
                        Class="text pe-0" />
        <PropertyColumn Property="equipment => equipment.Manager" Title="관리자 (정/부)" 
                        Class="text pe-0" />
        <PropertyColumn Property="equipment => equipment.Note" Title="비고 (용도, 위치)" 
                        Class="text pe-0" />

        <TemplateColumn Context="equipment">
            <div class="d-flex">
                <a href="@($"equipments/edit?id={equipment.Id}")" class="btn btn-primary px-4">Edit</a>
                <a href="@($"equipments/delete?id={equipment.Id}")" class="btn btn-danger">Delete</a>
            </div>
        </TemplateColumn>
    </QuickGrid>
</div>

<Paginator State="pagination" />

@code {
    private MxTWebContext context = default!;

    private PaginationState pagination = new PaginationState { ItemsPerPage = 15 };

    private readonly SemaphoreSlim _searchSemaphore = new(1, 1);
    private CancellationTokenSource? _searchCts;
    private List<Equipment> _filteredResults = new();

    private string SearchField = "품명"; // 기본 검색 항목
    private string _searchFilter = "";
    private string SearchFilter
    {
        get => _searchFilter;
        set
        {
            _searchFilter = value;
            _ = PerformSearchAsync();
        }
    }
    private IEnumerable<Equipment> FilteredData => _filteredResults;

    private async Task PerformSearchAsync()
    {
        // 동시 실행 방지 // available semaphore가 없으면 바로 return
        if (!await _searchSemaphore.WaitAsync(0)) return;

        try
        {
            _searchCts?.Cancel();
            _searchCts = new CancellationTokenSource();

            using var context = DbFactory.CreateDbContext();

            var query = SearchField switch
            {
                "관리번호" => context.Equipment.Where(m => m.ManageCode!.Contains(SearchFilter)),
                "품명" => context.Equipment.Where(m => m.Name!.ToString().Contains(SearchFilter)),
                "모델명" => context.Equipment.Where(m => m.Model!.Contains(SearchFilter)),
                "제조사" => context.Equipment.Where(m => m.Manufacturer!.Contains(SearchFilter)),
                "구입일" => context.Equipment.Where(m => m.PurchaseDate!.ToString().Contains(SearchFilter)),
                "구입처" => context.Equipment.Where(m => m.Seller!.ToString().Contains(SearchFilter)),
                "설치장소" => context.Equipment.Where(m => m.Location!.Contains(SearchFilter)),
                "관리자" => context.Equipment.Where(m => m.Manager!.Contains(SearchFilter)),
                _ => context.Equipment.Where(m => m.Name!.Contains(SearchFilter))
            };

            _filteredResults = await query.ToListAsync(_searchCts.Token);
            await InvokeAsync(StateHasChanged);
        }
        catch (OperationCanceledException) { }
        finally
        {
            _searchSemaphore.Release();
        }
    }

    private void SelectItem(string item)
    {
        SearchField = item;
    }

    protected override void OnInitialized()
    {
        context = DbFactory.CreateDbContext();
        _filteredResults = context.Equipment.ToList();
    }

    public async ValueTask DisposeAsync() => await context.DisposeAsync();
}
