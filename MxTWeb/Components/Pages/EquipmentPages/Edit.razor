@page "/equipments/edit"
@using Microsoft.EntityFrameworkCore
@using MxTWeb.Models
@using Microsoft.AspNetCore.Authorization
@attribute [Authorize]
@inject IDbContextFactory<MxTWeb.Data.MxTWebContext> DbFactory
@inject NavigationManager NavigationManager
@inject ISnackbar Snackbar

<EditForm method="post" Model="Equipment" OnValidSubmit="OnValidSubmit" FormName="edit" Enhance>
    <MudDialog>
        <DialogContent>
            <DataAnnotationsValidator />

            <MudTextField Class="mb-5" Variant="Variant.Outlined"
                          Label="관리번호"
                          @bind-Value="Equipment.ManageCode" Required="true" Immediate="true"/>

            <MudTextField Class="mb-5" Variant="Variant.Outlined"
                          Label="품명"
                          @bind-Value="Equipment.Name" Required="true" Immediate="true"/>

            <MudTextField Class="mb-5" Variant="Variant.Outlined"
                          Label="모델명"
                          @bind-Value="Equipment.Model" />

            <MudTextField Class="mb-5" Variant="Variant.Outlined"
                          Label="제조사"
                          @bind-Value="Equipment.Manufacturer" />

            <MudGrid Class="mb-5">
                <MudItem xs="6">
                    <MudDatePicker 
                                   Variant="Variant.Outlined"
                                   Label="구입일"
                                   @bind-Date="Equipment.PurchaseDate"
                                   DateFormat="yyyy-MM-dd" />
                </MudItem>

                <MudItem xs="6">
                    <MudTextField Variant="Variant.Outlined"
                                  Label="구입처"
                                  @bind-Value="Equipment.Seller" />
                </MudItem>
            </MudGrid>

            <MudGrid Class="mb-5">
                <MudItem xs="6">
                    <MudTextField Variant="Variant.Outlined"
                                  Label="설치장소"
                                  @bind-Value="Equipment.Location" />
                </MudItem>

                <MudItem xs="6">
                    <MudTextField Variant="Variant.Outlined"
                                  Label="관리부서"
                                  @bind-Value="Equipment.Management" />
                </MudItem>
            </MudGrid>

            <MudGrid Class="mb-5">
                <MudItem xs="6">
                    <MudTextField Variant="Variant.Outlined"
                                  Label="관리자(정)"
                                  @bind-Value="Equipment.Manager_Main" />
                </MudItem>

                <MudItem xs="6">
                    <MudTextField Variant="Variant.Outlined"
                                  Label="관리자(부)"
                                  @bind-Value="Equipment.Manager_Sub" />
                </MudItem>
            </MudGrid>

            <MudTextField Class="mb-5" Variant="Variant.Outlined"
                          Label="비고"
                          @bind-Value="Equipment.Note" />
        </DialogContent>
        <DialogActions>
            <MudButton Class="mb-5 me-5" ButtonType="ButtonType.Submit" Variant="Variant.Filled"
                       Disabled="@_isProcessing"
                       StartIcon="@(_isProcessing ? Icons.Material.Filled.HourglassEmpty : (action == UIActionEnum.Update ? Icons.Material.Filled.Edit : Icons.Material.Filled.Add))" Color="Color.Info">
                @(action == UIActionEnum.Update ? "Edit" : "ADD")
            </MudButton>
            <MudButton Class="mb-5 me-5" Variant="Variant.Filled" Color="Color.Secondary" OnClick="() => MudDialog.Cancel()">Cancel</MudButton>
        </DialogActions>
    </MudDialog>
</EditForm>

@code {
    [Parameter]
    public UIActionEnum action { get; set; } = UIActionEnum.Insert;

    [SupplyParameterFromQuery]
    private int Id { get; set; }

    [Parameter]
    public Equipment? Equipment { get; set; } = new();

    [CascadingParameter]
    private IMudDialogInstance MudDialog { get; set; }

    private bool _isProcessing = false;

    private async Task OnValidSubmit()
    {
        if (_isProcessing) return;
        _isProcessing = true;

        try
        {
            if (action == UIActionEnum.Insert)
            {
                await AddComponent();
            }
            else if (action == UIActionEnum.Update)
            {
                await UpdateComponent();
            }
        }
        finally
        {
            _isProcessing = false;
        }
    }

    private async Task AddComponent()
    {
        using var context = DbFactory.CreateDbContext();
        context.Equipment.Add(Equipment);
        await context.SaveChangesAsync();

        Snackbar.Add("성공적으로 추가되었습니다.", Severity.Success);
        MudDialog.Close();
    }

    private async Task UpdateComponent()
    {
        using var context = DbFactory.CreateDbContext();
        context.Attach(Equipment!).State = EntityState.Modified;

        try
        {
            await context.SaveChangesAsync();
        }
        catch (DbUpdateConcurrencyException)
        {
            if (!ComponentExists(Equipment!.Id))
            {
                NavigationManager.NavigateTo("notfound");
            }
            else
            {
                throw;
            }
        }

        Snackbar.Add("성공적으로 수정되었습니다.", Severity.Success);
        MudDialog.Close();
    }

    private bool ComponentExists(int id)
    {
        using var context = DbFactory.CreateDbContext();
        return context.Equipment.Any(e => e.Id == id);
    }

    protected override async Task OnInitializedAsync()
    {
        if (action == UIActionEnum.Insert)
        {

        }
        else if (action == UIActionEnum.Update)
        {
            using var context = DbFactory.CreateDbContext();
            Equipment ??= await context.Equipment.FirstOrDefaultAsync(m => m.Id == Id);

            if (Equipment is null)
            {
                NavigationManager.NavigateTo("notfound");
            }
        }

        //await LoadAutoComplete();
    }
}
