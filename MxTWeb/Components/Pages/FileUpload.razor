@page "/file-upload"
@rendermode InteractiveServer
@using Microsoft.EntityFrameworkCore
@using Services
@using System.IO
@using System.Net.Http
@using System.Net.Http.Headers
@using System.Net.Http.Json
@using System.Text.Json
@using Microsoft.AspNetCore.Authorization
@inject ISnackbar Snackbar
@inject HttpClient Http
@inject IHttpClientFactory ClientFactory
@inject ILogger<FileUpload> Logger
@inject IJSRuntime JS
@inject AuthenticationStateProvider AuthenticationStateProvider
@attribute [Authorize]

<PageTitle>File Upload</PageTitle>

<MudContainer MaxWidth="MaxWidth.Large" Class="mt-4">
    <MudText Typo="Typo.h4" Class="mb-4">파일 업로드 게시판</MudText>

    <MudPaper Class="pa-4 mb-4">
        <MudFileUpload T="IReadOnlyList<IBrowserFile>" FilesChanged="OnInputFileChange" Accept=".pdf,.doc,.docx,.xls,.xlsx,.jpg,.png,.txt,.zip">
            <ActivatorContent>
                <MudButton Variant="Variant.Filled"
                           Color="Color.Primary"
                           StartIcon="@Icons.Material.Filled.CloudUpload"
                           Disabled="@_uploading">
                    파일 업로드
                </MudButton>
            </ActivatorContent>
        </MudFileUpload>

        @if (_uploading)
        {
            <MudProgressLinear Color="Color.Primary" Indeterminate="true" Class="mt-2" />
            <MudText Typo="Typo.caption" Class="mt-1">업로드 중...</MudText>
        }
    </MudPaper>

    <MudPaper Class="pa-4">
        <MudText Typo="Typo.h6" Class="mb-3">
            업로드된 파일 목록 (@uploadedFiles.Count)
            <MudIconButton Icon="@Icons.Material.Filled.Refresh"
                           Size="Size.Small"
                           OnClick="LoadFiles"
                           Title="새로고침" />
        </MudText>

        @if (_loading)
        {
            <MudProgressCircular Color="Color.Primary" Indeterminate="true" />
        }
        else if (uploadedFiles.Count == 0)
        {
            <MudAlert Severity="Severity.Info">업로드된 파일이 없습니다.</MudAlert>
        }
        else
        {
            <MudTable Items="@uploadedFiles" Hover="true" Breakpoint="Breakpoint.Sm">
                <HeaderContent>
                    <MudTh>파일명</MudTh>
                    <MudTh>크기</MudTh>
                    <MudTh>사용자</MudTh>
                    <MudTh>업로드 날짜</MudTh>
                    <MudTh>작업</MudTh>
                </HeaderContent>
                <RowTemplate>
                    <MudTd DataLabel="파일명">
                        <MudIcon Icon="@GetFileIcon(context.FileName)" Class="mr-2" />
                        @context.FileName
                    </MudTd>
                    <MudTd DataLabel="크기">@FormatFileSize(context.Size)</MudTd>
                    <MudTd DataLabel="사용자">@uploader</MudTd>
                    <MudTd DataLabel="업로드 날짜">@context.UploadDate.ToString("yyyy-MM-dd HH:mm")</MudTd>
                    <MudTd DataLabel="작업">
                        <MudIconButton Icon="@Icons.Material.Filled.Download"
                                       Color="Color.Primary"
                                       Size="Size.Small"
                                       OnClick="@(() => DownloadFile(context))"
                                       Title="다운로드" />
                        <MudIconButton Icon="@Icons.Material.Filled.Delete"
                                       Color="Color.Error"
                                       Size="Size.Small"
                                       OnClick="@(() => DeleteFile(context))"
                                       Title="삭제" />
                    </MudTd>
                </RowTemplate>
            </MudTable>
        }
    </MudPaper>
</MudContainer>


@code {
    private bool _uploading = false;
    private bool _loading = false;
    private List<FileInfoDto> uploadedFiles = new();
    private long maxFileSize = 10 * 1024 * 1024; // 10MB
    private string uploader = "Unknown";

    public class FileInfoDto
    {
        public string Id { get; set; }
        public string FileName { get; set; }
        public string StoredFileName { get; set; }
        public long Size { get; set; }
        public string ContentType { get; set; }
        public DateTime UploadDate { get; set; }
    }

    protected override async Task OnInitializedAsync()
    {
        await LoadFiles();
        uploader = await GetUploader();
    }

    private async Task LoadFiles()
    {
        _loading = true;
        try
        {
            var response = await Http.GetFromJsonAsync<List<FileInfoDto>>("api/fileupload/list");
            uploadedFiles = response ?? new List<FileInfoDto>();
        }
        catch (Exception ex)
        {
            Snackbar.Add($"파일 목록 로드 실패: {ex.Message}", Severity.Error);
        }
        finally
        {
            _loading = false;
        }
    }


    private async Task OnInputFileChange(IReadOnlyList<IBrowserFile> files)
    {
        _uploading = true;

        foreach (var file in files)
        {
            try
            {
                if (file.Size > maxFileSize)
                {
                    Snackbar.Add($"{file.Name}: 파일 크기는 10MB를 초과할 수 없습니다.", Severity.Warning);
                    continue;
                }

                // MultipartFormDataContent 생성
                using var content = new MultipartFormDataContent();
                var fileContent = new StreamContent(file.OpenReadStream(maxFileSize));
                fileContent.Headers.ContentType = new MediaTypeHeaderValue(file.ContentType);
                content.Add(fileContent, "file", file.Name);

                // API로 파일 업로드
                var response = await Http.PostAsync("api/fileupload/upload", content);

                if (response.IsSuccessStatusCode)
                {
                    Snackbar.Add($"{file.Name} 업로드 성공!", Severity.Success);
                }
                else
                {
                    var error = await response.Content.ReadAsStringAsync();
                    Snackbar.Add($"{file.Name} 업로드 실패: {error}", Severity.Error);
                }
            }
            catch (Exception ex)
            {
                Snackbar.Add($"{file.Name} 업로드 실패: {ex.Message}", Severity.Error);
            }
        }

        _uploading = false;
        await LoadFiles(); // 업로드 후 목록 새로고침
    }

    private async Task DownloadFile(FileInfoDto file)
    {
        try
        {
            var response = await Http.GetAsync($"api/fileupload/download/{file.StoredFileName}");

            if (response.IsSuccessStatusCode)
            {
                var fileBytes = await response.Content.ReadAsByteArrayAsync();
                var fileName = file.FileName;

                // JavaScript를 통해 파일 다운로드
                using var stream = new MemoryStream(fileBytes);
                using var streamRef = new DotNetStreamReference(stream);
                await JS.InvokeVoidAsync("downloadFileFromStream", fileName, streamRef);

                Snackbar.Add("다운로드 완료!", Severity.Success);
            }
            else
            {
                Snackbar.Add("다운로드 실패", Severity.Error);
            }
        }
        catch (Exception ex)
        {
            Snackbar.Add($"다운로드 실패: {ex.Message}", Severity.Error);
        }
    }

    private async Task DeleteFile(FileInfoDto file)
    {
        try
        {
            var response = await Http.DeleteAsync($"api/fileupload/delete/{file.StoredFileName}");

            if (response.IsSuccessStatusCode)
            {
                Snackbar.Add($"{file.FileName} 삭제 완료!", Severity.Success);
                await LoadFiles();
            }
            else
            {
                Snackbar.Add("삭제 실패", Severity.Error);
            }
        }
        catch (Exception ex)
        {
            Snackbar.Add($"삭제 실패: {ex.Message}", Severity.Error);
        }
    }

    private string FormatFileSize(long bytes)
    {
        string[] sizes = { "B", "KB", "MB", "GB" };
        double len = bytes;
        int order = 0;
        while (len >= 1024 && order < sizes.Length - 1)
        {
            order++;
            len = len / 1024;
        }
        return $"{len:0.##} {sizes[order]}";
    }

    private string GetFileIcon(string fileName)
    {
        var extension = Path.GetExtension(fileName).ToLower();
        return extension switch
        {
            ".pdf" => Icons.Material.Filled.PictureAsPdf,
            ".doc" or ".docx" => Icons.Material.Filled.Description,
            ".xls" or ".xlsx" => Icons.Material.Filled.TableChart,
            ".jpg" or ".jpeg" or ".png" or ".gif" => Icons.Material.Filled.Image,
            ".zip" or ".rar" => Icons.Material.Filled.FolderZip,
            ".txt" => Icons.Material.Filled.TextSnippet,
            _ => Icons.Material.Filled.InsertDriveFile
        };
    }

    private async Task<string> GetUploader() {
        var authState = await AuthenticationStateProvider.GetAuthenticationStateAsync();
        var user = authState.User;

        if (user.Identity?.IsAuthenticated == true)
        {
            return user.Identity.Name ?? "Unknown";
        }
        return "Unknown";
    }
}