@page "/"  
@rendermode InteractiveServer
@using Microsoft.EntityFrameworkCore
@using MxTWeb.Models
@using MxTWeb.Data
@using Microsoft.AspNetCore.Authorization
@inject AuthenticationStateProvider AuthStateProvider
@inject NavigationManager Navigation
@implements IAsyncDisposable
@inject IDbContextFactory<MxTWeb.Data.MxTWebContext> DbFactory

<PageTitle>Home</PageTitle>  

<style>
    .stat-container {
        background: transparent;
    }
    
    .stat-card-modern {
        border-radius: 16px;
        transition: all 0.3s ease;
        background: white;
        border: 1px solid rgba(0,0,0,0.08);
    }
    
    .stat-card-modern:hover {
        transform: translateY(-2px);
        box-shadow: 0 8px 16px rgba(0,0,0,0.1) !important;
    }
    
    .stat-card-success {
        background: linear-gradient(135deg, #ffffff 0%, #f1f8f4 100%);
    }
    
    .stat-card-warning {
        background: linear-gradient(135deg, #ffffff 0%, #fff8f0 100%);
    }
    
    .stat-card-error {
        background: linear-gradient(135deg, #ffffff 0%, #fff5f5 100%);
    }
    
    .stat-value-modern {
        font-weight: 700;
        background: linear-gradient(135deg, #594AE2 0%, #8B7FE8 100%);
        -webkit-background-clip: text;
        -webkit-text-fill-color: transparent;
        background-clip: text;
    }
</style>

<AuthorizeView>
    <Authorized>
        <MudText Typo="Typo.h3" Class="ms-1" Style="font-weight: bold">MxT Biotech WMS</MudText>
        <br />

        <MudPaper Elevation="0" Class="stat-container mb-4">
            <MudGrid Spacing="5">
                @if (chipRequestVisibility)
                {
                    <AuthorizeView Roles="칩관리" Context="T">                    
                        <MudItem xs="12" sm="6" md="2">  
                            <MudLink Href="chipusagerequests">
                                <MudPaper Elevation="2" Class="stat-card-modern pa-4" Style="cursor: pointer">
                                    <MudStack Spacing="1" AlignItems="AlignItems.Center">
                                        <MudIcon Icon="@Icons.Material.Filled.DeveloperBoard" Color="Color.Primary" Size="Size.Medium" />
                                        <MudText Typo="Typo.h4" Class="stat-value-modern">@chipRequestCount</MudText>
                                        <MudText Typo="Typo.body2" Color="Color.Primary">칩 제작 신청</MudText>
                                    </MudStack>
                                </MudPaper>
                            </MudLink>
                        </MudItem>                    
                    </AuthorizeView>                    
                }

                @if (cyropreservedRequestVisibility)
                {
                    <AuthorizeView Roles="동결세포" Context="T">
                        <MudItem xs="12" sm="6" md="2">
                            <MudLink Href="cyropreservedrequests">
                                <MudPaper Elevation="2" Class="stat-card-modern pa-4" Style="cursor: pointer">
                                    <MudStack Spacing="1" AlignItems="AlignItems.Center">
                                        <MudIcon Icon="@Icons.Material.Filled.AcUnit" Color="Color.Primary" Size="Size.Medium" />
                                        <MudText Typo="Typo.h4" Class="stat-value-modern">@cyropreservedRequestCount</MudText>
                                        <MudText Typo="Typo.body2" Color="Color.Primary">동결세포 사용 신청</MudText>
                                    </MudStack>
                                </MudPaper>
                            </MudLink>
                        </MudItem>
                    </AuthorizeView>
                }
            </MudGrid>
            <br/>

            <MudGrid Spacing="5">
                <MudItem xs="12" sm="6" md="2">
                    <MudPaper Elevation="2" Class="stat-card-modern stat-card-success pa-4">
                        <MudStack Spacing="1" AlignItems="AlignItems.Center">
                            <MudItem>
                                <MudIcon Icon="@Icons.Material.Filled.Warehouse" Color="Color.Success" Size="Size.Medium" />
                                <MudIcon Icon="@Icons.Material.Filled.TrendingUp" Color="Color.Success" Size="Size.Medium" />
                            </MudItem>
                            <MudText Typo="Typo.h4" Class="stat-value-modern">@weeklyReceiptCount</MudText>
                            <MudText Typo="Typo.body2" Color="Color.Success">금주 부품 입고</MudText>
                        </MudStack>
                    </MudPaper>
                </MudItem>

                <MudItem xs="12" sm="6" md="2">
                    <MudPaper Elevation="2" Class="stat-card-modern stat-card-warning pa-4">
                        <MudStack Spacing="1" AlignItems="AlignItems.Center">
                            <MudItem>
                                <MudIcon Icon="@Icons.Material.Filled.Warehouse" Color="Color.Warning" Size="Size.Medium" />
                                <MudIcon Icon="@Icons.Material.Filled.TrendingDown" Color="Color.Warning" Size="Size.Medium" />
                            </MudItem>
                            <MudText Typo="Typo.h4" Class="stat-value-modern">@weeklyShipmentCount</MudText>
                            <MudText Typo="Typo.body2" Color="Color.Warning">금주 부품 출고</MudText>
                        </MudStack>
                    </MudPaper>
                </MudItem>

                <MudItem xs="12" sm="6" md="2">
                    <MudPaper Elevation="2" Class="stat-card-modern pa-4">
                        <MudStack Spacing="1" AlignItems="AlignItems.Center">
                            <MudItem>
                                <MudIcon Icon="@Icons.Material.Filled.DeveloperBoard" Color="Color.Success" Size="Size.Medium" />
                                <MudIcon Icon="@Icons.Material.Filled.TrendingUp" Color="Color.Success" Size="Size.Medium" />
                            </MudItem>
                            <MudText Typo="Typo.h4" Class="stat-value-modern">@weeklyChipProductionCount</MudText>
                            <MudText Typo="Typo.body2" Color="Color.Success">금주 칩 제작 수</MudText>
                        </MudStack>
                    </MudPaper>
                </MudItem>

                <MudItem xs="12" sm="6" md="2">
                    <MudPaper Elevation="2" Class="stat-card-modern pa-4">
                        <MudStack Spacing="1" AlignItems="AlignItems.Center">
                            <MudItem>
                                <MudIcon Icon="@Icons.Material.Filled.DeveloperBoard" Color="Color.Warning" Size="Size.Medium" />
                                <MudIcon Icon="@Icons.Material.Filled.TrendingDown" Color="Color.Warning" Size="Size.Medium" />
                            </MudItem>                            
                            <MudText Typo="Typo.h4" Class="stat-value-modern" >@weeklyChipUsageCount</MudText>
                            <MudText Typo="Typo.body2" Color="Color.Warning">금주 칩 납품 수</MudText>
                        </MudStack>
                    </MudPaper>
                </MudItem>

                <MudItem xs="12" sm="6" md="2">
                    <MudPaper Elevation="2" Class="stat-card-modern stat-card-error pa-4">
                        <MudStack Spacing="1" AlignItems="AlignItems.Center">
                            <MudIcon Icon="@Icons.Material.Filled.Warning" Color="Color.Error" Size="Size.Medium" />
                            <MudText Typo="Typo.h4" Class="stat-value-modern">@shortageCount</MudText>
                            <MudText Typo="Typo.body2" Color="Color.Error">재고 부족 알림</MudText>
                        </MudStack>
                    </MudPaper>
                </MudItem>
            </MudGrid>
        </MudPaper>


        <MudGrid >
            <MudItem xs="4">
                <MudTable Items="compHistoryData" Bordered="true" Dense="true" Class="pb-1">
                    <ToolBarContent>
                        <MudText Typo="Typo.h6">부품 입·출고 이력</MudText>
                        <MudSpacer />
                        <MudLink Href="histories" Typo="Typo.h6">더 보기</MudLink>
                    </ToolBarContent>
                    <HeaderContent>
                        <MudTh>날짜</MudTh>
                        <MudTh>구분</MudTh>
                        <MudTh>Assembly</MudTh>
                        <MudTh>Description</MudTh>
                        <MudTh>수량</MudTh>
                    </HeaderContent>
                    <RowTemplate Context="x">
                        <MudTd DataLabel="날짜" Style="min-width: 115px">@x.Date?.ToString("yyyy-MM-dd")</MudTd>
                        <MudTd DataLabel="구분" Style="min-width: 68px; padding-right: 0px; padding-left: 10px">
                            <MudChip T="string" Size="Size.Small" Style="@GetStateColor(x.state)">
                                @x.state
                            </MudChip>
                        </MudTd>
                        <MudTd DataLabel="Assembly">@x.Component.Assembly</MudTd>
                        <MudTd DataLabel="Chip 종류">@x.Component.Description</MudTd>
                        <MudTd DataLabel="수량" Style="min-width: 60px">@x.Quantity</MudTd>
                    </RowTemplate>
                </MudTable>
            </MudItem>

            <MudItem xs="4">
                <MudTable Items="chipUsageData" Bordered="true" Dense="true" Class="pb-1">
                    <ToolBarContent>
                        <MudText Typo="Typo.h6">칩 사용 관리대장</MudText>
                        <MudSpacer />
                        <MudLink Href="chipusages" Typo="Typo.h6">더 보기</MudLink>
                    </ToolBarContent>
                    <HeaderContent>
                        <MudTh>날짜</MudTh>
                        <MudTh>구분</MudTh>
                        <MudTh>Chip 종류</MudTh>
                        <MudTh>수량</MudTh>
                    </HeaderContent>
                    <RowTemplate Context="x">                        
                        <MudTd DataLabel="날짜">@x.UseDate?.ToString("yyyy-MM-dd")</MudTd>
                        <MudTd DataLabel="구분" Style="width: 70px; padding-right: 0px; padding-left: 10px">
                            <MudChip T="string" Size="Size.Small" Style="@GetStateColor(x.Division)">
                                @x.Division
                            </MudChip>
                        </MudTd>     
                        <MudTd DataLabel="Chip 종류">@x.Chip</MudTd>
                        <MudTd DataLabel="수량">@x.Production</MudTd>
                    </RowTemplate>
                </MudTable>
            </MudItem>

            <MudItem xs="4">
                <MudTable Items="cyropreservedData" Bordered="true" Dense="true" Class="pb-1">
                    <ToolBarContent>
                        <MudText Typo="Typo.h6">동결세포 목록</MudText>
                        <MudSpacer />
                        <MudLink Href="cyropreserveds" Typo="Typo.h6">더 보기</MudLink>
                    </ToolBarContent>
                    <HeaderContent>
                        <MudTh>반입 날짜</MudTh>
                        <MudTh>🧫세포</MudTh>
                        <MudTh>반입처</MudTh>
                        <MudTh>수량</MudTh>
                    </HeaderContent>
                    <RowTemplate Context="x">
                        <MudTd DataLabel="반입 날짜" Style="min-width: 115px">@x.ReceiptDate?.ToString("yyyy-MM-dd")</MudTd>
                        <MudTd DataLabel="🧫세포" Style="height: 45px">@x.Name</MudTd>
                        <MudTd DataLabel="반입처">@x.Supplier</MudTd>   
                        <MudTd DataLabel="수량" Style="min-width: 60px">@x.Quantity</MudTd>
                    </RowTemplate>
                </MudTable>
            </MudItem>

            <MudItem xs="4">
                <MudTable Items="equipmentData" Bordered="true" Dense="true" Class="pb-1">
                    <ToolBarContent>
                        <MudText Typo="Typo.h6">장비·기기 관리</MudText>
                        <MudSpacer />
                        <MudLink Href="equipments" Typo="Typo.h6">더 보기</MudLink>
                    </ToolBarContent>
                    <HeaderContent>
                        <MudTh>구입일</MudTh>
                        <MudTh>관리번호</MudTh>
                        <MudTh>품명</MudTh>
                    </HeaderContent>
                    <RowTemplate Context="x">
                        <MudTd DataLabel="구입일" Style="min-width: 105px">@x.PurchaseDate?.ToString("yyyy-MM-dd")</MudTd>
                        <MudTd DataLabel="관리번호" Style="height: 45px">@x.ManageCode</MudTd>
                        <MudTd DataLabel="품명">@x.Name</MudTd>                        
                    </RowTemplate>
                </MudTable>
            </MudItem>

            <MudItem xs="4">
                <MudTable Items="reagentData" Bordered="true" Dense="true" Class="pb-1">
                    <ToolBarContent>
                        <MudText Typo="Typo.h6">연구용 시약 관리</MudText>
                        <MudSpacer />
                        <MudLink Href="reagents" Typo="Typo.h6">더 보기</MudLink>
                    </ToolBarContent>
                    <HeaderContent>
                        <MudTh>입고일</MudTh>
                        <MudTh>제품코드</MudTh>
                        <MudTh>🧪시약명</MudTh>
                    </HeaderContent>
                    <RowTemplate Context="x">
                        <MudTd DataLabel="입고일">@x.ReceiptDate?.ToString("yyyy-MM-dd")</MudTd>
                        <MudTd DataLabel="제품코드" Style="height: 45px">@x.Code</MudTd>
                        <MudTd DataLabel="🧪시약명">@x.Name</MudTd>                        
                    </RowTemplate>
                </MudTable>
            </MudItem>

            <MudItem xs="4">
                <MudTable Items="shipmentData" Bordered="true" Dense="true" Class="pb-1">
                    <ToolBarContent>
                        <MudText Typo="Typo.h6">출하 이력 관리</MudText>
                        <MudSpacer />
                        <MudLink Href="shipments" Typo="Typo.h6">더 보기</MudLink>
                    </ToolBarContent>
                    <HeaderContent>
                        <MudTh>납품일</MudTh>
                        <MudTh>품명</MudTh>
                        <MudTh>납품처</MudTh>                        
                    </HeaderContent>
                    <RowTemplate Context="x">
                        <MudTd DataLabel="납품일">@x.Date?.ToString("yyyy-MM-dd")</MudTd>
                        <MudTd DataLabel="품명" Style="height: 45px">@x.Name</MudTd>
                        <MudTd DataLabel="납품처">@x.Destination</MudTd>
                    </RowTemplate>
                </MudTable>
            </MudItem>
        </MudGrid>
    </Authorized>
    <NotAuthorized>
        @{
            Navigation.NavigateTo("/Account/Login", true);
        }
    </NotAuthorized>
</AuthorizeView>

<br />
<br />

@code{
    private MxTWebContext webContext = default!;

    private IQueryable<Cyropreserved>? cyropreservedData;
    private IQueryable<Reagent>? reagentData;
    private IQueryable<Equipment>? equipmentData;
    private IQueryable<ChipUsage>? chipUsageData;
    private IQueryable<CompHistory>? compHistoryData;
    private IQueryable<Shipment>? shipmentData;

    private int weeklyShipmentCount = 0;
    private int weeklyReceiptCount = 0;
    private int weeklyChipProductionCount = 0;
    private int weeklyChipUsageCount = 0;
    private int shortageCount = 0;   

    private int cyropreservedRequestCount = 0;
    private int chipRequestCount = 0;

    private bool cyropreservedRequestVisibility = false;
    private bool chipRequestVisibility = false;

    protected override void OnInitialized()
    {
        webContext = DbFactory.CreateDbContext();

        cyropreservedData = webContext.Cyropreserved.OrderByDescending(x => x.ReceiptDate).Take(10).ToList().AsQueryable();
        reagentData = webContext.Reagent.OrderByDescending(x => x.ReceiptDate).Take(10).ToList().AsQueryable();
        equipmentData = webContext.Equipment.OrderByDescending(x => x.PurchaseDate).Take(10).ToList().AsQueryable();
        chipUsageData = webContext.ChipUsage.OrderByDescending(x => x.UseDate).Take(10).ToList().AsQueryable();
        compHistoryData = webContext.CompHistory.Include(x => x.Component).OrderByDescending(x => x.EntryDate).Take(10).ToList().AsQueryable();
        shipmentData = webContext.Shipment.OrderByDescending(x => x.Date).Take(10).ToList().AsQueryable();

        weeklyShipmentCount = webContext.CompHistory
            .Where(x => x.state == "출고" || x.state == "폐기")
            .Where(x => x.Date >= DateTime.Now.AddDays(-7))
            .Sum(x => x.Quantity);

        weeklyReceiptCount = webContext.CompHistory
            .Where(x => x.state == "입고")
            .Where(x => x.Date >= DateTime.Now.AddDays(-7))
            .Sum(x => x.Quantity);

        weeklyChipProductionCount = webContext.ChipUsage
            .Where(x => x.Division == "제작")
            .Where(x => x.UseDate >= DateTime.Now.AddDays(-7))
            .Sum(x => x.Production);

        weeklyChipUsageCount = webContext.ChipUsage
            .Where(x => x.Division == "납품")
            .Where(x => x.UseDate >= DateTime.Now.AddDays(-7))
            .Sum(x => x.Production);

        shortageCount = webContext.Component.Where(x => x.Stock < x.Quantity).Count();

        cyropreservedRequestCount = webContext.CyropreservedRequest
            .Where(x => x.Status == RequestStatusEnum.Pending).Count();

        chipRequestCount = webContext.ChipUsageRequest
            .Where(x => x.Status == RequestStatusEnum.Pending).Count();

        if (cyropreservedRequestCount > 0)        
            cyropreservedRequestVisibility = true;
        
        if (chipRequestCount > 0)        
            chipRequestVisibility = true;
        
    }

    private string GetStateColor(string state)
    {
        return state switch
        {
            "입고" => "background: #e8f5e9; color: #388e3c;",
            "제작" => "background: #e8f5e9; color: #388e3c;",

            "출고" => "background: #fff3e0; color: #f57c00;",
            "납품" => "background: #fff3e0; color: #f57c00;",

            "폐기" => "background: #ffe9e5; color: #f8766b;",
            "소진" => "background: #ffe9e5; color: #f8766b;",
            _ => "background: #9e9e9e; color: white;"
        };
    }

    public async ValueTask DisposeAsync() => await webContext.DisposeAsync();
}