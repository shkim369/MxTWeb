@page "/reagents/edit"
@using Microsoft.EntityFrameworkCore
@using MxTWeb.Models
@using Microsoft.AspNetCore.Authorization
@attribute [Authorize]
@inject IDbContextFactory<MxTWeb.Data.MxTWebContext> DbFactory
@inject NavigationManager NavigationManager
@inject ISnackbar Snackbar

<EditForm method="post" Model="Reagent" OnValidSubmit="OnValidSubmit" FormName="edit" Enhance>
    <MudDialog>
        <DialogContent>
            <DataAnnotationsValidator />

            <MudGrid Class="mb-5">
                <MudItem xs="12">
                    <MudTextField Variant="Variant.Outlined"
                                  Label="제품코드"
                                  @bind-Value="Reagent.Code" Required="true" Immediate="true" />
                </MudItem>
            </MudGrid>

            <MudGrid Class="mb-5">
                <MudItem xs="12">
                    <MudTextField Variant="Variant.Outlined"
                                  Label="시약명"
                                  @bind-Value="Reagent.Name" Required="true" Immediate="true"/>
                </MudItem>
            </MudGrid>

            <MudGrid Class="mb-5">
                <MudItem xs="12">
                    <MudTextField Variant="Variant.Outlined"
                                  Label="제조사"
                                  @bind-Value="Reagent.Manufacturer" Required="true" Immediate="true"/>
                </MudItem>
            </MudGrid>

            <MudGrid Class="mb-5">
                <MudItem xs="6">
                    <MudTextField Variant="Variant.Outlined"
                                  Label="용량"
                                  @bind-Value="Reagent.Amount" />
                </MudItem>

                <MudItem xs="6">
                    <MudTextField Variant="Variant.Outlined"
                                  Label="Cat"
                                  @bind-Value="Reagent.Cat" />
                </MudItem>
            </MudGrid>

            <MudGrid Class="mb-5">
                <MudItem xs="12">
                    <MudDatePicker Variant="Variant.Outlined"
                                   Label="입고일"
                                   @bind-Date="Reagent.ReceiptDate"
                                   DateFormat="yyyy-MM-dd" />
                </MudItem>

                @* <MudItem xs="6">
                    <MudNumericField Variant="Variant.Outlined"
                                     Label="수량"
                                     @bind-Value="Reagent.Quantity" />
                </MudItem> *@
            </MudGrid>

            @* <MudGrid Class="mb-5">
                <MudItem xs="6">
                    <MudNumericField Variant="Variant.Outlined"
                                     Label="Lot"
                                     @bind-Value="Reagent.Lot" />
                </MudItem>

                <MudItem xs="6">
                    <MudTextField Variant="Variant.Outlined"
                                  Label="보관장소"
                                  @bind-Value="Reagent.Location" />
                </MudItem>
            </MudGrid> *@

        </DialogContent>
        <DialogActions>
            <MudButton Class="mb-5 me-5" ButtonType="ButtonType.Submit" Variant="Variant.Filled"
                       Disabled="@_isProcessing"
                       StartIcon="@(_isProcessing ? Icons.Material.Filled.HourglassEmpty : (action == UIActionEnum.Update ? Icons.Material.Filled.Edit : Icons.Material.Filled.Add))" Color="Color.Info">
                @(action == UIActionEnum.Update ? "Edit" : "ADD")
            </MudButton>
            <MudButton Class="mb-5 me-5" Variant="Variant.Filled" Color="Color.Secondary" OnClick="() => MudDialog.Cancel()">Cancel</MudButton>
        </DialogActions>
    </MudDialog>
</EditForm>

@code {
    [Parameter]
    public UIActionEnum action { get; set; } = UIActionEnum.Insert;

    [SupplyParameterFromQuery]
    private int Id { get; set; }

    [Parameter]
    public Reagent? Reagent { get; set; } = new();

    [CascadingParameter]
    private IMudDialogInstance MudDialog { get; set; }

    private bool _isProcessing = false;

    private async Task OnValidSubmit()
    {
        if (_isProcessing) return;
        _isProcessing = true;

        try
        {
            if (action == UIActionEnum.Insert)
            {
                await AddComponent();
            }
            else if (action == UIActionEnum.Update)
            {
                await UpdateComponent();
            }
        }
        finally
        {
            _isProcessing = false;
        }
    }

    private async Task AddComponent()
    {
        using var context = DbFactory.CreateDbContext();
        context.Reagent.Add(Reagent);
        await context.SaveChangesAsync();

        Snackbar.Add("성공적으로 추가되었습니다.", Severity.Success);
        MudDialog.Close();
    }

    private async Task UpdateComponent()
    {
        using var context = DbFactory.CreateDbContext();
        context.Attach(Reagent!).State = EntityState.Modified;

        try
        {
            await context.SaveChangesAsync();
        }
        catch (DbUpdateConcurrencyException)
        {
            if (!ComponentExists(Reagent!.Id))
            {
                NavigationManager.NavigateTo("notfound");
            }
            else
            {
                throw;
            }
        }

        Snackbar.Add("성공적으로 수정되었습니다.", Severity.Success);
        MudDialog.Close();
    }

    private bool ComponentExists(int id)
    {
        using var context = DbFactory.CreateDbContext();
        return context.Reagent.Any(e => e.Id == id);
    }

    protected override async Task OnInitializedAsync()
    {
        if (action == UIActionEnum.Insert)
        {
            Reagent.ReceiptDate = DateTime.Today;
        }
        else if (action == UIActionEnum.Update)
        {
            using var context = DbFactory.CreateDbContext();
            Reagent ??= await context.Reagent.FirstOrDefaultAsync(m => m.Id == Id);

            if (Reagent is null)
            {
                NavigationManager.NavigateTo("notfound");
            }
        }

        //await LoadAutoComplete();
    }
}
