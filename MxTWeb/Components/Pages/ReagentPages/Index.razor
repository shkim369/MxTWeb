@page "/reagents"
@rendermode InteractiveServer
@using Microsoft.EntityFrameworkCore
@using Microsoft.AspNetCore.Components.QuickGrid
@using MxTWeb.Models
@using MxTWeb.Data
@implements IAsyncDisposable
@inject IDbContextFactory<MxTWeb.Data.MxTWebContext> DbFactory

<PageTitle>연구용 시약 목록</PageTitle>

<h1>연구용 시약 목록</h1>

<br />
<div class="dropdown">
    <button class="btn btn-outline-secondary dropdown-toggle" type="button" data-bs-toggle="dropdown" aria-expanded="false">
        @SearchField
    </button>
    <ul class="dropdown-menu">
        <li><a class="dropdown-item" @onclick="@(() => SelectItem("제품코드"))">제품코드</a></li>
        <li><a class="dropdown-item" @onclick="@(() => SelectItem("시약명"))">시약명</a></li>
        <li><a class="dropdown-item" @onclick="@(() => SelectItem("제조사"))">제조사</a></li>
    </ul>

    <input type="search" @bind="SearchFilter" @bind:event="onchange" placeholder="검색어 입력" pattern="[A-Za-z0-9\s]*"
           style="width:300px; margin-top:20px;" />

    <i class="bi bi-search"></i> Search
</div>
<br />
<p>
    <a href="reagents/create" class="btn btn-outline-secondary">Create New</a>
</p>

<div>
    <QuickGrid Class="table" Items="FilteredReagents" Pagination="pagination">
        <PropertyColumn Property="reagent => reagent.Code" Title="제품코드" Align="Align.Center" Sortable="true"/>
        <PropertyColumn Property="reagent => reagent.Name" Title="🧪시약명" Align="Align.Center" Sortable="true"/>
        <PropertyColumn Property="reagent => reagent.Manufacturer" Title="제조사" Align="Align.Center" />
        <PropertyColumn Property="reagent => reagent.Amount" Title="용량" Align="Align.Center" />
        <PropertyColumn Property="reagent => reagent.Cat" Title="Cat. No." Align="Align.Center" />

        <TemplateColumn Context="reagent">
            <a href="@($"reagents/edit?id={reagent.Id}")" class="btn btn-primary px-4">Edit</a>
            <a href="@($"reagents/delete?id={reagent.Id}")" class="btn btn-danger">Delete</a>
        </TemplateColumn>
    </QuickGrid>
</div>

<Paginator State="pagination" />

@code {

    private MxTWebContext context = default!;

    private PaginationState pagination = new PaginationState { ItemsPerPage = 15 };

    private string SearchFilter = string.Empty;
    private string SearchField = "시약명"; // Default search field

    private void SelectItem(string item)
    {
        SearchField = item;
    }

    private IQueryable<Reagent> FilteredReagents => GetFilteredData();

    private IQueryable<Reagent> GetFilteredData()
    {
        return SearchField switch
        {
            "제품코드" => context.Reagent.Where(m => m.Code!.Contains(SearchFilter)),
            "시약명" => context.Reagent.Where(m => m.Name!.ToString().Contains(SearchFilter)),
            "제조사" => context.Reagent.Where(m => m.Manufacturer!.Contains(SearchFilter)),
            _ => context.Reagent.Where(m => m.Name!.Contains(SearchFilter))
        };
    }

    protected override void OnInitialized()
    {
        context = DbFactory.CreateDbContext();
    }

    public async ValueTask DisposeAsync() => await context.DisposeAsync();
}
