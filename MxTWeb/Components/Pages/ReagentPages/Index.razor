@page "/reagents"
@rendermode InteractiveServer
@using Microsoft.EntityFrameworkCore
@using Microsoft.AspNetCore.Components.QuickGrid
@using MxTWeb.Models
@using MxTWeb.Data
@implements IAsyncDisposable
@inject IDbContextFactory<MxTWeb.Data.MxTWebContext> DbFactory

<PageTitle>연구용 시약 목록</PageTitle>

<h1>연구용 시약 목록</h1>

<br />
<div class="dropdown">
    <button class="btn btn-outline-secondary dropdown-toggle" type="button" data-bs-toggle="dropdown" aria-expanded="false">
        @SearchField
    </button>
    <ul class="dropdown-menu">
        <li><a class="dropdown-item" @onclick="@(() => SelectItem("제품코드"))">제품코드</a></li>
        <li><a class="dropdown-item" @onclick="@(() => SelectItem("시약명"))">시약명</a></li>
        <li><a class="dropdown-item" @onclick="@(() => SelectItem("제조사"))">제조사</a></li>
    </ul>

    <input type="search" @bind="SearchFilter" @bind:event="oninput" placeholder="검색어 입력" pattern="[A-Za-z0-9\s]*"
           style="width:300px; margin-top:20px;" />

    <i class="bi bi-search"></i> Search
</div>
<br />

<p>
    <a href="reagents/create" class="btn btn-outline-secondary">Create New</a>
</p>

<div>
     <QuickGrid Class="table table-bordered table-sm" Items="FilteredData.AsQueryable()" Pagination="pagination">
        <PropertyColumn Property="reagent => reagent.Code" Title="관리번호" Sortable="true"/>
        <PropertyColumn Property="reagent => reagent.Name" Title="🧪시약명" Sortable="true"/>
        <PropertyColumn Property="reagent => reagent.Manufacturer" Title="제조사" Sortable="true"/>
        <PropertyColumn Property="reagent => reagent.Amount" Title="용량"/>
        <PropertyColumn Property="reagent => reagent.Cat" Title="Cat.No."/>
        <PropertyColumn Property="reagent => reagent.ReceiptDate" Title="입고일" Sortable="true"/>
        <PropertyColumn Property="reagent => reagent.Quantity" Title="수량"/>
        <PropertyColumn Property="reagent => reagent.Lot" Title="Lot.number"/>
        <PropertyColumn Property="reagent => reagent.Location" Title="보관위치" Sortable="true"/>

        <TemplateColumn Context="reagent">
            <a href="@($"reagents/edit?id={reagent.Id}")" class="btn btn-primary px-4">Edit</a>
            <a href="@($"reagents/delete?id={reagent.Id}")" class="btn btn-danger">Delete</a>
        </TemplateColumn>
    </QuickGrid>
</div>

<Paginator State="pagination" />

@code {
    private MxTWebContext context = default!;

    private PaginationState pagination = new PaginationState { ItemsPerPage = 15 };

    private readonly SemaphoreSlim _searchSemaphore = new(1, 1);
    private CancellationTokenSource? _searchCts;
    private List<Reagent> _filteredResults = new();

    private string SearchField = "시약명"; // 기본 검색 항목
    private string _searchFilter = "";
    private string SearchFilter
    {
        get => _searchFilter;
        set
        {
            _searchFilter = value;
            _ = PerformSearchAsync();
        }
    }
    private IEnumerable<Reagent> FilteredData => _filteredResults;

    private async Task PerformSearchAsync()
    {
        // 동시 실행 방지 // available semaphore가 없으면 바로 return
        if (!await _searchSemaphore.WaitAsync(0)) return;

        try
        {
            _searchCts?.Cancel();
            _searchCts = new CancellationTokenSource();

            using var context = DbFactory.CreateDbContext();

            var query = SearchField switch
            {
                "제품코드" => context.Reagent.Where(m => m.Code!.Contains(SearchFilter)),
                "시약명" => context.Reagent.Where(m => m.Name!.ToString().Contains(SearchFilter)),
                "제조사" => context.Reagent.Where(m => m.Manufacturer!.Contains(SearchFilter)),
                _ => context.Reagent.Where(m => m.Name!.ToString().Contains(SearchFilter))
            };

            _filteredResults = await query.ToListAsync(_searchCts.Token);
            await InvokeAsync(StateHasChanged);
        }
        catch (OperationCanceledException) { }
        finally
        {
            _searchSemaphore.Release();
        }
    }

    private void SelectItem(string item)
    {
        SearchField = item;
    }

    protected override void OnInitialized()
    {
        context = DbFactory.CreateDbContext();
        _filteredResults = context.Reagent.ToList();
    }

    public async ValueTask DisposeAsync() => await context.DisposeAsync();
}
