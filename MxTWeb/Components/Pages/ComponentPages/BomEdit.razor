@page "/components/edit3"
@using Microsoft.EntityFrameworkCore
@using MxTWeb.Models
@using MxTWeb.Enums
@using Microsoft.AspNetCore.Authorization
@attribute [Authorize]
@inject IDbContextFactory<MxTWeb.Data.MxTWebContext> DbFactory
@inject NavigationManager NavigationManager
@inject IDialogService DialogService
@inject ISnackbar Snackbar

<style>
    .custom-grid .mud-table-cell .column-header .column-options .mud-menu .mud-icon-button-label {
        display: none !important;
        visibility: hidden !important;
    }

    .custom-grid .mud-table-cell .column-header .column-options .mud-menu {
        display: none !important;
        visibility: hidden !important;
        width: 0px !important;
    }

    .custom-grid .mud-table-cell {
        padding-right: 15px !important;
    }
</style>

<MudDialog Style="width: 50%">
    <DialogContent>   
        <MudDataGrid T="Bom" Class="custom-grid" SortMode="SortMode.Single"
                     Style="white-space: nowrap" Hover="true" Bordered="true" Striped="true" RowsPerPage="100"
                     EditMode="DataGridEditMode.Cell" ReadOnly="false" Dense="true"
                     MultiSelection="false" @bind-SelectedItem="selectedItem" SelectOnRowClick="false"
                     CommittedItemChanges="@CommittedItemChanges" Items="BomList.AsQueryable()">
            <ToolBarContent>
                <MudButton OnClick="@(() => AddBomData())" Variant="Variant.Filled" Color="@Color.Success" StartIcon="@Icons.Material.Filled.Add"
                           Class="add-item-btn">Add New</MudButton>
                <MudButton Class="ms-5" Style="width: 120px;" Variant="Variant.Filled" Color="Color.Info" Disabled="IsLoadDisabled"
                           StartIcon="@Icons.Material.Filled.Download" OnClick="LoadBomData">Load</MudButton>
            </ToolBarContent>
            <Columns>
                <SelectColumn T="Bom" />
                <PropertyColumn Property="x => x.ProductName" Title="Product Name" Editable="true" InitialDirection="SortDirection.Ascending"/>
                <PropertyColumn Property="x => x.BomVersion" Title="Bom Version" Editable="true" />
                <PropertyColumn Property="x => x.CreatedAt" Title="Created Date" Editable="false" Format="yyyy-MM-dd"/>

                <TemplateColumn Context="x" Editable="false">
                    <CellTemplate>
                        <MudIconButton Size="@Size.Small" Variant="Variant.Filled" Icon="@Icons.Material.Filled.Delete"
                                       Color="@Color.Error" OnClick="@(() => DeleteBomData(x.Item))" />
                    </CellTemplate>
                </TemplateColumn>
            </Columns>
        </MudDataGrid>
        <br />
    </DialogContent>
</MudDialog>

@code {
    private MxTWebContext context = default!;

    private Bom selectedItem = new();
    private bool IsLoadDisabled => selectedItem == null || selectedItem.BomId == 0;

    [CascadingParameter]
    private IMudDialogInstance MudDialog { get; set; }

    private IEnumerable<Bom> BomList = new List<Bom>();

    protected override async Task OnInitializedAsync()
    {
        context = DbFactory.CreateDbContext();
        BomList = context.Bom.OrderBy(b => b.ProductName).ToList();
    }

    private Task<DataGridEditFormAction> CommittedItemChanges(Bom item)
    {
        using var context = DbFactory.CreateDbContext();
        context.Attach(item!).State = EntityState.Modified;
        context.SaveChangesAsync();

        return Task.FromResult(DataGridEditFormAction.Close);
    }

    private async Task AddBomData()
    {
        using var context = DbFactory.CreateDbContext();

        var newBom = new Bom();
        newBom = new Bom
        {
            ProductName = "Product",
            BomVersion = "Version",
            CreatedAt = DateTime.UtcNow
        };
        context.Bom.Add(newBom);
        await context.SaveChangesAsync();

        BomList = context.Bom.OrderBy(b => b.ProductName).ToList();
    }

    private async Task DeleteBomData(Bom bom)
    {
        var parameters = new DialogParameters<BomDelete>
        {
            { x => x.bom, bom },
        };

        var options = new DialogOptions { MaxWidth = MaxWidth.Large, BackdropClick = false, CloseOnEscapeKey = true };
        var dialog = await DialogService.ShowAsync<BomDelete>("Delete Data", parameters, options);
        var result = await dialog.Result;

        if (result is not null && !result.Canceled)
        {
            BomList = context.Bom.OrderBy(b => b.ProductName).ToList();
        }
    }

    private async Task LoadBomData()
    {
        DialogResult dialogResult = DialogResult.Ok(selectedItem);
        MudDialog.Close(dialogResult);
    }
}
