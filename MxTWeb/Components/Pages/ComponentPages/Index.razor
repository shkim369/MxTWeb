@page "/components"
@rendermode InteractiveServer
@using Microsoft.EntityFrameworkCore
@using MxTWeb.Models
@using MxTWeb.Data
@using MxTWeb.Enums
@using Microsoft.AspNetCore.Authorization
@attribute [Authorize]
@implements IAsyncDisposable
@inject IDbContextFactory<MxTWeb.Data.MxTWebContext> DbFactory
@inject IDialogService DialogService
@inject ISnackbar Snackbar

<PageTitle>부품 재고 관리</PageTitle>

<style>
    .custom-grid .mud-table-cell .column-header .column-options .mud-menu .mud-icon-button-label {
        display: none !important;
        visibility: hidden !important;
    }

    .custom-grid .mud-table-cell .column-header .column-options .mud-menu {
        display: none !important;
        visibility: hidden !important;
        width: 0px !important;
    }

    .custom-grid .mud-table-cell {
        padding-right: 15px !important;
    }
</style>

<h2>부품 재고 관리</h2>
<br/>

<MudTabs Elevation="2" Rounded="true" ApplyEffectsToContainer="true" ActivePanelIndexChanged="OnTabChanged">
    <MudTabPanel Text="재고 현황">
        <MudGrid Spacing="5" Style="margin-top: 0px; margin-bottom: 10px">

            <MudItem>
                <MudButton Class="ms-5 me-2" OnClick="@ExpandAllGroupsAsync" Variant="Variant.Outlined" Color="@Color.Primary">펼치기</MudButton>
            </MudItem>
            <MudItem>
                <MudButton Class="me-2" OnClick="@CollapseAllGroupsAsync" Variant="Variant.Outlined" Color="@Color.Primary">접기</MudButton>
            </MudItem>

            <MudItem>
                <MudButton Class="me-2" @onclick="CreateNew" Variant="Variant.Filled" Color="Color.Primary" StartIcon="@Icons.Material.Filled.Add">
                    Add New
                </MudButton>
            </MudItem>
            <MudItem>
                <MudButton Class="me-2" Variant="Variant.Filled" StartIcon="@Icons.Material.Filled.Edit"
                           Color="@Color.Info" OnClick="@UpdateData" Disabled="@IsEditDisabled"> Edit </MudButton>
            </MudItem>
            <MudItem>
                <MudButton Class="me-2" Variant="Variant.Filled" StartIcon="@Icons.Material.Filled.Delete"
                           Color="@Color.Error" OnClick="@DeleteData" Disabled="@IsEditDisabled"> Delete </MudButton>
            </MudItem>

            <MudSpacer />
            <MudMenu Class="mt-3" Label="@searchField" Variant="Variant.Filled" EndIcon="@Icons.Material.Filled.KeyboardArrowDown" IconColor="Color.Secondary">
                <MudMenuItem Label="Part Number" @onclick="@(() => SelectSearchField("Part Number"))" />
                <MudMenuItem Label="날짜" @onclick="@(() => SelectSearchField("날짜"))" />
            </MudMenu>
            &nbsp&nbsp&nbsp&nbsp
            <MudTextField Class="mt-5 pe-5" @bind-Value="searchFilter" Placeholder="Search" Adornment="Adornment.Start" Immediate="true"
                          AdornmentIcon="@Icons.Material.Filled.Search" IconSize="Size.Medium"/>
        </MudGrid>

        <MudDataGrid T="Component" Class="custom-grid" Items="@FilteredData" @ref="_dataGrid"
                     SortMode="SortMode.Single" Dense="true" Style="white-space: nowrap" Hover="true" Bordered="true" Striped="true"
                     EditMode="DataGridEditMode.Cell" ReadOnly="false" Groupable="true" GroupClass="pa-3"
                     CommittedItemChanges="@CommittedItemChanges" ColumnResizeMode="ResizeMode.Column"
                     RowsPerPage="1000" SelectOnRowClick="false" 
                     MultiSelection="false" @bind-SelectedItem="selectedItem"
                     QuickFilter="@_quickFilter"
                     Loading="@isLoading">
            <ColGroup>
                <col style="width: 0;" />
                <col style="width: 13%;" />
                <col style="width: 14%;" />
                <col style="width: 18%;" />
                <col style="width: 5%;" />
                <col style="width: 10%;" />
                <col style="width: 5%;" />
                <col style="width: 6%;" />
                <col style="width: 6%;" />
                <col />
                <col style="width: 0;" />
            </ColGroup>

            <Columns>
                <SelectColumn T="Component" />
                <PropertyColumn Property="x => x.Assembly" Title="Assembly" Sortable="true" 
                                Grouping="true" GroupExpanded="true" GroupByOrder="2">
                    <GroupTemplate>
                        <span style="font-weight:bold">@context.Title: @(context.Grouping.Key)</span>
                    </GroupTemplate>
                </PropertyColumn>
                <PropertyColumn Property="x => x.PartNumber" Title="Part Number" sortable="true" InitialDirection="SortDirection.Ascending"/>
                <PropertyColumn Property="x => x.Description" Title="Description" Sortable="false" Required="false" Resizable="true"/>
                <PropertyColumn Property="x => x.Category" Title="Category" sortable="true" Required="false" Resizable="true" />
                <PropertyColumn Property="x => x.Seller" Title="Seller" sortable="true" Required="false" Resizable="true"/>
                <PropertyColumn Property="x => x.LeadTime" Title="Lead" sortable="false" Required="false" Resizable="true"/>
                <PropertyColumn Property="x => x.Required" Title="Q'ty" sortable="false" Resizable="true" />
                <PropertyColumn Property="x => x.Stock" Title="Stock" sortable="false" Resizable="true" 
                                CellStyleFunc="@_cellStyleFunc" />  
                <PropertyColumn Property="x => x.Note" Title="Comment" sortable="false" Required="false" Resizable="true" />

                <TemplateColumn Context="x" Resizable="false" Editable="false" Sortable="false" Title="➕">
                    <CellTemplate>
                        <MudIconButton Class="ms-0 me-3" Size="@Size.Small" Variant="Variant.Filled" Icon="@Icons.Material.Filled.Add"
                                       Color="@Color.Tertiary" OnClick="@(() => this.CreateNew2(x))" />
                    </CellTemplate>
                </TemplateColumn>
            </Columns>
 
        </MudDataGrid>
    </MudTabPanel>

    <MudTabPanel Text="입·출고 이력 관리">
        <MudGrid Spacing="5" Style="margin-top: 0px; margin-bottom: 10px">
            <MudItem>
                <MudButton Class="ms-5 me-2" OnClick="CreateNew2" Variant="Variant.Filled" Color="Color.Primary" StartIcon="@Icons.Material.Filled.Add">
                    Add New
                </MudButton>
            </MudItem>
            <MudItem>
                <MudButton Class="me-2" Variant="Variant.Filled" StartIcon="@Icons.Material.Filled.Build"
                           Color="@Color.Tertiary" OnClick="@StockComsumption">
                    @if (isProcessing)
                    {
                        <MudProgressCircular Indeterminate="true" Color="Color.Info" Size="Size.Small" Class="me-2" />
                        <MudText Class="ms-2">Processing...</MudText>
                    }
                    else
                    {
                        <MudText>일괄 소진</MudText>
                    }
                </MudButton>
            </MudItem>

            <MudSpacer />
            <MudMenu Class="mt-3" Label="@searchField2" Variant="Variant.Filled" EndIcon="@Icons.Material.Filled.KeyboardArrowDown" IconColor="Color.Secondary">
                <MudMenuItem Label="Part Number" @onclick="@(() => SelectSearchField2("Part Number"))" />
                <MudMenuItem Label="날짜" @onclick="@(() => SelectSearchField2("날짜"))" />
            </MudMenu>
            &nbsp&nbsp&nbsp&nbsp
            <MudTextField Class="mt-5 pe-5" @bind-Value="searchFilter2" Placeholder="Search" Adornment="Adornment.Start" Immediate="true"
                          AdornmentIcon="@Icons.Material.Filled.Search" IconSize="Size.Medium" />
        </MudGrid>

        <MudDataGrid T="CompHistory" Class="custom-grid" SortMode="SortMode.Single" Items="@FilteredData2"
                     Dense="true" Style="white-space: nowrap" Hover="true" Bordered="true" Striped="true"                     
                     RowsPerPage="100" SelectOnRowClick="false" QuickFilter="_quickFilter2" >
            <Columns>
                <PropertyColumn Property="x => x.Date" Title="날짜" Sortable="true" Format="yyyy-MM-dd"/>
                <PropertyColumn Property="x => x.Component.Assembly" Title="Assembly" Sortable="true" />
                <PropertyColumn Property="x => x.PartNumber" Title="Part Number" Sortable="true" />
                <PropertyColumn Property="x => x.Component.Description" Title="Description" Sortable="false" />
                <PropertyColumn Property="x => x.state" Title="구분" Sortable="true" CellStyleFunc="@_cellStyleFunc2"/>
                <PropertyColumn Property="x => x.Quantity" Title="수량" Sortable="false" />
                <PropertyColumn Property="x => x.Component.Stock" Title="재고" Sortable="false" />
                <PropertyColumn Property="x => x.Account" Title="입력 계정" Sortable="true" />
                <PropertyColumn Property="x => x.EntryDate" Title="입력 일시" Sortable="true" SortBy="@(x => x.EntryDate)"
                                InitialDirection="SortDirection.Descending" Format="yyyy-MM-dd HH:mm" />

                <TemplateColumn Context="x">
                    <CellTemplate>
                        <MudIconButton Class="ms-0 me-3" Size="@Size.Small" Variant="Variant.Filled" Icon="@Icons.Material.Filled.Edit"
                                       Color="@Color.Info" OnClick="@(() => this.UpdateData2(x))" />
                        <MudIconButton Class="ms-0 me-0" Size="@Size.Small" Variant="Variant.Filled" Icon="@Icons.Material.Filled.Delete"
                                       Color="@Color.Error" OnClick="@(() => this.DeleteData2(x.Item))"/>
                    </CellTemplate>
                </TemplateColumn>
            </Columns>
            <PagerContent>
                <MudDataGridPager />
            </PagerContent>
        </MudDataGrid>
    </MudTabPanel>

    <MudTabPanel Text="E-BOM" Visible="false">
        <MudGrid Spacing="5" Style="margin-top: 0px; margin-bottom: 10px">
            <MudItem>
                <MudButton Class="ms-5 me-2" @onclick="CreateNew" Variant="Variant.Filled" Color="Color.Primary" StartIcon="@Icons.Material.Filled.Add">
                    Add New
                </MudButton>
            </MudItem>
            <MudItem>
                <MudButton Class="me-2" Variant="Variant.Filled" StartIcon="@Icons.Material.Filled.Edit"
                           Color="@Color.Info" OnClick="@UpdateData"> Edit </MudButton>
            </MudItem>
            <MudItem>
                <MudButton Class="me-2" Variant="Variant.Filled" StartIcon="@Icons.Material.Filled.Delete"
                           Color="@Color.Error" OnClick="@DeleteData"> Delete </MudButton>
            </MudItem>
            <MudSpacer />
            <MudMenu Class="mt-3" Label="@searchField" Variant="Variant.Filled" EndIcon="@Icons.Material.Filled.KeyboardArrowDown" IconColor="Color.Secondary">              
                <MudMenuItem Label="Part Number" @onclick="@(() => SelectSearchField2("Part Number"))" />
                <MudMenuItem Label="날짜" @onclick="@(() => SelectSearchField2("날짜"))" />
            </MudMenu>
            &nbsp&nbsp&nbsp&nbsp
            <MudTextField Class="mt-5 pe-5" @bind-Value="searchFilter" Placeholder="Search" Adornment="Adornment.Start" Immediate="true"
                          AdornmentIcon="@Icons.Material.Filled.Search" IconSize="Size.Medium" />
        </MudGrid>
            <MudDataGrid T="Component" Class="custom-grid" SortMode="SortMode.Single" Items="@FilteredData"
                     Dense="true" Hover="true" Bordered="true" Striped="true" SelectOnRowClick="false"
                     MultiSelection="false" SelectedItem="@selectedItem" SelectedItemsChanged="@(_ => StateHasChanged())">

            <ToolBarContent>
                <MudGrid Spacing="5" />
            </ToolBarContent>

            <Columns>
                <PropertyColumn Property="x => x.Assembly" Title="Assembly" Sortable="true" />
                <PropertyColumn Property="x => x.PartNumber" Title="Part Number" Sortable="true" InitialDirection="SortDirection.Ascending" />
                <PropertyColumn Property="x => x.Description" Title="Description" />
                <PropertyColumn Property="x => x.Model" Title="Model" />
                <PropertyColumn Property="x => x.Origin" Title="Origin" />
                <PropertyColumn Property="x => x.Quantity" Title="Q'ty" />
                <PropertyColumn Property="x => x.Price" Title="Price" />
                <PropertyColumn Property="x => x.TotalPrice" Title="Total" />
                <PropertyColumn Property="x => x.Category" Title="Category" sortable="true" />
                <PropertyColumn Property="x => x.Maker" Title="Maker" sortable="true" />
                <PropertyColumn Property="x => x.Seller" Title="Seller" />
                <PropertyColumn Property="x => x.LeadTime" Title="Lead" sortable="false" />
                <PropertyColumn Property="x => x.Note" Title="비고" sortable="false" />
            </Columns>

            <PagerContent>
                <MudDataGridPager />
            </PagerContent>
        </MudDataGrid>
    </MudTabPanel>
</MudTabs>

<br />

@code {
    private MxTWebContext context = default!;

    private string searchField = "Assembly";
    private string searchFilter;

    private string searchField2 = "Part Number";
    private string searchFilter2;

    private IEnumerable<Component> FilteredData = new List<Component>();
    private IEnumerable<CompHistory> FilteredData2 = new List<CompHistory>();
    private Component selectedItem = new();
    private bool IsEditDisabled => selectedItem == null || selectedItem.Id == 0;

    private bool isProcessing = false;
    private bool isLoading = true;

    private MudDataGrid<Component> _dataGrid = null!;

    private async Task CreateNew()
    {
        var parameters = new DialogParameters<Edit>
        {
            { x => x.action, UIActionEnum.Insert }
        };

        var options = new DialogOptions { MaxWidth = MaxWidth.Large };
        var dialog = await DialogService.ShowAsync<Edit>("Add New Component", parameters, options);
        var result = await dialog.Result;

        if (result is not null && !result.Canceled)
        {
            FilteredData = context.Component.ToList();
            StateHasChanged();
        }  
    }

    private async Task UpdateData()
    {
        var parameters = new DialogParameters<Edit>
        {
            { x => x.action, UIActionEnum.Update },
            { x => x.Component, selectedItem } // 선택된 row의 데이터를 직접 전달
        };

        var options = new DialogOptions { MaxWidth = MaxWidth.Large };
        var dialog = await DialogService.ShowAsync<Edit>("Edit Component", parameters, options);
        var result = await dialog.Result;

        if (result is not null && !result.Canceled)
        {
            FilteredData = context.Component.ToList();
            StateHasChanged();
        }    
    }

    private async Task CreateNew2()
    {
        var parameters = new DialogParameters<Edit2>
        {
            { x => x.action, UIActionEnum.Insert }
        };

        var options = new DialogOptions { MaxWidth = MaxWidth.Large };
        var dialog = await DialogService.ShowAsync<Edit2>("Add New History", parameters, options);
        var result = await dialog.Result;

        if (result is not null && !result.Canceled)
        {
            context = DbFactory.CreateDbContext();
            FilteredData = await context.Component.ToListAsync();
            FilteredData2 = await context.CompHistory.ToListAsync();
            StateHasChanged();
        }
    }

    private async Task CreateNew2(CellContext<Component> data)
    {
        var parameters = new DialogParameters<Edit2>
        {
            { x => x.action, UIActionEnum.Insert },
            { x => x.Component, data.Item }
        };

        var options = new DialogOptions { MaxWidth = MaxWidth.Large };
        var dialog = await DialogService.ShowAsync<Edit2>("Add New History", parameters, options);
        var result = await dialog.Result;

        if (result is not null && !result.Canceled)
        {
            context = DbFactory.CreateDbContext();
            FilteredData = await context.Component.ToListAsync();
            FilteredData2 = await context.CompHistory.ToListAsync();
            StateHasChanged();
        }
    }

    private async Task UpdateData2(CellContext<CompHistory> data)
    {
        var parameters = new DialogParameters<Edit2>
        {
            { x => x.action, UIActionEnum.Update },
            { x => x.CompHistory, data.Item }
        };

        var options = new DialogOptions { MaxWidth = MaxWidth.Large };
        var dialog = await DialogService.ShowAsync<Edit2>("Edit History", parameters, options);
        var result = await dialog.Result;

        if (result is not null && !result.Canceled)
        {
            context = DbFactory.CreateDbContext();
            FilteredData = await context.Component.ToListAsync();
            FilteredData2 = await context.CompHistory.ToListAsync();
            StateHasChanged();
        }   
    }

    private async Task DeleteData()
    {
        var parameters = new DialogParameters<Delete>
        {
            { x => x.component, selectedItem } // 선택된 row의 데이터를 직접 전달
        };

        var options = new DialogOptions { MaxWidth = MaxWidth.Large };
        var dialog = await DialogService.ShowAsync<Delete>("Delete Data", parameters, options);
        var result = await dialog.Result;

        if (result is not null && !result.Canceled)
        {
            selectedItem = new();
            FilteredData = context.Component.ToList();
            StateHasChanged();
        }
    }

    private async Task DeleteData2(CompHistory data)
    {
        using var context = DbFactory.CreateDbContext();
        using var transaction = await context.Database.BeginTransactionAsync();
        try
        {
            context.CompHistory.Remove(data!);
            await context.SaveChangesAsync();
            await transaction.CommitAsync();

            FilteredData2 = context.CompHistory.ToList();
        }
        catch
        {
            await transaction.RollbackAsync();
            throw;
        }
    }

    private async Task StockComsumption()
    {
        var options = new DialogOptions { MaxWidth = MaxWidth.Large };
        var dialog = await DialogService.ShowAsync<Consume>("Info", options);
        var result = await dialog.Result;

        if (result is not null && !result.Canceled)
        {
            isProcessing = true;

            context.ChangeTracker.Clear();
            FilteredData = context.Component.ToList();
            StateHasChanged();

            isProcessing = false;
        }   
    }

    private Func<Component, bool> _quickFilter => x =>
    {
        if (string.IsNullOrWhiteSpace(searchFilter))
            return true;

        else
        {
            switch (searchField)
            {
                case "Assembly":
                    if (x.Assembly.Contains(searchFilter, StringComparison.OrdinalIgnoreCase))
                        return true;
                    break;

                case "Part Number":
                    if (x.PartNumber.Contains(searchFilter, StringComparison.OrdinalIgnoreCase))
                        return true;
                    break;

                default:
                    break;
            }

        }

        return false;
    };

    private Func<CompHistory, bool> _quickFilter2 => x =>
    {
        if (string.IsNullOrWhiteSpace(searchFilter2))
            return true;

        else
        {
            switch (searchField2)
            {
                case "Part Number":
                    if (x.PartNumber.Contains(searchFilter2, StringComparison.OrdinalIgnoreCase))
                        return true;
                    break;

                case "날짜":
                    if (x.Date.GetValueOrDefault().ToString("yyyy-MM-dd").Contains(searchFilter2, StringComparison.OrdinalIgnoreCase))
                        return true;
                    break;
                default:
                    break;
            }
        }

        return false;
    };

    private async Task CommittedItemChanges(Component item)
    {
        using var context = DbFactory.CreateDbContext();
        context.Attach(item!).State = EntityState.Modified;
        await context.SaveChangesAsync();
    }

    private void OnTabChanged(int index)
    {
        if (index == 0)
        {
            searchField = "Assembly";
            searchFilter = string.Empty;
        }
        else if (index == 1)
        {
            searchField2 = "Part Number";
            searchFilter2 = string.Empty;
            FilteredData2 = context.CompHistory.OrderByDescending(c => c.EntryDate).ToList();
            //StateHasChanged();
        }
    }

    protected override async Task OnInitializedAsync()
    {
        isLoading = true;

        context = DbFactory.CreateDbContext();
        FilteredData = await context.Component.ToListAsync();
        FilteredData2 = await context.CompHistory.Include(c => c.Component).ToListAsync();

        isLoading = false;
    }

    private void SelectSearchField(string item)
    {
        searchField = item;
    }
    private void SelectSearchField2(string item)
    {
        searchField2 = item;
    }

    private Func<Component, string> _cellStyleFunc => x =>
    {
        string style = "";

        if (x.Stock < x.Required)
            style += "background-color:#F8766B";
        else if (x.Stock < x.Required * 2)
            style += "background-color:#F3D86C";

        return style;
    };

    private Func<CompHistory, string> _cellStyleFunc2 => x =>
    {
        string style = "";

        if (x.state == "입고")
            style += "background-color:#D9EAD3";
        else if (x.state == "출고")
            style += "background-color:#F9CB9C";

        return style;
    };

    private Task ExpandAllGroupsAsync()
    {
        return _dataGrid.ExpandAllGroupsAsync();
    }

    private Task CollapseAllGroupsAsync()
    {
        return _dataGrid.CollapseAllGroupsAsync();
    }

    public async ValueTask DisposeAsync() => await context.DisposeAsync();
}
