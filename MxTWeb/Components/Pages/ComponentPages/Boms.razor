@page "/bom"
@rendermode InteractiveServer
@using Microsoft.EntityFrameworkCore
@using MxTWeb.Models
@using MxTWeb.Data
@using MxTWeb.Enums
@using Microsoft.AspNetCore.Authorization
@attribute [Authorize]
@implements IAsyncDisposable
@inject IDbContextFactory<MxTWeb.Data.MxTWebContext> DbFactory
@inject IDialogService DialogService
@inject ISnackbar Snackbar

<PageTitle>BOM 관리</PageTitle>

<style>
    .custom-grid .mud-table-cell .column-header .column-options .mud-menu .mud-icon-button-label {
        display: none !important;
        visibility: hidden !important;
    }

    .custom-grid .mud-table-cell .column-header .column-options .mud-menu {
        display: none !important;
        visibility: hidden !important;
        width: 0px !important;
    }

    .custom-grid .mud-table-cell {
        padding-right: 15px !important;
    }
</style>

<h2>BOM 관리</h2>
<br/>
<MudGrid Spacing="5" Class="mb-2">
    <MudItem Class="ms-2">
        <MudSelect Style="width: 10vw" @bind-Value="_selectedProduct" Variant="Variant.Text" Label="Selected Product" ShrinkLabel
                   TextChanged="@OnSelectProduct">
            @foreach (var bom in _boms)
            {
                <MudSelectItem Value="@bom">@bom</MudSelectItem>
            }
        </MudSelect>
    </MudItem>
    <MudItem>
        <MudIcon Icon="@Icons.Material.Filled.ArrowForward" Class="mt-5"/>
    </MudItem>
    <MudItem>
        <MudSelect Style="width: 10vw" @bind-Value="_selectedVersion" Variant="Variant.Text" Label="Selected Version" ShrinkLabel>
            @foreach (var ver in _versions)
            {
                <MudSelectItem Value="@ver">@ver</MudSelectItem>
            }
        </MudSelect>
    </MudItem>

    &nbsp&nbsp
    <MudItem>
        <MudButton Class="mt-3" @onclick="AddNew2" Variant="Variant.Filled" Color="Color.Primary" StartIcon="@Icons.Material.Filled.Edit">
            EDIT BOM
        </MudButton>
    </MudItem>
</MudGrid>

<MudDataGrid T="BomDetail" Class="custom-grid" Items="@FilteredData" @ref="_dataGrid"
             SortMode="SortMode.Single" Dense="true" Style="white-space: nowrap" Hover="true" Bordered="true" Striped="true"
             Groupable="true" GroupClass="pa-3" RowsPerPage="1000" SelectOnRowClick="false"
             MultiSelection="true" SelectedItems="@selectedItems" SelectedItemsChanged="@(_ => StateHasChanged())"
             QuickFilter="@_quickFilter"
             Loading="@isLoading">

    <ToolBarContent>
        <MudGrid Spacing="5" Style="margin-top: 0px; margin-bottom: 10px">
            <MudItem>
                <MudButton Class="me-2" OnClick="@ExpandAllGroupsAsync" Variant="Variant.Outlined" Color="@Color.Primary">펼치기</MudButton>
            </MudItem>
            <MudItem>
                <MudButton Class="me-2" OnClick="@CollapseAllGroupsAsync" Variant="Variant.Outlined" Color="@Color.Primary">접기</MudButton>
            </MudItem>
            <MudItem>
                <MudButton Class="me-2" @onclick="AddNew" Variant="Variant.Filled" Color="Color.Primary" 
                           StartIcon="@Icons.Material.Filled.Add" Disabled="@IsAddPartDisabled">
                    Add Part
                </MudButton>
            </MudItem>
            <MudItem>
                <MudButton Class="me-2" Variant="Variant.Filled" StartIcon="@Icons.Material.Filled.Delete"
                           Color="@Color.Error" OnClick="@DeleteData" Disabled="@IsDeleteDisabled">
                    Delete
                </MudButton>
            </MudItem>

            <MudItem Style="margin-left: auto">
                <MudMenu Class="mb-1" Label="@searchField" Variant="Variant.Filled" EndIcon="@Icons.Material.Filled.KeyboardArrowDown" IconColor="Color.Secondary">
                    <MudMenuItem Label="Assembly" @onclick="@(() => SelectSearchField("Assembly"))" />
                    <MudMenuItem Label="Part Number" @onclick="@(() => SelectSearchField("Part Number"))" />
                    <MudMenuItem Label="Description" @onclick="@(() => SelectSearchField("Description"))" />
                    <MudMenuItem Label="Seller" @onclick="@(() => SelectSearchField("Seller"))" />
                </MudMenu>
            </MudItem>
            <MudItem>
                <MudTextField Class="mt-1 pe-5" Style="min-width: 25vw" @bind-Value="searchFilter" Placeholder="Search" Adornment="Adornment.Start" Immediate="true"
                              AdornmentIcon="@Icons.Material.Filled.Search" IconSize="Size.Medium" />
            </MudItem>
        </MudGrid>
    </ToolBarContent>

    <ColGroup>
        <col style="width: 0px;"/>
        <col />
        <col />
        <col style="width: 150px;"/>
        <col />
        <col style="width: 50px;" />
        <col style="width: 80px;" />
        <col style="width: 110px;" />
        <col style="width: 110px;" />
        <col style="width: 80px;" />
        <col />
        <col />
        <col style="width: 50px;" />
        <col />
    </ColGroup>
    <Columns>
        <SelectColumn T="BomDetail" />
        <PropertyColumn Property="x => x.Component.Assembly" Title="Assembly" Sortable="true"
                        Grouping="true" GroupExpanded="true" GroupByOrder="2">
            <GroupTemplate>
                @{
                    var key = context.Grouping.Key;
                    decimal total = 0M;
                    if (FilteredData != null)
                    {
                        total = FilteredData
                            .Where(x => Equals(x.Component.Assembly, key))
                            .Sum(x => x.Quantity * x.Price);
                    }
                }
                <span style="font-weight:bold">@context.Title: @(context.Grouping.Key) Total Price: @total.ToString("N0")</span>
            </GroupTemplate>
        </PropertyColumn>
        <PropertyColumn Property="x => x.Component.PartNumber" Title="Part Number" sortable="true" InitialDirection="SortDirection.Ascending" />
        <PropertyColumn Property="x => x.Component.Description" Title="Description" Sortable="false" Required="false"/>
        <PropertyColumn Property="x => x.Component.Model" Title="Model" Sortable="false" Required="false" />
        <PropertyColumn Property="x => x.Component.Origin" Title="Origin" Sortable="false" Required="false" />
        <PropertyColumn Property="x => x.Quantity" Title="Q'ty" Sortable="false" Required="false" Format="N0"/>
        <PropertyColumn Property="x => x.Price" Title="Price" Required="false" Format="N0" />
        <PropertyColumn Property="x => (x.Quantity * x.Price)" Title="Total" Required="false" Format="N0" />
        <PropertyColumn Property="x => x.Component.Category" Title="Category" Sortable="false" Required="false" />
        <PropertyColumn Property="x => x.Component.Maker" Title="Maker" sortable="false" Required="false" />
        <PropertyColumn Property="x => x.Component.Seller" Title="Seller" Sortable="false" Required="false" />
        <PropertyColumn Property="x => x.Component.LeadTime" Title="Lead" sortable="false" Required="false" />
        <PropertyColumn Property="x => x.Component.Note" Title="Comment" sortable="false" Required="false" />
    </Columns>
</MudDataGrid>
<br />
<br />
<br />

@code {
    private MxTWebContext context = default!;

    private string searchField = "Assembly";
    private string searchFilter = "";

    private IEnumerable<BomDetail> FilteredData = new List<BomDetail>();
    private HashSet<BomDetail> selectedItems = new();
    private string _selectedProduct = string.Empty;
    private string _selectedVersion = string.Empty;
    private int _selectedBomId = 0;
    private List<string?> _boms = new();
    private List<string?> _versions = new();
    private bool IsAddPartDisabled => _selectedVersion == string.Empty;
    private bool IsDeleteDisabled => selectedItems.Count == 0;
    private bool isProcessing = false;
    private bool isLoading = true;
    private bool _readonly = true;

    private MudDataGrid<BomDetail> _dataGrid = null!;

    private async Task AddNew() // Add Part
    {
        var options = new DialogOptions { MaxWidth = MaxWidth.ExtraExtraLarge };
        var dialog = await DialogService.ShowAsync<BomDetailEdit>("Add New Component", options);
        var result = await dialog.Result;

        if (result is not null && !result.Canceled)
        {
            FilteredData = context.BomDetail.ToList();
            StateHasChanged();
        }
    }

    private async Task AddNew2()  // Edit BOM
    {
        var options = new DialogOptions { MaxWidth = MaxWidth.Large };
        var dialog = await DialogService.ShowAsync<BomEdit>("Edit BOM", options);
        var result = await dialog.Result;

        if (result is not null && !result.Canceled)
        {
            context = DbFactory.CreateDbContext();

            if (string.IsNullOrWhiteSpace(_selectedVersion))
            {
                //FilteredData = context.BomDetail.ToList();
                Snackbar.Add("BOM이 선택되지 않았습니다.", Severity.Error);
            }
            else
            {
                Bom? bom = result.Data as Bom;
                if (bom is null)
                {
                    Snackbar.Add("Bom 불러오기에 실패했습니다.", Severity.Error);
                }
                else
                {
                    List<BomDetail> existingBomDetails = context.BomDetail
                        .Where(b => b.BomId == _selectedBomId)
                        .ToList();

                    context.BomDetail.RemoveRange(existingBomDetails);

                    List<BomDetail> bomList = context.BomDetail
                        .Where(b => b.BomId == bom.BomId)
                        .ToList();

                    foreach (var item in bomList)
                    {
                        item.BomId = _selectedBomId;
                    }

                    context.BomDetail.AddRange(bomList);

                    FilteredData = context.BomDetail.ToList();
                    Snackbar.Add("성공적으로 불러왔습니다.", Severity.Success);
                }
            }

            StateHasChanged();
        }
    }

    private async Task DeleteData()
    {
        var parameters = new DialogParameters<BomDetailDelete>
        {
            { x => x.bomDetails, selectedItems.ToList() }
        };

        var options = new DialogOptions { MaxWidth = MaxWidth.Large };
        var dialog = await DialogService.ShowAsync<BomDetailDelete>("Delete Data", parameters, options);
        var result = await dialog.Result;

        if (result is not null && !result.Canceled)
        {         
            FilteredData = context.BomDetail.ToList();
            selectedItems.Clear();
            StateHasChanged();
        }
    }

    private Func<BomDetail, bool> _quickFilter => x =>
    {
        if (string.IsNullOrWhiteSpace(searchFilter))
            return true;

        else
        {
            switch (searchField)
            {
                case "Assembly":
                    if (x.Component.Assembly.Contains(searchFilter, StringComparison.OrdinalIgnoreCase))
                        return true;
                    break;

                case "Part Number":
                    if (x.Component.PartNumber.Contains(searchFilter, StringComparison.OrdinalIgnoreCase))
                        return true;
                    break;

                default:
                    break;
            }
        }
        return false;
    };

    protected override async Task OnInitializedAsync()
    {
        isLoading = true;

        await LoadBomList();

        isLoading = false;
    }

    private async Task LoadBomList()
    {
        context = DbFactory.CreateDbContext();

        _boms = await context.Bom
            .Select(x => x.ProductName)
            .Distinct()
            .Where(x => !string.IsNullOrEmpty(x) && x != "-")
            .OrderBy(x => x)
            .ToListAsync();

        StateHasChanged();
    }

    private async Task OnSelectProduct(string value)
    {
        context = DbFactory.CreateDbContext();

        _selectedProduct = value ?? string.Empty;
        _selectedVersion = string.Empty;
        if (string.IsNullOrWhiteSpace(_selectedProduct))
        {
            _versions = new List<string?>();
        }
        else
        {
            _versions = await context.Bom
                .Where(b => b.ProductName == _selectedProduct)
                .Select(b => b.BomVersion)
                .Where(v => !string.IsNullOrEmpty(v))
                .Distinct()
                .OrderBy(v => v)
                .ToListAsync();
        }
        StateHasChanged();
    }

    private async Task OnSelectVersion(string value)
    {
        context = DbFactory.CreateDbContext();

        _selectedVersion = value ?? string.Empty;
        if (string.IsNullOrWhiteSpace(_selectedVersion))
        {
            FilteredData = new List<BomDetail>();
        }

        _selectedBomId = await context.Bom
            .Where(b => b.ProductName == _selectedProduct && b.BomVersion == _selectedVersion)
            .Select(b => b.BomId)
            .FirstOrDefaultAsync();

        FilteredData = await context.BomDetail
            .Include(x => x.Component)
            .Where(x => x.Bom.ProductName == _selectedProduct && x.Bom.BomVersion == _selectedVersion)
            .ToListAsync();

        StateHasChanged();
    }

    private void SelectSearchField(string item)
    {
        searchField = item;
    }

    private Task ExpandAllGroupsAsync()
    {
        return _dataGrid.ExpandAllGroupsAsync();
    }

    private Task CollapseAllGroupsAsync()
    {
        return _dataGrid.CollapseAllGroupsAsync();
    }

    public async ValueTask DisposeAsync() => await context.DisposeAsync();

}
