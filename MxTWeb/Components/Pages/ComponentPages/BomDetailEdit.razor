@page "/components/edit4"
@rendermode InteractiveServer
@using Microsoft.EntityFrameworkCore
@using MxTWeb.Models
@using MxTWeb.Enums
@using Microsoft.AspNetCore.Authorization
@attribute [Authorize]
@inject IDbContextFactory<MxTWeb.Data.MxTWebContext> DbFactory
@inject NavigationManager NavigationManager
@inject ISnackbar Snackbar

<EditForm method="post" Model="Bom" OnValidSubmit="OnValidSubmit" FormName="edit" Enhance>
    <MudDialog>
        <DialogContent>
            <MudGrid Style="width: 1600px">
                <MudItem xs="5">
                    <MudTable T="Component" Items="@SourceComponents" Filter="new Func<Component, bool>(FilterFunc1_)"
                              Dense="true" Hover="true" Bordered="true" Striped="true"
                              GroupBy="@_groupDefinition1"
                              GroupHeaderStyle="background-color:var(--mud-palette-background-gray)"
                              RowsPerPage="1000" SelectOnRowClick="false"
                              MultiSelection="true" @bind-SelectedItems="selectedSourceItems"
                              FixedHeader="true" Height="716px">
                        <ToolBarContent>
                            <MudText Typo="Typo.body2" Class="pa-2">총 부품 수: @SourceComponents.Count()</MudText>
                            <MudSpacer />
                            <MudTextField Class="pe-5" @bind-Value="searchString1" Placeholder="Search" Adornment="Adornment.Start" Immediate="true"
                                          AdornmentIcon="@Icons.Material.Filled.Search" IconSize="Size.Medium" />
                        </ToolBarContent>
                        <HeaderContent>
                            <MudTh>Assembly</MudTh>
                            <MudTh>PartNumber</MudTh>
                            <MudTh>Description</MudTh>
                        </HeaderContent>
                        <GroupHeaderTemplate Context="x">
                            <MudTh colspan="5">@($"{x.GroupName}: {x.Key}") </MudTh>
                        </GroupHeaderTemplate>
                        <RowTemplate Context="x">
                            <MudTd DataLabel="Assembly">@x.Assembly</MudTd>
                            <MudTd DataLabel="PartNumber">@x.PartNumber</MudTd>
                            <MudTd DataLabel="Description">@x.Description</MudTd>
                        </RowTemplate>
                    </MudTable>
                </MudItem>

                <MudItem xs="1" Style="display: flex; align-items:center; justify-content:center;">
                    <MudStack Row="false" Spacing="15" Justify="Justify.Center" AlignItems="AlignItems.Center">
                        <MudIconButton Style="height: 60px; width: 60px" Variant="Variant.Filled" Color="Color.Primary"
                                   OnClick="MoveSelectedToTarget" Disabled="@(!selectedSourceItems.Any())"
                                   Icon="@Icons.Material.Filled.ArrowForward" Size="Size.Large">
                        </MudIconButton>
                        <MudIconButton Style="height: 60px; width: 60px" Variant="Variant.Filled" Color="Color.Secondary"
                                   OnClick="MoveSelectedToSource" Disabled="@(!selectedTargetItems.Any())"
                                   Icon="@Icons.Material.Filled.ArrowBack" Size="Size.Large">
                        </MudIconButton>
                        <MudSpacer />
                    </MudStack>
                </MudItem>

                <MudItem xs="6">
                    <MudTable T="BomDetail" Items="@TargetComponents" Filter="new Func<BomDetail, bool>(FilterFunc2_)"
                              Dense="true" Hover="true" Bordered="true" Striped="true"
                              GroupBy="@_groupDefinition2"
                              GroupHeaderStyle="background-color:var(--mud-palette-background-gray)"
                              RowsPerPage="1000" SelectOnRowClick="false"
                              MultiSelection="true" @bind-SelectedItems="selectedTargetItems"
                              FixedHeader="true" Height="716px">
                        <ToolBarContent>
                            <MudText Typo="Typo.body2" Class="pa-2">총 부품 수: @TargetComponents.Count()</MudText>
                            <MudSpacer />
                            <MudTextField Class="pe-5" @bind-Value="searchString2" Placeholder="Search" Adornment="Adornment.Start" Immediate="true"
                                          AdornmentIcon="@Icons.Material.Filled.Search" IconSize="Size.Medium" />
                        </ToolBarContent>
                        <HeaderContent>
                            <MudTh>Assembly</MudTh>
                            <MudTh>PartNumber</MudTh>
                            <MudTh>Description</MudTh>
                            <MudTh>Q'ty</MudTh>
                            <MudTh>Price</MudTh>
                        </HeaderContent>
                        <GroupHeaderTemplate Context="x">
                            <MudTh colspan="5">@($"{x.GroupName}: {x.Key}") </MudTh>
                        </GroupHeaderTemplate>
                        <RowTemplate Context="x">
                            <MudTd DataLabel="Assembly">@x.Component.Assembly</MudTd>
                            <MudTd DataLabel="PartNumber">@x.Component.PartNumber</MudTd>
                            <MudTd DataLabel="Description">@x.Component.Description</MudTd>
                            <MudTd DataLabel="Quantity">@x.Quantity</MudTd>
                            <MudTd DataLabel="Price">@x.Price</MudTd>
                        </RowTemplate>
                    </MudTable>
                </MudItem>
            </MudGrid>
            @* <MudAlert Severity="Severity.Info" Class="mt-3" Dense="true">
                <MudStack Row="true" Spacing="2" AlignItems="AlignItems.Center">
                    <MudIcon Icon="@Icons.Material.Filled.TouchApp" />
                    <MudText><strong>사용 방법:</strong> 각 항목을 드래그하여 다른 테이블로 이동하세요.</MudText>
                </MudStack>
            </MudAlert> *@
            <br/>
        </DialogContent>
    </MudDialog>
</EditForm>

@code {
    private MxTWebContext context = default!;

    [SupplyParameterFromQuery]
    private int Id { get; set; }

    [Parameter]
    public Bom Bom { get; set; } = new();

    [Parameter]
    public int SelectedBomId { get; set; }

    [CascadingParameter]
    private IMudDialogInstance MudDialog { get; set; }

    private List<Component> SourceComponents = new();
    private List<BomDetail> TargetComponents = new();

    private HashSet<Component> selectedSourceItems = new();
    private HashSet<BomDetail> selectedTargetItems = new();

    private string searchString1 = "";
    private string searchString2 = "";


    private async Task OnValidSubmit()
    {

    }

    private async Task AddComponent()
    {
        using var context = DbFactory.CreateDbContext();
        context.Bom.Add(Bom);
        await context.SaveChangesAsync();
        NavigationManager.NavigateTo("/components");

        Snackbar.Add("성공적으로 추가되었습니다.", Severity.Success);
        MudDialog.Close();
    }

    protected override async Task OnInitializedAsync()
    {
        context = DbFactory.CreateDbContext();
        SourceComponents = await context.Component.OrderBy(c => c.PartNumber).ToListAsync();
        TargetComponents = await context.BomDetail
            .Include(b => b.Component)
            .Where(b => b.BomId == SelectedBomId)
            .OrderBy(b => b.Component.PartNumber)
            .ToListAsync();
    }

    private bool FilterFunc1_(Component component) => FilterFunc1(component, searchString1);

    private bool FilterFunc1(Component component, string searchString)
    {
        if (string.IsNullOrWhiteSpace(searchString))
            return true;
        if (component.Assembly.Contains(searchString, StringComparison.OrdinalIgnoreCase))
            return true;
        if (component.PartNumber.Contains(searchString, StringComparison.OrdinalIgnoreCase))
            return true;
        if (component.Description.Contains(searchString, StringComparison.OrdinalIgnoreCase))
            return true;

        return false;
    }

    private TableGroupDefinition<Component> _groupDefinition1 = new()
    {
        GroupName = "Assembly",
        Indentation = false,
        Expandable = true,
        IsInitiallyExpanded = false,
        Selector = (e) => e.Assembly
    };

    private bool FilterFunc2_(BomDetail bomDetail) => FilterFunc2(bomDetail, searchString2);

    private bool FilterFunc2(BomDetail bomDetail, string searchString)
    {
        if (string.IsNullOrWhiteSpace(searchString))
            return true;
        if (bomDetail.Component.Assembly.Contains(searchString, StringComparison.OrdinalIgnoreCase))
            return true;
        if (bomDetail.Component.PartNumber.Contains(searchString, StringComparison.OrdinalIgnoreCase))
            return true;
        if (bomDetail.Component.Description.Contains(searchString, StringComparison.OrdinalIgnoreCase))
            return true;

        return false;
    }

    private TableGroupDefinition<BomDetail> _groupDefinition2 = new()
    {
        GroupName = "Assembly",
        Indentation = false,
        Expandable = true,
        IsInitiallyExpanded = false,
        Selector = (e) => e.Component.Assembly
    };

    private async Task MoveSelectedToTarget()
    {
        if (!selectedSourceItems.Any())
            return;

        // 이미 존재하는 ComponentId들을 조회
        var existingComponentIds = await context.BomDetail
            .Where(bd => bd.BomId == SelectedBomId)
            .Select(bd => bd.ComponentId)
            .ToListAsync();

        // 중복되지 않는 항목만 필터링
        var toAdd = selectedSourceItems
            .Where(s => !existingComponentIds.Contains(s.ComponentId))
            .Select(s => new BomDetail
            {
                BomId = SelectedBomId,
                ComponentId = s.ComponentId,
                Quantity = s.Quantity,
                Price = s.Price
            })
            .ToList();

        if (toAdd.Count == 0)
            return;

        context.BomDetail.AddRange(toAdd);
        await context.SaveChangesAsync();
        selectedSourceItems.Clear();
        // 갱신
        TargetComponents = await context.BomDetail
            .Include(b => b.Component)
            .Where(b => b.BomId == SelectedBomId)
            .OrderBy(b => b.Component.PartNumber)
            .ToListAsync();

        StateHasChanged();
    }

    private async Task MoveSelectedToSource()
    {
        if (!selectedTargetItems.Any())
            return;

        context.BomDetail.RemoveRange(selectedTargetItems);
        await context.SaveChangesAsync();
        selectedTargetItems.Clear();
        // 갱신
        TargetComponents = await context.BomDetail
            .Include(b => b.Component)
            .Where(b => b.BomId == SelectedBomId)
            .OrderBy(b => b.Component.PartNumber)
            .ToListAsync();

        StateHasChanged();
    }
}
