<MudDrawer @bind-Open="@_open" ClipMode="DrawerClipMode.Never" Breakpoint="Breakpoint.None" Elevation="1" Variant="DrawerVariant.Mini"
           OpenMiniOnHover="false" >

    <MudNavMenu Rounded="true" Margin="Margin.Normal" Color="Color.Tertiary"
                Style="background-image: linear-gradient(180deg, #107474 0%, #1cab94 70%); min-height: 100%">
        <AuthorizeView>
            <Authorized>
                <MudGrid Style="background: #0A4947; height: 90px; align-items: center;">
                    @if (_open)
                    {
                        <MudItem xs="3">
                            <MudIconButton Icon="@Icons.Material.Filled.MenuOpen"
                                            Size="Size.Large"
                                            OnClick="@ToggleDrawer"
                                            Style="color: floralwhite;" />
                        </MudItem>
                        <MudItem xs="9" Style="display: flex; align-items: center; justify-content: center; margin-left: -10px">
                            <MudLink Href="">
                                <MudImage Src="@imageSource"
                                            Elevation="0"
                                            Class="img-fluid"
                                            Style="max-height: 90px;" />
                            </MudLink>
                        </MudItem>
                    }
                    else
                    {
                        <MudItem xs="12">
                            <MudIconButton Icon="@Icons.Material.Filled.Menu"
                                            Size="Size.Large"
                                            OnClick="@ToggleDrawer"
                                            Style="color: floralwhite;" />
                        </MudItem>
                    }
                </MudGrid>

                <MudNavLink Match="NavLinkMatch.All" Href="" IconColor="Color.Surface"
                            Icon="@Icons.Material.Filled.Home" Style="font-size: 16px; font-weight:bolder; color: floralwhite; margin-left:2px"
                            Class="fw-bolder">
                    Home
                </MudNavLink>
                <MudDivider Class="my-1" />

                <MudNavGroup Title="부품 재고 관리"
                                IconColor="Color.Surface"
                                Icon="@Icons.Material.Filled.Warehouse"
                                Style="font-size: 16px; font-weight:bolder; color: floralwhite; margin-left:3px"
                                @bind-Expanded="@_expanded" @onclick="OnNavGroupExpand"
                                Class="fw-bolder custom-nav-group">
                    <MudNavLink Match="NavLinkMatch.Prefix" Href="components" Style="font-size: 16px; font-weight:bolder; color: floralwhite"
                                Class="fw-bolder">
                        재고 현황
                    </MudNavLink>
                    <MudNavLink Match="NavLinkMatch.Prefix" Href="histories" Style="font-size: 16px; font-weight:bolder; color: floralwhite"
                                Class="fw-bolder">
                        입·출고 이력
                    </MudNavLink>
                    <MudNavLink Match="NavLinkMatch.Prefix" Href="bom" Style="font-size: 16px; font-weight:bolder; color: floralwhite"
                                Class="fw-bolder">
                        BOM 관리
                    </MudNavLink>
                </MudNavGroup>

                <MudNavLink Match="NavLinkMatch.Prefix" Href="chipusages" IconColor="Color.Surface"
                            Icon="@Icons.Material.Filled.DeveloperBoard" Style="font-size: 16px; font-weight:bolder; color: floralwhite; margin-left:3px"
                            Class="fw-bolder">
                    칩 사용 대장
                </MudNavLink>

                <MudNavLink Match="NavLinkMatch.Prefix" Href="cyropreserveds" IconColor="Color.Surface"
                            Icon="@Icons.Material.Filled.AcUnit" Style="font-size: 16px; font-weight:bolder; color: floralwhite; margin-left:2px"
                            Class="fw-bolder">
                    동결세포 관리
                </MudNavLink>

                <MudNavGroup Title="동결세포 관리"
                             IconColor="Color.Surface"
                             Icon="@Icons.Material.Filled.Warehouse"
                             Style="font-size: 16px; font-weight:bolder; color: floralwhite; margin-left:3px"
                             @bind-Expanded="@_expanded2" @onclick="OnNavGroupExpand"
                             Class="fw-bolder custom-nav-group">

                    <MudNavLink Match="NavLinkMatch.Prefix" Href="cyropreserveds" 
                                Style="font-size: 16px; font-weight:bolder; color: floralwhite;"
                                Class="fw-bolder">
                        동결세포 관리
                    </MudNavLink>

                    <MudNavLink Match="NavLinkMatch.Prefix" Href="histories" 
                                Style="font-size: 16px; font-weight:bolder; color: floralwhite"
                                Class="fw-bolder">
                        입·출고 이력
                    </MudNavLink>
                </MudNavGroup>

                <MudNavLink Match="NavLinkMatch.Prefix" Href="equipments" IconColor="Color.Surface"
                            Icon="@Icons.Material.Filled.Devices" Style="font-size: 16px; font-weight:bolder; color: floralwhite; margin-left:2px"
                            Class="fw-bolder">
                    장비·기기 관리
                </MudNavLink>

                <MudNavLink Match="NavLinkMatch.Prefix" Href="reagents" IconColor="Color.Surface"
                            Icon="@Icons.Custom.Uncategorized.BioHazard" Style="font-size: 16px; font-weight:bolder; color: floralwhite; margin-left:2px"
                            Class="fw-bolder">
                    연구용 시약 관리
                </MudNavLink>

                <MudNavLink Match="NavLinkMatch.Prefix" Href="shipments" IconColor="Color.Surface"
                            Icon="@Icons.Material.Filled.HistoryEdu" Style="font-size: 16px; font-weight:bolder; color: floralwhite; margin-left:2px"
                            Class="fw-bolder">
                    출하 이력 관리
                </MudNavLink>

                <MudDivider Class="my-1" />
                <MudNavLink Match="NavLinkMatch.Prefix" Href="Account/Manage" IconColor="Color.Surface"
                            Icon="@Icons.Material.Filled.Person" Style="font-size: 16px; font-weight:bolder; color: floralwhite"
                            Class="fw-bolder">
                    마이페이지
                </MudNavLink>

                <MudNavLink Icon="@Icons.Material.Filled.Logout"
                            IconColor="Color.Surface"
                            Style="font-size: 16px; font-weight:bolder; color: floralwhite; margin-left: 2px"
                            Class="fw-bolder"
                            @onclick="HandleLogout">
                    로그아웃
                </MudNavLink>
                <MudDivider Class="my-1" />
            </Authorized>
        </AuthorizeView>

        <AuthorizeView Roles="Admin">
            <Authorized>
                <MudNavGroup Title="관리자 메뉴"
                                IconColor="Color.Surface"
                                Icon="@Icons.Material.Filled.AdminPanelSettings"
                                Style="font-size: 16px; font-weight:bolder; color: floralwhite; margin-left:3px"
                                @bind-Expanded="@_expanded3" @onclick="OnNavGroupExpand"
                                Class="fw-bolder custom-nav-group">
                    <MudNavLink Match="NavLinkMatch.Prefix" Href="roles" Style="font-size: 16px; font-weight:bolder; color: floralwhite"
                                Class="fw-bolder">
                        역할 관리
                    </MudNavLink>
                    <MudNavLink Match="NavLinkMatch.Prefix" Href="user-roles" Style="font-size: 16px; font-weight:bolder; color: floralwhite"
                                Class="fw-bolder">
                        사용자 역할 관리
                    </MudNavLink>
                </MudNavGroup>
            </Authorized>
        </AuthorizeView>
    </MudNavMenu>
</MudDrawer>

<form action="Account/Logout" method="post" style="display:none;" id="logoutForm">
    <AntiforgeryToken />
    <input type="hidden" name="ReturnUrl" value="Account/Login" />
</form>

@code {
    private bool _open = false;
    private bool _expanded = false;
    private bool _expanded2 = false;
    private bool _expanded3 = false;
    private string? currentUrl;

    private void ToggleDrawer()
    {
        _open = !_open;

        if (_open == false)
        {
            _expanded = false;
            _expanded2 = false;
            _expanded3 = false;
        }
    }

    private void OnNavGroupExpand()
    {
        if (!_open)
        {
            _open = true;
        }
    }

    protected override void OnInitialized()
    {
        currentUrl = NavigationManager.ToBaseRelativePath(NavigationManager.Uri);
        NavigationManager.LocationChanged += OnLocationChanged;
    }

    private void OnLocationChanged(object? sender, LocationChangedEventArgs e)
    {
        currentUrl = NavigationManager.ToBaseRelativePath(e.Location);
        StateHasChanged();
    }

    public void Dispose()
    {
        NavigationManager.LocationChanged -= OnLocationChanged;
    }

    private async Task HandleLogout()
    {
        // JavaScript Interop으로 form submit
        await JSRuntime.InvokeVoidAsync("eval",
            "document.querySelector('form[action=\"Account/Logout\"]').submit()");
    }

    private string? imageSource => NavigationManager.BaseUri + "images/MxT Biotech_Original_white.png";
}

