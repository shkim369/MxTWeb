@implements IDisposable
@rendermode InteractiveServer

@inject NavigationManager NavigationManager

<div class="top-row ps-2 navbar navbar-dark">
    <div class="container-fluid">
        <a class="navbar-brand" href="">
            <img src="@imageSource" class="img-fluid" alt="MxTBiotech Logo" style="display:block;">
        </a>
    </div>
</div>

<input type="checkbox" title="Navigation menu" class="navbar-toggler" />

<div class="nav-scrollable" onclick="document.querySelector('.navbar-toggler').click()">
    <nav class="nav flex-column">

        <AuthorizeView>
            <Authorized>
                <MudNavMenu Rounded="true" Margin="Margin.Normal" Color="Color.Tertiary" Class="pa-3">
                    <MudNavLink Match="NavLinkMatch.All" Href="" IconColor="Color.Surface"
                                Icon="@Icons.Material.Filled.Home" Style="font-size: 16px; font-weight:bolder; color: floralwhite"
                                Class="fw-bolder">
                        Home
                    </MudNavLink>
					<MudDivider Class="my-1" />
                    <MudNavLink Match="NavLinkMatch.Prefix" Href="cyropreserveds" IconColor="Color.Surface"
                                Icon="@Icons.Material.Filled.AcUnit" Style="font-size: 16px; font-weight:bolder; color: floralwhite"
                                Class="fw-bolder">
						동결세포 관리
                    </MudNavLink>

                    <MudNavLink Match="NavLinkMatch.Prefix" Href="reagents" IconColor="Color.Surface"
                                Icon="@Icons.Custom.Uncategorized.BioHazard" Style="font-size: 16px; font-weight:bolder; color: floralwhite"
                                Class="fw-bolder">
                        연구용 시약 관리
                    </MudNavLink>

                    <MudNavLink Match="NavLinkMatch.Prefix" Href="equipments" IconColor="Color.Surface"
                                Icon="@Icons.Material.Filled.Devices" Style="font-size: 16px; font-weight:bolder; color: floralwhite"
                                Class="fw-bolder">
                        장비·기기 관리
                    </MudNavLink>

                    <MudNavLink Match="NavLinkMatch.Prefix" Href="chipusages" IconColor="Color.Surface"
                                Icon="@Icons.Material.Filled.DeveloperBoard" Style="font-size: 16px; font-weight:bolder; color: floralwhite"
                                Class="fw-bolder">
                        칩 사용 대장
                    </MudNavLink>

					<MudNavGroup Title="부품 재고 관리" onclick=""
                                 IconColor="Color.Surface"
                                 Icon="@Icons.Material.Filled.Warehouse" Style="font-size: 16px; font-weight:bolder; color: floralwhite"
                                 Class="fw-bolder">
                        <MudNavLink Match="NavLinkMatch.Prefix" Href="components" Style="font-size: 16px; font-weight:bolder; color: floralwhite"
                                    Class="fw-bolder">
                            재고 현황
                        </MudNavLink>
                        <MudNavLink Match="NavLinkMatch.Prefix" Href="histories" Style="font-size: 16px; font-weight:bolder; color: floralwhite"
                                    Class="fw-bolder">
                            입·출고 이력
                        </MudNavLink>
                        <MudNavLink Match="NavLinkMatch.Prefix" Href="bom" Style="font-size: 16px; font-weight:bolder; color: floralwhite"
                                    Class="fw-bolder">
                            BOM 관리
                        </MudNavLink>
                    </MudNavGroup>

                    <MudDivider Class="my-1" />
                    <MudNavLink Match="NavLinkMatch.Prefix" Href="Account/Manage" IconColor="Color.Surface"
                                Icon="@Icons.Material.Filled.Person" Style="font-size: 16px; font-weight:bolder; color: floralwhite"
                                Class="fw-bolder">
                        마이페이지
                    </MudNavLink>

                    <form action="Account/Logout" method="post" style="margin:0;">
                        <AntiforgeryToken />
                        <input type="hidden" name="ReturnUrl" value="Account/Login" />

                        <MudButton ButtonType="ButtonType.Submit"
                                   StartIcon="@Icons.Material.Filled.Logout"
                                   IconClass="ms-1 me-3 mt-1"
                                   FullWidth="true"
                                   Color="Color.Inherit"
                                   Variant="Variant.Text"
                                   Class="mud-nav-link"
                                   Style="font-size:16px; font-weight:bolder; color:floralwhite;">
                            로그아웃
                        </MudButton>
                    </form>

                </MudNavMenu>
            </Authorized>
            <NotAuthorized>
                <div class="nav-item px-3">
                    <NavLink class="nav-link" href="Account/Login">
                        <span class="bi bi-person-badge-nav-menu" aria-hidden="true"></span> Login
                    </NavLink>
                </div>
                <div class="nav-item px-3">
                    <NavLink class="nav-link" href="Account/Register">
                        <span class="bi bi-person-nav-menu" aria-hidden="true"></span> Register
                    </NavLink>
                </div>
            </NotAuthorized>
        </AuthorizeView>

        <AuthorizeView Roles="Admin">
            <Authorized>
                <div class="nav-item px-3">
                    <NavLink class="nav-link" href="todo">
                        <span class="oi oi-list-rich" aria-hidden="true"></span> Todo
                    </NavLink>
                </div>
            </Authorized>
        </AuthorizeView>
    </nav>
</div>

@code {
    private string? currentUrl;

    protected override void OnInitialized()
    {
        currentUrl = NavigationManager.ToBaseRelativePath(NavigationManager.Uri);
        NavigationManager.LocationChanged += OnLocationChanged;
    }

    private void OnLocationChanged(object? sender, LocationChangedEventArgs e)
    {
        currentUrl = NavigationManager.ToBaseRelativePath(e.Location);
        StateHasChanged();
    }

    public void Dispose()
    {
        NavigationManager.LocationChanged -= OnLocationChanged;
    }

    private string? imageSource => NavigationManager.BaseUri + "images/MxT Biotech_Original_white.png";
}

