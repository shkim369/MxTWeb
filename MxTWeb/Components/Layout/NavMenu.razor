@implements IDisposable
@rendermode InteractiveServer
@inject IJSRuntime JSRuntime

@inject NavigationManager NavigationManager

<style>
    .mud-drawer.mud-drawer-mini {
        min-width: 62px !important; /* 기본값 약 56px */
    }

    /* MudDrawer height: 100vh 고정, 내용 넘치면 스크롤 */
    .mud-drawer {
        height: 100vh !important;
        position: fixed !important;
        display: flex !important;
        flex-direction: column !important;
    }

    .mud-drawer-content {
        flex: 1 !important;
        display: flex !important;
        flex-direction: column !important;
        overflow-y: auto !important;
        overflow-x: hidden !important;
        background-image: linear-gradient(180deg, #107474 0%, #1cab94 70%);
    }

    /* 스크롤바 스타일링 */
    .mud-drawer-content::-webkit-scrollbar {
        width: 8px;
    }

    .mud-drawer-content::-webkit-scrollbar-track {
        background: rgba(0, 0, 0, 0.1);
    }

    .mud-drawer-content::-webkit-scrollbar-thumb {
        background-color: rgba(255, 255, 255, 0.6);
        border-radius: 4px;
    }

    .mud-drawer-content::-webkit-scrollbar-thumb:hover {
        background-color: rgba(255, 255, 255, 0.8);
    }

    /* Firefox 스크롤바 */
    .mud-drawer-content {
        scrollbar-width: auto;
        scrollbar-color: rgba(255, 255, 255, 0.6) rgba(0, 0, 0, 0.1);
    }

    .mud-nav-menu {
        flex: 1 !important;
    }

    .mud-nav-link:hover .mud-nav-link-expand-icon {
        color: mediumseagreen;
    }

    .mud-nav-link .mud-nav-link-expand-icon {
        color: floralwhite;
        margin-left: -4px;
    }

    .mud-drawer-mini .mud-nav-link {
        white-space: nowrap;
        height: 45px;
    }
</style>

