@implements IDisposable
@rendermode InteractiveServer
@inject IJSRuntime JSRuntime

@inject NavigationManager NavigationManager

<style>
    .mud-drawer.mud-drawer-mini {
        min-width: 62px !important; /* 기본값 약 56px */
        scrollbar-width: none
    }

    /* MudDrawer height: 기본 100vh, 내용이 많으면 자동 확장 */
    .mud-drawer {
        min-height: 100vh !important;
        height: auto !important;
        max-height: none !important;
        overflow-y: auto !important;
    }

    .mud-drawer-content {
        min-height: 100vh !important;
        height: 100% !important;
        display: flex !important;
        flex-direction: column !important;
    }

    .mud-nav-menu {
        min-height: 100vh !important;
        flex: 1 !important;
    }

    .mud-nav-link:hover .mud-nav-link-expand-icon {
        color: mediumseagreen;
    }

    .mud-nav-link .mud-nav-link-expand-icon {
        color: floralwhite;
        margin-left: -4px;
    }

    .mud-drawer-mini .mud-nav-link {
        white-space: nowrap;
        height: 45px;
    }
</style>

